};

function isoOf(country) {
  return COUNTRY_ISO[stripAccents((country || '').toUpperCase().trim())] || null;
}
function regionOf(country) {
  const iso = isoOf(country);
  return (iso && REGION_MAP[iso]) || 'other';
}

// ── Phase 6: global filter engine ─────────────────────────────────────────────
// Periods passing the year filter (used by chips, trends, compare, sparkline)
function getFilteredPeriods() {
  const all = Object.keys(state.periods);
  if (!state.filters.years.size) return all.sort();
  return all.filter(p => state.filters.years.has(p.slice(0, 4))).sort();
}
function periodDetailIsTrusted(period, flow) {
  if (state.dataSource === 'vinacas') return true;
  const pd = state.periods[period] || {};
  const isImport = flow === 'import';
  let rows = isImport ? (pd.countryRowsNk || [])
    : ((pd.countryRowsXk && pd.countryRowsXk.length) ? pd.countryRowsXk : (pd.countryRows || []));
  const summary = pickVersionedSummary(pd, flow)
    || ((isImport ? pd.tong_nk : pd.tong_xk)
      && !isEstimatedSummary(isImport ? pd.tong_nk : pd.tong_xk)
      ? (isImport ? pd.tong_nk : pd.tong_xk) : null);
  if (!summary || !rows.length) return false;
  // ── Schema v3: chỉ đối chiếu các dòng CÙNG PHIÊN BẢN với summary đã chọn ──
  const sumVer = versionKeyOf(summary.version) || String(summary.version_key || '').toLowerCase();
  if (sumVer && rows.some(r => r.version_key)) {
    const verRows = rows.filter(r => String(r.version_key || '') === sumVer);
    if (verRows.length) rows = verRows;
  }
  const negativeResidual = rows.some(row => String(row.country || '').trim().toLowerCase() === 'other'
    && ['quantity_month', 'value_month_usd'].some(key => Number.isFinite(Number(row[key])) && Number(row[key]) < 0));
  if (negativeResidual) return false;
  return [['quantity_month', 'quantity_month'], ['value_month_usd', 'value_month_usd']].every(([rowKey, summaryKey]) => {
    const expected = Number(summary[summaryKey]);
    const observed = rows.reduce((sum, row) => sum + (Number(row[rowKey]) || 0), 0);
    return Number.isFinite(expected) && Math.abs(observed - expected) <= 1;
  });
}
// Rows of a period passing the region filter only (base set for tables/badges)
function getFilteredRowsBase(period) {
  const pd = state.periods[period] || {};
  const detailFlow = state.flow === 'import' ? 'import' : 'export';
  // Market charts and tables must not imply accuracy when OCR detail does not
  // reconcile to the official TCHQ monthly summary. KPI totals still use that
  // summary in periodTotals(). The mismatch is recorded by chart_data_audit.
  if (!periodDetailIsTrusted(period, detailFlow)) return [];
  let rows = [];
  if (state.flow === 'import') {
    rows = (pd.countryRowsNk && pd.countryRowsNk.length) ? pd.countryRowsNk : [];
  } else {
    // export or balance (default to export country breakdown)
    rows = (pd.countryRowsXk && pd.countryRowsXk.length) ? pd.countryRowsXk : (pd.countryRows || []);
  }
  // ── Schema v3: chỉ hiện country rows của phiên bản đang chọn (downgrade nếu trống) ──
  rows = filterRowsByVersion(rows, state.version || 'official');
  if (state.filters.region) {
    rows = rows.filter(r => regionOf(r.country) === state.filters.region);
  }
  return rows;
}
// Base + global country search (used by every chart/table/map)
function getFilteredRows(period) {
  let rows = getFilteredRowsBase(period);
  if (state.searchQuery) {
    rows = rows.filter(r => stripAccents((r.country || '').toLowerCase()).includes(state.searchQuery));
  }
  return rows;
}
function anyFilterActive() {
  return state.filters.years.size > 0 || !!state.filters.region || !!state.searchQuery
    || state.filters.granularity !== 'month';
}

// ── Phase 11: đồng bộ KPI + badge + trạng thái khi filter thay đổi ────────────
// (trước đây updateKPIs/updateBadges/updateDataStatus chỉ chạy trong setActivePeriod,
//  nên đổi Khu vực/Năm/Tìm kiếm là KPI giữ số cũ)
function refreshFilterDependent() {
  state.allCountryRows = getFilteredRowsBase(state.activePeriod);
  state.page = 1;
  renderFilterBar();
  renderPeriodChips();
  updateKPIs(state.periods[state.activePeriod] || {});
  updateBadges();
  updateDataStatus();
  updatePeriodLabels();
  markAllDirty();
  refreshActive();
}
function resetFilters() {
  state.filters.years.clear();
  state.filters.granularity = 'month';
  state.filters.region = '';
  state.searchQuery = '';
  const regionEl = document.getElementById('fb-region');
  if (regionEl) regionEl.value = '';
  const fbCountry = document.getElementById('fb-country');
  if (fbCountry) fbCountry.value = '';
  const tableSearch = document.getElementById('country-search');
  if (tableSearch) tableSearch.value = '';
  // Keep the active period if it still passes; otherwise jump to latest allowed
  const allowed = getFilteredPeriods();
  if (state.activePeriod && !allowed.includes(state.activePeriod)) {
    setActivePeriod(allowed.at(-1) || null);
  } else {
    refreshFilterDependent();
  }
  showToast(state.lang === 'vi' ? 'Đã đặt lại bộ lọc' : 'Filters reset', 'info');
}

// ── Phase 6: filter bar UI ────────────────────────────────────────────────────
function setTradeFlow(flow) {
  if (state.dataSource === 'vinacas' && flow !== 'import') {
    showToast(state.lang === 'vi' ? 'Vinacas chỉ có dữ liệu Nhập khẩu RCN' : 'Vinacas only contains RCN import data', 'info');
    return;
  }
  state.flow = flow;
  document.querySelectorAll('#fb-flow button').forEach(b => {
    b.classList.toggle('active', b.dataset.flow === flow);
  });
  const tabTitleVi = document.getElementById('tab-title-vi');
  if (tabTitleVi) {
    if (flow === 'export') tabTitleVi.textContent = 'Tổng quan xuất khẩu';
    else if (flow === 'import') tabTitleVi.textContent = 'Tổng quan nhập khẩu';
    else tabTitleVi.textContent = 'Cán cân thương mại';
  }
  const heroTag = document.getElementById('hero-tag');
  const heroTitle = document.getElementById('hero-title');
  if (state.dataSource !== 'vinacas') {
    if (heroTag) {
      if (flow === 'export') heroTag.textContent = 'TCHQ · Xuất khẩu Hạt Điều';
      else if (flow === 'import') heroTag.textContent = 'TCHQ · Nhập khẩu Hạt Điều';
      else heroTag.textContent = 'TCHQ · Cán cân thương mại';
    }
    if (heroTitle) {
      if (flow === 'export') heroTitle.innerHTML = 'Xuất khẩu <span>Hạt Điều Việt Nam</span>';
      else if (flow === 'import') heroTitle.innerHTML = 'Nhập khẩu <span>Hạt Điều (Nguyên liệu)</span>';
      else heroTitle.innerHTML = 'Cán cân thương mại <span>Hạt Điều Việt Nam</span>';
    }
  }
  refreshFilterDependent();
  showToast(state.lang === 'vi' ? `Chuyển luồng: ${flow === 'export' ? 'Xuất khẩu' : flow === 'import' ? 'Nhập khẩu' : 'Cán cân thương mại'}` : `Switched to ${flow}`, 'info');
}

const EX_VERSION_LABELS = {
  official: { vi: 'Chính thức', en: 'Official' },
  adjusted: { vi: 'Điều chỉnh', en: 'Adjusted' },
  preliminary: { vi: 'Sơ bộ', en: 'Preliminary' },
};
function isEstimatedSummary(r) {
  const version = String(r?.version || '').toLowerCase();
  const note = String(r?.source_note || '').toLowerCase();
  const source = String(r?.source || '').toLowerCase();
  return Boolean(r?.is_derived || version.includes('fallback') || version.includes('derived') || source.includes('fallback') || version.includes('ước tính')
    || version.includes('uoc tinh') || note.includes('suy ngược') || note.includes('suy nguoc'));
}
// ── Schema v3: nhãn phiên bản (VI/EN) → key chuẩn official/adjusted/preliminary/derived ──
function versionKeyOf(label) {
  const t = stripAccents(String(label || '')).toLowerCase().trim();
  if (!t) return '';
  if (t.startsWith('chinh thuc') || t.startsWith('official')) return 'official';
  if (t.startsWith('dieu chinh') || t.startsWith('adjusted')) return 'adjusted';
  if (t.startsWith('so bo') || t.startsWith('preliminary')) return 'preliminary';
  if (t.startsWith('uoc tinh') || t.startsWith('derived') || t.includes('fallback')) return 'derived';
  return '';
}
// Lọc rows theo phiên bản, graceful downgrade theo chuỗi ưu tiên.
// Không có dòng nào khớp chuỗi → trả về tất cả (tránh dashboard trống).
function filterRowsByVersion(rows, want) {
  if (!Array.isArray(rows) || !rows.some(r => r && r.version_key)) return rows;
  const chain = [want, ...['official', 'adjusted', 'preliminary', 'derived'].filter(v => v !== want)];
  for (const v of chain) {
    const picked = rows.filter(r => String(r.version_key || '') === v);
    if (picked.length) return picked;
  }
  return rows;
}
// Version-aware summary pick: desired version first, then graceful downgrade chain.
// Never returns an empty page of data — falls back to whatever rows exist.
function pickVersionedSummary(pd, flow) {
  const rows = ((pd && pd.summaryRows) || []).filter(r => isCashewRow(r) && !isEstimatedSummary(r))
    .filter(r => flow === 'import' ? r.direction === 'import' : (!r.direction || r.direction === 'export'));
  if (!rows.length) return null;
  const want = state.version || 'official';
  const chain = [want, ...['official', 'adjusted', 'preliminary'].filter(v => v !== want)];
  for (const v of chain) {
    const hit = rows.find(r => String(r.version || '').toLowerCase() === v);
    if (hit) return hit;
  }
  return rows[0]; // derived/unknown version rows — still show something
}

function setDataVersion(ver) {
  state.version = ver;
  document.querySelectorAll('#fb-version button').forEach(b => {
    b.classList.toggle('active', b.dataset.ver === ver);
  });
  refreshFilterDependent();
  const lb = EX_VERSION_LABELS[ver] || { vi: ver, en: ver };
  showToast(state.lang === 'vi' ? `Phiên bản: ${lb.vi}` : `Data version: ${lb.en}`, 'info');
}

// ── Phase A (Master Plan v2): Vinacas data source — NK RCN visualization ──────
function buildVinacasPeriods() {
  const recs = state.vinacasRecords || [];
  const periods = {};
  recs.forEach(r => {
    const period = String(r.period || r.fulldate || '').slice(0, 7);
    if (!/^\d{4}-\d{2}$/.test(period)) return;
    if (!periods[period]) periods[period] = {
      period, source: 'vinacas',
      tong_xk: null, tong_nk: null, trade_balance_usd: null,
      countryRowsXk: [], countryRowsNk: [], countryRows: [], summaryRows: [], versions: [],
      cumulative: parseInt(period.slice(0, 4), 10) <= 2022,   // 2018–2022: dòng cộng dồn cuối năm
      fileName: 'Vinacas.xlsx',
    };
    periods[period].countryRowsNk.push({
      country: r.country_report || r.country_raw || '',
      product: r.product || 'Raw Cashew Nut',
      unit: r.unit || 'Tấn',
      quantity_month: r.quantity ?? r.quantity_month ?? null,
      value_month_usd: r.value_usd ?? r.value_month_usd ?? null,
      quantity_ytd: null, value_ytd_usd: null,
      direction: 'import',
    });
  });
  Object.values(periods).forEach(pd => {
    const s = (k) => pd.countryRowsNk.reduce((acc, r) => acc + (r[k] || 0), 0);
    pd.tong_nk = {
      product: 'Raw Cashew Nut', unit: 'Tấn',
      quantity_month: s('quantity_month'), value_month_usd: s('value_month_usd'),
      quantity_ytd: null, value_ytd_usd: null,
    };
    pd.countryRows = pd.countryRowsNk;
  });
  return periods;
}

async function loadVinacasData() {
  if (state.vinacasRecords && state.vinacasRecords.length) return true;
  return false;
}

async function setDataSource(src) {
  if (src === state.dataSource) return;
  if (src === 'vinacas') {
    const ok = await loadVinacasData();
    if (!ok) {
      showToast(state.lang === 'vi'
        ? 'Không tìm thấy dữ liệu Vinacas — hãy kiểm tra sheet Vinacas trong all_years_cashew.xlsx'
        : 'Vinacas data unavailable — check the Vinacas sheet in all_years_cashew.xlsx', 'error');
      return;
    }
  }
  // Snapshot nguồn đang rời bỏ, rồi swap dataset
  state.periodsBySource[state.dataSource] = state.periods;
  state.activePeriodBySource[state.dataSource] = state.activePeriod;
  if (src === 'vinacas' && !state.periodsBySource.vinacas) {
    state.periodsBySource.vinacas = buildVinacasPeriods();
  }
  state.periods = state.periodsBySource[src];
  state.dataSource = src;
  state.filters.years.clear();
  state.searchQuery = '';
  // Flow lock: Vinacas chỉ có Import RCN
  const flowBtns = document.querySelectorAll('#fb-flow button');
  if (src === 'vinacas') {
    if (state.flow !== 'import') state.flow = 'import';
    flowBtns.forEach(b => { if (b.dataset.flow !== 'import') b.setAttribute('disabled', ''); });
  } else {
    flowBtns.forEach(b => b.removeAttribute('disabled'));
  }
  // Active period theo nguồn (nhớ lựa chọn cũ của từng nguồn)
  state.activePeriod = state.activePeriodBySource[src]
    || Object.keys(state.periods).sort().at(-1) || null;
  document.querySelectorAll('#fb-source button').forEach(b => {
    b.classList.toggle('active', b.dataset.src === src);
  });
  updateSourceChrome();
  refreshFilterDependent();
  setActivePeriod(state.activePeriod);
  showToast(state.lang === 'vi'
    ? (src === 'vinacas' ? 'Nguồn: Vinacas — Nhập khẩu RCN' : 'Nguồn: TCHQ')
    : (src === 'vinacas' ? 'Source: Vinacas — RCN imports' : 'Source: TCHQ'), 'info');
}

function updateSourceChrome() {
  const vi = state.lang === 'vi';
  const heroTag = document.getElementById('hero-tag');
  if (heroTag) {
    if (state.dataSource === 'vinacas') heroTag.textContent = vi ? 'Vinacas · Nhập khẩu RCN (Nguyên liệu)' : 'Vinacas · RCN Imports';
    else if (state.flow === 'export') heroTag.textContent = 'TCHQ · Xuất khẩu Hạt Điều';
    else if (state.flow === 'import') heroTag.textContent = 'TCHQ · Nhập khẩu Hạt Điều';
    else heroTag.textContent = 'TCHQ · Cán cân thương mại';
  }
}

function onYearSelectChange(val) {
  if (val === 'all') {
    state.filters.years.clear();
  } else {
    state.filters.years.clear();
    state.filters.years.add(val);
    const periodsInYear = Object.keys(state.periods).filter(p => p.startsWith(val)).sort();
    if (periodsInYear.length) {
      state.activePeriod = periodsInYear.at(-1);
    }
  }
  refreshFilterDependent();
}

function renderFilterBar() {
  // Trade flow segmented control
  document.querySelectorAll('#fb-flow button').forEach(b => {
    b.classList.toggle('active', b.dataset.flow === (state.flow || 'export'));
  });
  // Data version segmented control
  document.querySelectorAll('#fb-version button').forEach(b => {
    b.classList.toggle('active', b.dataset.ver === (state.version || 'official'));
  });

  // Year select dropdown
  const yearSelect = document.getElementById('fb-year-select');
  if (yearSelect) {
    const years = [...new Set(Object.keys(state.periods).map(p => p.slice(0, 4)))].sort().reverse();
    const curVal = state.filters.years.size === 1 ? [...state.filters.years][0] : 'all';
    const optValues = Array.from(yearSelect.options).map(o => o.value).join(',');
    const newValues = ['all', ...years].join(',');
    if (optValues !== newValues) {
      yearSelect.innerHTML = `<option value="all">${state.lang === 'vi' ? 'Tất cả năm / All' : 'All years'}</option>` +
        years.map(y => `<option value="${y}">${state.lang === 'vi' ? `Năm ${y}` : `Year ${y}`}</option>`).join('');
    }
    yearSelect.value = curVal;
  }

  // Year chips (multi-select) from all loaded periods
  const wrap = document.getElementById('fb-year-chips');
  if (wrap) {
    const years = [...new Set(Object.keys(state.periods).map(p => p.slice(0, 4)))].sort();
    wrap.innerHTML = '';
    years.forEach(y => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'fb-year-chip' + (state.filters.years.has(y) ? ' active' : '');
      b.textContent = y;
      b.setAttribute('aria-pressed', state.filters.years.has(y) ? 'true' : 'false');
      b.onclick = () => toggleYearFilter(y);
      wrap.appendChild(b);
    });
  }
  // Granularity segmented control
  document.querySelectorAll('#fb-granularity button').forEach(b => {
    b.classList.toggle('active', b.dataset.gran === state.filters.granularity);
    b.setAttribute('aria-pressed', b.dataset.gran === state.filters.granularity ? 'true' : 'false');
  });
  // Region select
  const regionEl = document.getElementById('fb-region');
  if (regionEl && regionEl.value !== state.filters.region) regionEl.value = state.filters.region;
  // Country input mirrors state.searchQuery
  const fbCountry = document.getElementById('fb-country');
  if (fbCountry && document.activeElement !== fbCountry) fbCountry.value = state.searchQuery;
}

function toggleYearFilter(year) {
  if (state.filters.years.has(year)) state.filters.years.delete(year);
  else state.filters.years.add(year);
  // Active period must still pass the filter
  const allowed = getFilteredPeriods();
  if (!allowed.length) {
    // No periods left: clear years rather than showing an empty dashboard
    state.filters.years.clear();
    showToast(state.lang === 'vi' ? 'Phải chọn ít nhất một năm' : 'Keep at least one year', 'error');
  } else if (state.activePeriod && !allowed.includes(state.activePeriod)) {
    state.activePeriod = null;
    setActivePeriod(allowed.at(-1));
    return;
  } else {
    refreshFilterDependent();
  }
}

function setGranularity(gran) {
  if (!['month', 'quarter', 'year'].includes(gran)) return;
  state.filters.granularity = gran;
  renderFilterBar();
  markAllDirty();
  refreshActive();
}

function setRegionFilter(region) {
  state.filters.region = region;
  refreshFilterDependent();
}

// ── Helpers ───────────────────────────────────────────────────────────────────
function stripAccents(s) {
  return (s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\u0111/g, 'd').replace(/\u0110/g, 'D');
}

function esc(s) {
  return String(s ?? '')
    .replace(/&/g, '&').replace(/</g, '<').replace(/>/g, '>')
    .replace(/"/g, '"').replace(/'/g, '&#39;');
}

function fmt(n, decimals = 0) {
  if (n == null || isNaN(n)) return '—';
  return new Intl.NumberFormat('vi-VN', {
    minimumFractionDigits: decimals,
    maximumFractionDigits: decimals,
  }).format(n);
}

function fmtUSD(n) {
  if (n == null || isNaN(n)) return '—';
  const abs = Math.abs(n);
  if (abs >= 1e9) return '$' + (n / 1e9).toFixed(2) + 'B';
  if (abs >= 1e6) return '$' + (n / 1e6).toFixed(2) + 'M';
  if (abs >= 1e3) return '$' + (n / 1e3).toFixed(1) + 'K';
  return '$' + fmt(n, 0);
}

function debounce(fn, ms) {
  let t;
  return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
}

function showToast(msg, type = 'info') {
  const c = document.getElementById('toast-container');
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  const icons = { success: '✅', error: '⚠️', info: 'ℹ️' };
  el.innerHTML = `<span class="t-ico" aria-hidden="true">${icons[type] || 'ℹ️'}</span><span>${esc(msg)}</span>`;
  c.appendChild(el);
  setTimeout(() => {
    el.classList.add('hide');
    setTimeout(() => el.remove(), 350);
  }, 3000);
}

// ── Loading overlay (file parsing feedback) ───────────────────────────────────
function showLoading(msg) {
  const ov = document.getElementById('loading-overlay');
  const tx = document.getElementById('loading-text');
  if (tx && msg) tx.textContent = msg;
  if (ov) ov.classList.add('show');
}
function hideLoading() {
  const ov = document.getElementById('loading-overlay');
  if (ov) ov.classList.remove('show');
}

// Robust number parser: handles VN "1.234,5" / "1.234.567" and US "1,234.56"
function parseNum(v) {
  if (v == null || v === '') return null;
  if (typeof v === 'number') return isFinite(v) ? v : null;
  let t = String(v).replace(/[%\s]/g, '');
  if (!t || t === '-' || t === '--') return null;
  const hasDot = t.includes('.'), hasComma = t.includes(',');
  if (hasDot && hasComma) {
    if (t.lastIndexOf(',') > t.lastIndexOf('.')) t = t.replace(/\./g, '').replace(',', '.');
    else t = t.replace(/,/g, '');
  } else if (hasComma) {
    const parts = t.split(',');
    if (parts.length === 2 && parts[1].length !== 3) t = parts[0] + '.' + parts[1];
    else t = t.replace(/,/g, '');
  } else if (hasDot) {
    const parts = t.split('.');
    if (parts.length > 2 || (parts.length === 2 && parts[1].length === 3)) t = t.replace(/\./g, '');
  }
  const n = parseFloat(t);
  return isNaN(n) ? null : n;
}

// ── Language toggle ───────────────────────────────────────────────────────────
function setLang(lang) {
  state.lang = lang;
  document.querySelectorAll('.lang-vi').forEach(el => el.style.display = lang === 'vi' ? '' : 'none');
  document.querySelectorAll('.lang-en').forEach(el => el.style.display = lang === 'en' ? '' : 'none');
  document.getElementById('lang-vi').classList.toggle('active', lang === 'vi');
  document.getElementById('lang-en').classList.toggle('active', lang === 'en');
  const searchEl = document.getElementById('country-search');
  if (searchEl) searchEl.placeholder = lang === 'vi' ? 'Tìm quốc gia...' : 'Search country...';
  const fbC = document.getElementById('fb-country');
  if (fbC) fbC.placeholder = lang === 'vi' ? 'Tìm quốc gia...' : 'Search country...';
  updateTopbarTitle();
  if (state.hasData) { markAllDirty(); refreshActive(); }
}

function updateTopbarTitle() {
  const t = TAB_TITLES[state.activeTab];
  document.getElementById('tab-title-vi').textContent = t.vi;
  document.getElementById('tab-title-en').textContent = t.en;
  document.getElementById('tab-sub-vi').textContent = t.sub_vi;
  document.getElementById('tab-sub-en').textContent = t.sub_en;
}

// ── Tab manager ───────────────────────────────────────────────────────────────
const dirtyTabs = new Set(TABS);

function markAllDirty() { TABS.forEach(t => dirtyTabs.add(t)); }

function switchTab(tab) {
  if (!TABS.includes(tab)) return;
  state.activeTab = tab;
  try { sessionStorage.setItem('dofActiveTab', tab); } catch (e) { /* private mode */ }
  document.querySelectorAll('.nav-item').forEach(b => {
    const isActive = b.dataset.tab === tab;
    b.classList.toggle('active', isActive);
    b.setAttribute('aria-selected', isActive ? 'true' : 'false');
  });
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.toggle('active', p.id === `tab-${tab}`));
  updateTopbarTitle();
  if (dirtyTabs.has(tab)) renderTab(tab);
  else resizeTabWidgets(tab);
}

// ── Keyboard navigation (← → on sidebar nav) ─────────────────────────────────
function setupKeyboardNav() {
  const nav = document.getElementById('nav');
  if (!nav) return;
  nav.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp' && e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    e.preventDefault();
    const items = [...nav.querySelectorAll('.nav-item')];
    const idx = items.findIndex(b => b.dataset.tab === state.activeTab);
    const dir = (e.key === 'ArrowDown' || e.key === 'ArrowRight') ? 1 : -1;
    const next = items[(idx + dir + items.length) % items.length];
    if (next) { switchTab(next.dataset.tab); next.focus(); }
  });
}

function refreshActive() { renderTab(state.activeTab); }

function renderTab(tab) {
  if (tab === 'overview') renderOverview();
  else if (tab === 'countries') { applyFilters(); updateSortIndicators(); buildRadarChart(getFilteredRows(state.activePeriod)); buildBubbleChart(getFilteredRows(state.activePeriod)); }
  else if (tab === 'map') renderMap();
  else if (tab === 'trends') renderTrends();
  else if (tab === 'compare') renderCompare();
  else if (tab === 'export') { renderFileList(); }
  dirtyTabs.delete(tab);
}

function resizeTabWidgets(tab) {
  if (tab === 'overview') {
    if (state.barChart) state.barChart.resize();
    if (state.donutChart) state.donutChart.resize();
  } else if (tab === 'map') {
    if (state.leafletMap) setTimeout(() => state.leafletMap.invalidateSize(), 80);
  } else if (tab === 'trends') {
    if (state.lineChart) state.lineChart.resize();
    if (state.ytdLineChart) state.ytdLineChart.resize();
    if (state.stackedChart) state.stackedChart.resize();
    if (state.ytdQtyChart) state.ytdQtyChart.resize();
  } else if (tab === 'compare') {
    if (state.compareChart) state.compareChart.resize();
  }
}

// ── Drag & Drop / Upload ──────────────────────────────────────────────────────
function handleDragOver(e) {
  e.preventDefault();
  document.getElementById('empty-hero').classList.add('drag-over');
}
function handleDragLeave() {
  document.getElementById('empty-hero').classList.remove('drag-over');
}
function handleDrop(e) {
  e.preventDefault();
  document.getElementById('empty-hero').classList.remove('drag-over');
  const files = Array.from(e.dataTransfer.files).filter(isSupportedDataFile);
  if (!files.length) { showToast(state.lang === 'vi' ? 'Vui lòng chọn file XLSX, XLS, CSV hoặc JSON' : 'Please choose an XLSX, XLS, CSV or JSON file', 'error'); return; }
  files.forEach(loadDataFile);
}
function handleFileSelect(e) {
  Array.from(e.target.files).forEach(loadDataFile);
  e.target.value = '';
}

function isSupportedDataFile(file) {
  return /\.(xlsx|xls|csv|json)$/i.test(file.name || '');
}

function loadDataFile(file) {
  if (/\.json$/i.test(file.name)) return loadJSONFile(file);
  loadExcelFile(file);
}

function classifyWorkbookLayout(sheetNames) {
  const keys = (sheetNames || []).map(n => String(n || '').toLowerCase());
  const has = key => keys.includes(key);
  const hasAllYears = ['tong_quan_xnk_all', 'xk_theo_nuoc_all', 'nk_theo_nuoc_all'].every(has);
  if (hasAllYears) return 'all_years';
  const hasTchq = (keys.some(n => n.includes('tong_quan') || n === 'tong_xk')
    && keys.some(n => n.includes('xk_theo_nuoc') || n.includes('nk_theo_nuoc')))
    || hasAllYears;
  if (hasTchq) return 'tchq';
  if (keys.some(n => n === 'vinacas' || n.includes('vinacas'))) return 'vinacas';
  return 'unknown';
}

function loadJSONFile(file) {
  showLoading(state.lang === 'vi' ? 'Đang đọc JSON…' : 'Reading JSON…');
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const payload = JSON.parse(e.target.result);
      // Master Plan v2 (Phase A): kéo-thả JSON có vinacas_records → nạp luôn làm dataset Vinacas
      if (Array.isArray(payload.vinacas_records) && payload.vinacas_records.length) {
        state.vinacasRecords = payload.vinacas_records;
        state.periodsBySource.vinacas = null; // rebuild lần chọn nguồn tiếp theo
      }
      if (Array.isArray(payload.records) && payload.records.length) {
        const canonicalPeriods = buildPeriodsFromCanonical(payload.records, payload.periods || {});
        if (Object.keys(canonicalPeriods).length) {
          state.periods = canonicalPeriods;
          state.periodsBySource = { tchq: canonicalPeriods, vinacas: null };
          state.dataSource = 'tchq';
          document.querySelectorAll('#fb-source button').forEach(b => b.classList.toggle('active', b.dataset.src === 'tchq'));
          if (Array.isArray(payload.vinacas_records) && payload.vinacas_records.length) {
            state.vinacasRecords = payload.vinacas_records;
            state.periodsBySource.vinacas = buildVinacasPeriods();
          }
          state.flow = 'export';
          activateLoadedData();
          showToast(`Đã tải ${file.name} (${Object.keys(canonicalPeriods).length} kỳ, schema ${payload.schema_version || 'legacy'})`, 'success');
          return;
        }
      }
      const periods = payload.periods || payload.data?.periods || {};
      let loaded = 0;
      Object.entries(periods).forEach(([period, item]) => {
        const totalXk = item.tong_xk || item.summary || item.total;
        const totalNk = item.tong_nk;
        const countryRowsXk = (item.xk_theo_nuoc || item.countries || item.countryRows || []).map(r => ({
          country: r.country, product: r.product, unit: r.unit,
          quantity_month: r.quantity_month ?? r.cy_luong ?? r.quantityMonth,
          value_month_usd: r.value_month_usd ?? r.cy_tri_gia ?? r.valueMonthUsd,
          quantity_ytd: r.quantity_ytd ?? r.ytd_luong ?? r.quantityYtd,
          value_ytd_usd: r.value_ytd_usd ?? r.ytd_tri_gia ?? r.valueYtdUsd,
          direction: 'export',
        }));
        const countryRowsNk = (item.nk_theo_nuoc || []).map(r => ({
          country: r.country, product: r.product, unit: r.unit,
          quantity_month: r.quantity_month ?? r.cy_luong ?? r.quantityMonth,
          value_month_usd: r.value_month_usd ?? r.cy_tri_gia ?? r.valueMonthUsd,
          quantity_ytd: r.quantity_ytd ?? r.ytd_luong ?? r.quantityYtd,
          value_ytd_usd: r.value_ytd_usd ?? r.ytd_tri_gia ?? r.valueYtdUsd,
          direction: 'import',
        }));
        const summaryRows = [];
        if (totalXk) summaryRows.push({ ...totalXk, direction: 'export' });
        if (totalNk) summaryRows.push({ ...totalNk, direction: 'import' });
        if (!summaryRows.length && totalXk) summaryRows.push(totalXk);

        if (totalXk || totalNk || countryRowsXk.length || countryRowsNk.length) {
          state.periods[period] = {
            tong_xk: totalXk,
            tong_nk: totalNk,
            trade_balance_usd: item.trade_balance_usd,
            summaryRows,
            countryRows: countryRowsXk,
            countryRowsXk,
            countryRowsNk,
            versions: item.versions || [],
            fileName: file.name
          };
          loaded++;
        }
      });
      if (!loaded) throw new Error('JSON không có periods hợp lệ');
      activateLoadedData();
      showToast(`Đã tải ${file.name} (${loaded} kỳ)`, 'success');
    } catch (err) {
      showToast((state.lang === 'vi' ? 'JSON không hợp lệ: ' : 'Invalid JSON: ') + err.message, 'error');
    } finally {
      hideLoading();
    }
  };
  reader.readAsText(file, 'utf-8');
}

function activateLoadedData() {
  state.hasData = true;
  document.getElementById('empty-hero').style.display = 'none';
  document.getElementById('overview-data').style.display = '';
  persistLocalData();
  renderFilterBar();
  const periods = getFilteredPeriods();
  setActivePeriod(state.activePeriod && state.periods[state.activePeriod] ? state.activePeriod : periods[periods.length - 1]);
}

function persistLocalData() {
  try {
    localStorage.setItem('danOnFoodTradeData', JSON.stringify({
      v: 3, source: state.dataSource, periods: state.periods, savedAt: new Date().toISOString(),
    }));
  } catch (err) { console.warn('Local persistence skipped:', err.message); }
}

function restoreLocalData() {
  try {
    const raw = localStorage.getItem('danOnFoodTradeData');
    if (!raw) return false;
    const saved = JSON.parse(raw);
    if (saved.v !== 3 || !saved.periods || !Object.keys(saved.periods).length) return false;
    Object.assign(state.periods, saved.periods);
    activateLoadedData();
    return true;
  } catch (err) { console.warn('Local restore skipped:', err.message); return false; }
}

function buildPeriodsFromCanonical(records, legacyPeriods = {}) {
  const periods = {};
  (records || []).forEach(r => {
    const period = String(r.period || '').slice(0, 7);
    if (!/^\d{4}-\d{2}$/.test(period) || !r.country) return;
    if (!periods[period]) periods[period] = {
      period, source: 'tchq', tong_xk: null, tong_nk: null, trade_balance_usd: null,
      summaryRows: [], countryRowsXk: [], countryRowsNk: [], countryRows: [], versions: [],
      fileName: 'all_years_cashew.xlsx',
    };
    const row = {
      country: r.country, product: r.product || (r.source === 'vinacas' ? 'Raw Cashew Nut' : 'Hạt điều'),
      unit: r.unit || 'Tấn', quantity_month: r.quantity_month ?? null,
      value_month_usd: r.value_month_usd ?? null, quantity_ytd: r.quantity_ytd ?? null,
      value_ytd_usd: r.value_ytd_usd ?? null, region: r.region || '', direction: r.flow,
      source: r.source || 'tchq', source_note: r.source_note || '',
      // Schema v3: phiên bản + debug truy vết nguồn PDF
      version: r.version || '', version_key: r.version_key || '',
      debug_source_file: r.debug_source_file || '', debug_source_type: r.debug_source_type || '',
      debug_source_note: r.debug_source_note || '',
    };
    if (r.source !== 'vinacas' && r.flow === 'export') periods[period].countryRowsXk.push(row);
    if (r.source !== 'vinacas' && r.flow === 'import') periods[period].countryRowsNk.push(row);
  });
  Object.entries(legacyPeriods || {}).forEach(([period, item]) => {
    if (!periods[period]) periods[period] = { period, source: 'tchq', countryRowsXk: [], countryRowsNk: [], summaryRows: [], versions: [], fileName: 'all_years_cashew.xlsx' };
    const pd = periods[period];
    pd.tong_xk = item.tong_xk || null;
    pd.tong_nk = item.tong_nk || null;
    pd.trade_balance_usd = item.trade_balance_usd ?? null;
    pd.versions = item.versions || [];
    const legacyRows = (rows, flow) => (rows || []).map(r => ({
      country: r.country || '', product: r.product || 'Hạt điều', unit: r.unit || 'Tấn',
      quantity_month: r.quantity_month ?? r.cy_luong ?? null,
      value_month_usd: r.value_month_usd ?? r.cy_tri_gia ?? null,
      quantity_ytd: r.quantity_ytd ?? r.ytd_luong ?? null,
      value_ytd_usd: r.value_ytd_usd ?? r.ytd_tri_gia ?? null,
      region: r.region || '', direction: flow, source: 'tchq', source_note: r.source_note || '',
      version: r.version || '', version_key: versionKeyOf(r.version || ''),
      debug_source_file: r.debug_source_file || '', debug_source_type: r.debug_source_type || '',
      debug_source_note: r.debug_source_note || '',
    }));
    if (!pd.countryRowsXk.length) pd.countryRowsXk = legacyRows(item.xk_theo_nuoc || item.countries || item.countryRows || [], 'export');
    if (!pd.countryRowsNk.length) pd.countryRowsNk = legacyRows(item.nk_theo_nuoc || [], 'import');
    if (pd.tong_xk) pd.summaryRows.push({ ...pd.tong_xk, direction: 'export' });
    if (pd.tong_nk) pd.summaryRows.push({ ...pd.tong_nk, direction: 'import' });
  });
  Object.values(periods).forEach(pd => { pd.countryRows = pd.countryRowsXk; });
  return periods;
}

// Canonical all-years JSON auto-loader; the workbook remains a user-downloadable artifact.
async function loadAllYearsJSON() {
  // Try absolute path from server root first, fallback to relative path
  let resp = null, url = '/output/data/all_years_cashew.json';
  try { resp = await fetch(url); } catch (_) {}
  if (!resp || !resp.ok) {
    url = '../output/data/all_years_cashew.json';
    try { resp = await fetch(url); } catch (_) {}
  }
  if (!resp || !resp.ok) throw new Error(`all_years_cashew.json · HTTP ${resp ? resp.status : 'fetch failed'}`);
  const payload = await resp.json();
  if (Array.isArray(payload.vinacas_records)) state.vinacasRecords = payload.vinacas_records;
  if (!Array.isArray(payload.records) || !payload.records.length) {
    // Backward compatibility for pre-schema-v2 all-years JSON.
    if (!payload.periods || !Object.keys(payload.periods).length) throw new Error(`${url} · thiếu records/periods`);
  }
  state.periods = Array.isArray(payload.records) && payload.records.length
    ? buildPeriodsFromCanonical(payload.records, payload.periods || {})
    : buildPeriodsFromCanonical([], payload.periods || {});
  if (!Object.keys(state.periods).length) throw new Error(`${url} · không có kỳ dữ liệu hợp lệ`);
  state.dataSource = 'tchq';
  state.flow = 'export';
  state.periodsBySource = { tchq: state.periods, vinacas: null };
  document.querySelectorAll('#fb-source button').forEach(b => b.classList.toggle('active', b.dataset.src === 'tchq'));
  activateLoadedData();
  markAllDirty();
  showToast(`Đã tự động tải all_years_cashew.json (${Object.keys(state.periods).length} kỳ)`, 'success');
}

// Legacy year-only JSON loader retained for compatibility with callers/files.
async function loadFromJSON(year = new Date().getFullYear()) {
  try {
    const resp = await fetch(`../output/data/${year}_cashew.json`);
    if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
    const payload = await resp.json();
    let loaded = 0;
    Object.entries(payload.periods || {}).forEach(([period, item]) => {
      const totalXk = item.tong_xk;
      const totalNk = item.tong_nk;
      const countryRowsXk = (item.xk_theo_nuoc || []).map(r => ({
        country: r.country, product: r.product, unit: r.unit,
        quantity_month: r.quantity_month ?? r.cy_luong, value_month_usd: r.value_month_usd ?? r.cy_tri_gia,
        quantity_ytd: r.quantity_ytd ?? r.ytd_luong, value_ytd_usd: r.value_ytd_usd ?? r.ytd_tri_gia,
        direction: 'export',
      }));
      const countryRowsNk = (item.nk_theo_nuoc || []).map(r => ({
        country: r.country, product: r.product, unit: r.unit,
        quantity_month: r.quantity_month ?? r.cy_luong, value_month_usd: r.value_month_usd ?? r.cy_tri_gia,
        quantity_ytd: r.quantity_ytd ?? r.ytd_luong, value_ytd_usd: r.value_ytd_usd ?? r.ytd_tri_gia,
        direction: 'import',
      }));
      const summaryRows = [];
      if (totalXk) summaryRows.push({ ...totalXk, direction: 'export' });
      if (totalNk) summaryRows.push({ ...totalNk, direction: 'import' });

      if (summaryRows.length || countryRowsXk.length || countryRowsNk.length) {
        state.periods[period] = {
          tong_xk: totalXk,
          tong_nk: totalNk,
          trade_balance_usd: item.trade_balance_usd,
          summaryRows,
          countryRows: countryRowsXk,
          countryRowsXk,
          countryRowsNk,
          versions: item.versions || [],
          fileName: `${year}_cashew.json`
        };
        loaded++;
      }
    });
    if (!loaded) throw new Error('Không có kỳ dữ liệu hợp lệ');
    state.hasData=true; document.getElementById('empty-hero').style.display='none'; document.getElementById('overview-data').style.display='';
    setActivePeriod(Object.keys(state.periods).sort().at(-1));
    showToast(`Đã tự động tải dữ liệu ${year} (${loaded} kỳ)`, 'success');
  } catch (err) { console.warn('JSON auto-load skipped:', err.message); }
}

// ── All-years Excel auto-loader (project root) ────────────────────────────────
async function loadAllYearsExcel() {
  showLoading(state.lang === 'vi' ? 'Đang tải toàn bộ dữ liệu hạt điều…' : 'Loading all cashew data…');
  try {
    let resp = null;
    try { resp = await fetch('/output/all_years_cashew.xlsx'); } catch (_) {}
    if (!resp || !resp.ok) {
      try { resp = await fetch('../output/all_years_cashew.xlsx'); } catch (_) {}
    }
    if (!resp || !resp.ok) throw new Error(`all_years_cashew.xlsx · HTTP ${resp ? resp.status : 'fetch failed'}`);
    const wb = XLSX.read(await resp.arrayBuffer(), { type: 'array' });
    const nameMap = {};
    wb.SheetNames.forEach(n => { nameMap[n.toLowerCase()] = n; });
    const summaryKey = Object.keys(nameMap).find(n => n.includes('tong_quan') || n.includes('tong') || n.includes('summary'));
    const xkKey = Object.keys(nameMap).find(n => n.includes('xk_theo_nuoc') || (n.includes('xk') && n.includes('nuoc')));
    const nkKey = Object.keys(nameMap).find(n => n.includes('nk_theo_nuoc') || (n.includes('nk') && n.includes('nuoc')));
    const versionKey = Object.keys(nameMap).find(n => n.includes('lich_su_phien_ban') || n.includes('version_history'));
    const vinacasKey = Object.keys(nameMap).find(n => n === 'vinacas' || n.includes('vinacas'));
    const countryKey = xkKey || Object.keys(nameMap).find(n => n.includes('nuoc') || n.includes('country'));

    const summaryRows = summaryKey ? parseSheet(wb.Sheets[nameMap[summaryKey]], 'summary') : [];
    const countryRowsXk = xkKey ? parseSheet(wb.Sheets[nameMap[xkKey]], 'country-export') : (countryKey ? parseSheet(wb.Sheets[nameMap[countryKey]], 'country-export') : []);
    const countryRowsNk = nkKey ? parseSheet(wb.Sheets[nameMap[nkKey]], 'country-import') : [];
    const versionRows = versionKey ? parseSheet(wb.Sheets[nameMap[versionKey]], 'version') : [];
    state.vinacasRecords = vinacasKey ? parseVinacasSheet(wb.Sheets[nameMap[vinacasKey]]) : [];
    const countryRows = countryRowsXk;

    if (!summaryRows.length && !countryRows.length && !countryRowsNk.length) throw new Error('No rows parsed');

    const filePeriods = new Set([
      ...countryRows.map(r => r.period).filter(Boolean),
      ...countryRowsNk.map(r => r.period).filter(Boolean),
      ...summaryRows.map(r => r.period).filter(Boolean),
      ...versionRows.map(r => r.period).filter(Boolean),
    ]);
    filePeriods.forEach(p => {
      const pSum = summaryRows.filter(r => r.period === p);
      const xkSum = pSum.find(r => r.direction === 'export') || pSum[0];
      const nkSum = pSum.find(r => r.direction === 'import');
      const pXkRows = countryRowsXk.filter(r => r.period === p);
      const pNkRows = countryRowsNk.filter(r => r.period === p);
      state.periods[p] = {
        summaryRows: pSum,
        countryRows: pXkRows.length ? pXkRows : countryRows.filter(r => r.period === p),
        countryRowsXk: pXkRows,
        countryRowsNk: pNkRows,
        versions: versionRows.filter(r => r.period === p),
        tong_xk: xkSum || null,
        tong_nk: nkSum || null,
        fileName: 'all_years_cashew.xlsx',
      };
    });
    state.periodsBySource = {
      tchq: state.periods,
      vinacas: state.vinacasRecords && state.vinacasRecords.length ? buildVinacasPeriods() : null,
    };
    if (!Object.keys(state.periods).length) throw new Error('No valid periods');

    activateLoadedData();
    markAllDirty();
    setActivePeriod(Object.keys(state.periods).sort().at(-1));
    showToast((state.lang === 'vi' ? 'Đã tự động tải: ' : 'Auto-loaded: ') + 'all_years_cashew.xlsx' + ` (${Object.keys(state.periods).length} kỳ)`, 'success');
  } catch (err) {
    console.warn('All-years auto-load skipped:', err.message);
    throw err;
  } finally {
    hideLoading();
  }
}

// ── Excel Parser ──────────────────────────────────────────────────────────────
function loadExcelFile(file) {
  showLoading((state.lang === 'vi' ? 'Đang đọc ' : 'Reading ') + file.name + '…');
  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const wb = XLSX.read(e.target.result, { type: 'array' });
      const nameMap = {};
      wb.SheetNames.forEach(n => { nameMap[n.toLowerCase()] = n; });
      // All-years workbooks also contain a Vinacas sheet. Classify by the
      // complete workbook layout before considering a standalone Vinacas file.
      const workbookLayout = classifyWorkbookLayout(wb.SheetNames);
      const vinacasKey = Object.keys(nameMap).find(n => n === 'vinacas' || n.includes('vinacas'));
      if (vinacasKey && workbookLayout === 'vinacas') {
        const rows = parseVinacasSheet(wb.Sheets[nameMap[vinacasKey]]);
        if (rows.length) {
          const previousSource = state.dataSource;
          const previousPeriods = state.periods;
          state.vinacasRecords = rows;
          const vinacasPeriods = buildVinacasPeriods();
          if (!Object.keys(vinacasPeriods).length) throw new Error('Sheet Vinacas có tên cột phù hợp nhưng không có dòng kỳ/quốc gia hợp lệ.');
          state.periodsBySource = { ...state.periodsBySource, [previousSource]: previousPeriods, vinacas: vinacasPeriods };
          if (state.dataSource === 'vinacas') state.periods = vinacasPeriods;
          showToast(`Đã đọc Vinacas (${rows.length} dòng)`, 'success');
          if (state.dataSource !== 'vinacas') setDataSource('vinacas');
          else {
            state.filters.years.clear();
            setActivePeriod(Object.keys(vinacasPeriods).sort().at(-1));
          }
          return;
        }
        throw new Error(`Không đọc được bản ghi trong sheet ${nameMap[vinacasKey]}. Kiểm tra các cột Kỳ/Fulldate, Quốc gia, Lượng và Trị giá.`);
      }
      const sheetSummaryKey = Object.keys(nameMap).find(n => n.includes('tong_quan') || n.includes('tong') || n.includes('summary'));
      const xkKey = Object.keys(nameMap).find(n => n.includes('xk_theo_nuoc') || (n.includes('xk') && n.includes('nuoc')));
      const nkKey = Object.keys(nameMap).find(n => n.includes('nk_theo_nuoc') || (n.includes('nk') && n.includes('nuoc')));
      const versionKey = Object.keys(nameMap).find(n => n.includes('lich_su_phien_ban') || n.includes('version_history'));
      const sheetCountryKey = xkKey || Object.keys(nameMap).find(n => n.includes('nuoc') || n.includes('country'));

      let summaryRows = sheetSummaryKey ? parseSheet(wb.Sheets[nameMap[sheetSummaryKey]], 'summary') : [];
      let countryRowsXk = xkKey ? parseSheet(wb.Sheets[nameMap[xkKey]], 'country-export') : (sheetCountryKey ? parseSheet(wb.Sheets[nameMap[sheetCountryKey]], 'country-export') : []);
      let countryRowsNk = nkKey ? parseSheet(wb.Sheets[nameMap[nkKey]], 'country-import') : [];
      const versionRows = versionKey ? parseSheet(wb.Sheets[nameMap[versionKey]], 'version') : [];
      let countryRows = countryRowsXk;

      if (!summaryRows.length && !countryRows.length && wb.SheetNames.length >= 2) {
        summaryRows = parseSheet(wb.Sheets[wb.SheetNames[0]], 'summary');
        countryRows = parseSheet(wb.Sheets[wb.SheetNames[1]], 'country-export');
        countryRowsXk = countryRows;
      }
      if (!summaryRows.length && !countryRows.length && !countryRowsNk.length) {
        throw new Error(`Không phân tích được workbook; sheet hiện có: ${wb.SheetNames.join(', ')}. Cần sheet tổng quan hoặc bảng quốc gia có Kỳ/Quốc gia và cột lượng/trị giá.`);
      }

      // Detect multi-period workbook (e.g. all_years_cashew.xlsx has a Kỳ column)
      const filePeriods = new Set([
        ...countryRows.map(r => r.period).filter(Boolean),
        ...countryRowsNk.map(r => r.period).filter(Boolean),
        ...summaryRows.map(r => r.period).filter(Boolean),
        ...versionRows.map(r => r.period).filter(Boolean),
      ]);
      if (filePeriods.size > 1) {
        const stagedPeriods = {};
        filePeriods.forEach(p => {
          const pSum = summaryRows.filter(r => r.period === p);
          const xkSum = pSum.find(r => r.direction === 'export') || pSum[0];
          const nkSum = pSum.find(r => r.direction === 'import');
          const pXkRows = countryRowsXk.filter(r => r.period === p);
          const pNkRows = countryRowsNk.filter(r => r.period === p);
          stagedPeriods[p] = {
            summaryRows: pSum,
            countryRows: pXkRows.length ? pXkRows : countryRows.filter(r => r.period === p),
            countryRowsXk: pXkRows,
            countryRowsNk: pNkRows,
            versions: versionRows.filter(r => r.period === p),
            tong_xk: xkSum || null,
            tong_nk: nkSum || null,
            fileName: file.name,
          };
        });
        state.periods = stagedPeriods;
        state.dataSource = 'tchq';
        state.flow = 'export';
        state.periodsBySource = { tchq: stagedPeriods, vinacas: state.periodsBySource.vinacas || null };
        state.filters.years.clear();
        state.searchQuery = '';
        document.querySelectorAll('#fb-source button').forEach(b => b.classList.toggle('active', b.dataset.src === 'tchq'));
        document.querySelectorAll('#fb-flow button').forEach(b => b.removeAttribute('disabled'));
        updateSourceChrome();
        activateLoadedData();
        markAllDirty();
        setActivePeriod([...filePeriods].sort().at(-1));
        showToast((state.lang === 'vi' ? 'Đã tải: ' : 'Loaded: ') + file.name + ` (${filePeriods.size} kỳ)`, 'success');
        return;
      }

      // Single-period workbook: period from filename
      const period = extractPeriod(file.name);
      if (!period) throw new Error('Không đọc được kỳ từ tên file');
      const pSum = summaryRows.map(r => ({ ...r, period: r.period || period }));
      const pXkRows = countryRowsXk.map(r => ({ ...r, period: r.period || period }));
      const pNkRows = countryRowsNk.map(r => ({ ...r, period: r.period || period }));
      const xkSum = pSum.find(r => r.direction === 'export') || pSum[0];
      const nkSum = pSum.find(r => r.direction === 'import');
      state.periods = { [period]: {
        summaryRows: pSum,
        countryRows: pXkRows.length ? pXkRows : countryRows,
        countryRowsXk: pXkRows,
        countryRowsNk: pNkRows,
        versions: versionRows.map(r => ({ ...r, period: r.period || period })),
        tong_xk: xkSum || null,
        tong_nk: nkSum || null,
        fileName: file.name,
      } };
      state.dataSource = 'tchq';
      state.flow = 'export';
      state.periodsBySource = { tchq: state.periods, vinacas: state.periodsBySource.vinacas || null };
      state.filters.years.clear();
      document.querySelectorAll('#fb-source button').forEach(b => b.classList.toggle('active', b.dataset.src === 'tchq'));
      document.querySelectorAll('#fb-flow button').forEach(b => b.removeAttribute('disabled'));
      updateSourceChrome();
      activateLoadedData();
      markAllDirty();
      setActivePeriod(period);
      showToast((state.lang === 'vi' ? 'Đã tải: ' : 'Loaded: ') + file.name + ' (' + period + ')', 'success');
    } catch (err) {
      showToast((state.lang === 'vi' ? 'Lỗi đọc file: ' : 'File error: ') + err.message, 'error');
      console.error(err);
    } finally {
      hideLoading();
    }
  };
  reader.readAsArrayBuffer(file);
}

function extractPeriod(filename) {
  const m = filename.match(/(\d{4})[_\-](\d{2})/);
  return m ? `${m[1]}-${m[2]}` : null;
}

function normalizeKey(k) {
  return stripAccents(String(k || '')).toLowerCase().trim();
}

function parseSheet(ws, sheetType) {
  const raw = XLSX.utils.sheet_to_json(ws, { defval: null, header: 1 });
  if (!raw || raw.length < 2) return [];

  let headerIdx = 0;
  for (let i = 0; i < Math.min(raw.length, 8); i++) {
    const nonEmpty = (raw[i] || []).filter(c => c != null && String(c).trim() !== '');
    if (nonEmpty.length >= 3) { headerIdx = i; break; }
  }
  const headers = (raw[headerIdx] || []).map(h => normalizeKey(h));
  const dataRows = raw.slice(headerIdx + 1);

  function findCol(...candidates) {
    for (const c of candidates) {
      const nc = normalizeKey(c);
      const idx = headers.findIndex(h => h === nc);
      if (idx !== -1) return idx;
    }
    return headers.findIndex(h => candidates.some(c => h.includes(normalizeKey(c))));
  }

  const col = {
    period:    findCol('ky', 'period', 'ki'),
    country:   findCol('quoc gia', 'nuoc', 'country'),
    product:   findCol('mat hang', 'hang hoa', 'product'),
    unit:      findCol('dvt', 'don vi', 'unit'),
    qtyM:      findCol('cy luong', 'luong thang', 'luong', 'qty'),
    valM:      findCol('cy tri gia', 'tri gia usd', 'tri gia', 'value', 'usd'),
    pctQtyM:   findCol('% thang truoc (luong)', '% so voi thang truoc (luong)', '% luong so thang truoc'),
    pctValM:   findCol('% thang truoc (gia)', '% thang truoc (tri gia)', '% tri gia so thang truoc'),
    qtyY:      findCol('ytd luong', 'luy ke luong'),
    valY:      findCol('ytd tri gia', 'luy ke tri gia'),
    direction: findCol('luong', 'direction', 'flow'),
    version:   findCol('phien ban', 'version'),
    note:      findCol('ghi chu', 'ghi chu nguon', 'note'),
  };
  if (col.qtyY === -1 && col.qtyM !== -1) col.qtyY = col.qtyM + 2;
  if (col.valY === -1 && col.valM !== -1) col.valY = col.valM + 2;

  const results = [];
  let curCountry = '';

  dataRows.forEach(row => {
    if (!row || row.length < 2) return;
    const g = (c) => (c >= 0 && c < row.length) ? row[c] : null;

    const countryCell = String(g(col.country) || '').trim();
    if (countryCell) curCountry = countryCell;

    const product = String(g(col.product) || '').trim() || (sheetType === 'summary' ? '' : 'Hạt điều');
    if (!product) return;

    const dirRaw = col.direction >= 0 ? normalizeKey(g(col.direction)) : '';
    const dir = dirRaw.includes('nhap') || dirRaw.includes('import') ? 'import'
      : (dirRaw.includes('xuat') || dirRaw.includes('export') ? 'export'
        : (sheetType === 'country-import' ? 'import' : (sheetType === 'country-export' ? 'export' : '')));
    const ver = col.version >= 0 ? String(g(col.version) || '').trim() : '';

    const out = {
      period: col.period >= 0 ? String(g(col.period) || '').trim() : '',
      country: col.country >= 0 ? curCountry : '',
      product,
      unit: String(g(col.unit) || '').trim(),
      direction: dir,
      version: ver,
      is_derived: ver.toLowerCase().includes('fallback') || ver.toLowerCase().includes('derived') || ver.toLowerCase().includes('ước tính') || ver.toLowerCase().includes('uoc tinh'),
      pct_change_prev_month_qty: col.pctQtyM >= 0 ? parseNum(g(col.pctQtyM)) : null,
      pct_change_prev_month_val: col.pctValM >= 0 ? parseNum(g(col.pctValM)) : null,
      quantity_month: parseNum(g(col.qtyM)),
      value_month_usd: parseNum(g(col.valM)),
      quantity_ytd: parseNum(g(col.qtyY)),
      value_ytd_usd: parseNum(g(col.valY)),
      source_note: col.note >= 0 ? String(g(col.note) || '').trim() : '',
    };
    if (sheetType === 'summary') delete out.country;
    results.push(out);
  });
  return results;
}

function parseVinacasSheet(ws) {
  const raw = XLSX.utils.sheet_to_json(ws, { defval: null, header: 1 });
  if (!raw || raw.length < 2) return [];
  const headers = (raw[0] || []).map(normalizeKey);
  const find = (...keys) => headers.findIndex(h => keys.some(k => h === normalizeKey(k) || h.includes(normalizeKey(k))));
  const c = {
    period: find('ky', 'period'), date: find('fulldate', 'date'), country: find('quoc gia', 'country report', 'ten quoc gia trong report'),
    countryRaw: find('ten nuoc data goc', 'country raw'), region: find('region'), product: find('mat hang', 'product'),
    unit: find('don vi tinh', 'dvt', 'unit'), qty: find('cy luong', 'luong', 'quantity'),
    value: find('cy tri gia', 'tri gia usd', 'value usd'), flow: find('flow', 'direction', 'export/import', 'xuat nhap khau'),
  };
  const dateToPeriod = value => {
    if (typeof value === 'number' && XLSX.SSF) {
      const d = XLSX.SSF.parse_date_code(value);
      return d ? `${d.y}-${String(d.m).padStart(2, '0')}` : '';
    }
    if (typeof value === 'number') {
      const parsed = new Date(Date.UTC(1899, 11, 30) + value * 86400000);
      return `${parsed.getUTCFullYear()}-${String(parsed.getUTCMonth() + 1).padStart(2, '0')}`;
    }
    const s = value instanceof Date ? value.toISOString().slice(0, 10) : String(value || '');
    const m = s.match(/^(\d{4})[-/](\d{1,2})/);
    return m ? `${m[1]}-${String(m[2]).padStart(2, '0')}` : '';
  };
  return raw.slice(1).flatMap(row => {
    const period = (c.period >= 0 ? String(row[c.period] || '') : '') || dateToPeriod(c.date >= 0 ? row[c.date] : null);
    const country = String((c.country >= 0 && row[c.country]) || (c.countryRaw >= 0 && row[c.countryRaw]) || '').trim();
    if (!/^\d{4}-\d{2}$/.test(period) || !country) return [];
    return [{ period, fulldate: c.date >= 0 ? String(row[c.date] || '') : `${period}-01`, country_report: country,
      country_raw: c.countryRaw >= 0 ? String(row[c.countryRaw] || country) : country,
      region: c.region >= 0 ? String(row[c.region] || '') : '', product: c.product >= 0 ? String(row[c.product] || 'Raw Cashew Nut') : 'Raw Cashew Nut',
      unit: c.unit >= 0 ? String(row[c.unit] || 'Tấn') : 'Tấn', quantity: c.qty >= 0 ? parseNum(row[c.qty]) : null,
      value_usd: c.value >= 0 ? parseNum(row[c.value]) : null, flow: c.flow >= 0 ? String(row[c.flow] || 'Import') : 'Import' }];
  });
}

// ── Period Management ─────────────────────────────────────────────────────────
function setActivePeriod(period) {
  state.activePeriod = period;
  state.allCountryRows = getFilteredRowsBase(period);
  state.page = 1;
  renderFilterBar();
  renderPeriodChips();
  updateKPIs(state.periods[period] || {});
  updateBadges();
  updateDataStatus();
  updatePeriodLabels();
  markAllDirty();
  refreshActive();
}

function renderPeriodChips() {
  // ── Phase 12: fixed period slicer (nhóm theo năm, auto-scroll tới kỳ active)
  const strip = document.getElementById('ps-strip');
  if (!strip) return;
  const periods = getFilteredPeriods();
  const byYear = new Map();
  periods.forEach(p => {
    const y = p.slice(0, 4);
    if (!byYear.has(y)) byYear.set(y, []);
    byYear.get(y).push(p);
  });
  strip.innerHTML = '';
  byYear.forEach((list, y) => {
    const yl = document.createElement('span');
    yl.className = 'ps-year';
    yl.textContent = y;
    strip.appendChild(yl);
    list.forEach(p => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'ps-chip' + (p === state.activePeriod ? ' active' : '');
      const pdChip = state.periods[p] || {};
      if (pdChip.cumulative) b.classList.add('cumulative');
      b.textContent = p.slice(5, 7);
      b.title = pdChip.cumulative ? `${p} · Cộng dồn năm (Vinacas)` : p;
      b.setAttribute('role', 'option');
      b.setAttribute('aria-selected', p === state.activePeriod ? 'true' : 'false');
      b.onclick = () => setActivePeriod(p);
      strip.appendChild(b);
    });
  });
  const idx = periods.indexOf(state.activePeriod);
  const info = document.getElementById('ps-info');
  if (info) info.textContent = periods.length ? `${idx + 1}/${periods.length}` : '—/—';
  const active = strip.querySelector('.ps-chip.active');
  if (active && state._lastSliced !== state.activePeriod) {
    state._lastSliced = state.activePeriod;
    try { active.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }); } catch (e) { /* older engines */ }
  }
}

function sliceStep(dir) {
  const periods = getFilteredPeriods();
  if (!periods.length) return;
  const idx = periods.indexOf(state.activePeriod);
  const next = periods[Math.min(periods.length - 1, Math.max(0, idx + dir))];
  if (next && next !== state.activePeriod) setActivePeriod(next);
}

function removePeriod(period) {
  delete state.periods[period];
  persistLocalData();
  const remaining = Object.keys(state.periods).sort();
  if (remaining.length) {
    markAllDirty();
    setActivePeriod(remaining[remaining.length - 1]);
  } else {
    state.hasData = false;
    state.activePeriod = null;
    state.allCountryRows = [];
    state.filteredRows = [];
    document.getElementById('empty-hero').style.display = '';
    document.getElementById('overview-data').style.display = 'none';
    resetKPIs();
    renderFilterBar();
    renderPeriodChips();
    updateBadges();
    updateDataStatus();
    markAllDirty();
    refreshActive();
  }
}

function resetKPIs() {
  ['kpi-qty-month', 'kpi-val-month', 'kpi-qty-ytd', 'kpi-val-ytd'].forEach(id => {
    document.getElementById(id).textContent = '—';
  });
}

function updateDataStatus() {
  const el = document.getElementById('data-status-text');
  const dot = document.querySelector('.status-dot');
  if (!el) return;
  const count = Object.keys(state.periods).length;
  el.textContent = count ? `${count} kỳ · ${state.allCountryRows.length} bản ghi` : (state.lang === 'vi' ? 'Chưa có dữ liệu' : 'No data loaded');
  if (dot) dot.classList.toggle('ready', count > 0);
}

function updateBadges() {
  const n = state.allCountryRows.filter(isCashewRow).length;
  document.getElementById('badge-countries').textContent = n;
}

function updatePeriodLabels() {
  const p = state.activePeriod || '—';
  ['map-period-label', 'map-period-label-en', 'export-period-label', 'export-period-label-en'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.textContent = p;
  });
}

// ── KPI Cards ─────────────────────────────────────────────────────────────────
function isCashewRow(r) {
  const p = stripAccents((r.product || '').toLowerCase());
  return p.includes('dieu') || p.includes('cashew');   // 'cashew' cho nguồn Vinacas (Raw Cashew Nut)
}

// ── Phase 11: dòng "Other" trong Excel là nhóm tổng hợp, không phải quốc gia ──
// Loại khỏi mọi visual per-country (map/donut/top-10/radar/bubble/top-market)
// nhưng GIỮ trong bảng dữ liệu, tổng KPI và trị giá kỳ (là trị giá thật).
const NON_COUNTRY_ROWS = new Set(['other']);
function isOtherRow(r) {
  return NON_COUNTRY_ROWS.has((r.country || '').trim().toLowerCase());
}
function isCountryRow(r) {
  return isCashewRow(r) && !isOtherRow(r);
}

function countUp(el, target, prefix = '') {
  if (target == null || isNaN(target)) { el.textContent = '—'; return; }
  const duration = 850;
  const start = performance.now();
  function update(now) {
    const progress = Math.min((now - start) / duration, 1);
    const ease = 1 - Math.pow(1 - progress, 3);
    el.textContent = prefix + fmt(Math.round(target * ease));
    if (progress < 1) requestAnimationFrame(update);
    else el.classList.add('bump');
  }
  requestAnimationFrame(update);
}

function updateKPIs(pd) {
  const curr = periodTotals(state.activePeriod);

  countUp(document.getElementById('kpi-qty-month'), curr.qty);
  countUp(document.getElementById('kpi-val-month'), curr.val);
  countUp(document.getElementById('kpi-qty-ytd'), curr.qtyY);
  countUp(document.getElementById('kpi-val-ytd'), curr.valY);

  // Trend delta vs previous loaded period (authentic analytics feel)
  const periods = Object.keys(state.periods).sort();
  const prevPeriod = state.activePeriod ? periods[periods.indexOf(state.activePeriod) - 1] : null;
  const prev = prevPeriod ? periodTotals(prevPeriod) : null;

  const deltaHTML = (currVal, prevVal, fmtFn) => {
    if (!prevPeriod || prevVal == null || !prevVal || currVal == null) {
      return `<span class="kpi-delta flat">${state.lang === 'vi' ? 'Kỳ đầu tiên' : 'First period'}</span>`;
    }
    const pct = (currVal - prevVal) / prevVal * 100;
    if (pct > 0.05) return `<span class="kpi-delta up">▲ +${pct.toFixed(1)}% <span style="font-weight:500;color:var(--text-faint)">vs ${prevPeriod}</span></span>`;
    if (pct < -0.05) return `<span class="kpi-delta down">▼ ${pct.toFixed(1)}% <span style="font-weight:500;color:var(--text-faint)">vs ${prevPeriod}</span></span>`;
    return `<span class="kpi-delta flat">• 0% <span style="font-weight:500">vs ${prevPeriod}</span></span>`;
  };

  const subs = {
    'kpi-qty-month-sub': deltaHTML(curr.qty, prev && prev.qty, fmt),
    'kpi-val-month-sub': deltaHTML(curr.val, prev && prev.val, fmtUSD),
    'kpi-qty-ytd-sub': `<span class="kpi-delta flat">${state.lang === 'vi' ? 'Kỳ: ' : 'Period: '}${state.activePeriod || '—'}</span>`,
    'kpi-val-ytd-sub': `<span class="kpi-delta flat">${state.lang === 'vi' ? 'Kỳ: ' : 'Period: '}${state.activePeriod || '—'}</span>`,
  };
  Object.entries(subs).forEach(([id, html]) => {
    const el = document.getElementById(id);
    if (el) el.innerHTML = html;
  });
}

// ── Tab: OVERVIEW ─────────────────────────────────────────────────────────────
function renderOverview() {
  updateHero();
  updateKPIs(state.periods[state.activePeriod] || {}); // Phase 11: KPI phản ứng ngay với filter
  renderBarChart();
  renderDonutChart();
  buildAreaSparkline(getFilteredPeriods());
  buildYtdSparkline(getFilteredPeriods());
  buildProgressBars(getFilteredRows(state.activePeriod));
  renderPeriodsTable();
}

// ── Phase 13: sparkline YTD lũy kế ở Tổng quan (dữ liệu cột YTD giờ có chart) ─
function buildYtdSparkline(periods) {
  const series = aggregateSeries(periods);
  const labels = series.length ? series.map(s => s.label) : ['—'];
  chartBase('areaChartYtd', 'area-chart-ytd', {
    type: 'line',
    data: {
      labels,
      datasets: [{
        label: 'YTD USD',
        data: series.map(s => s.valY),
        borderColor: '#3E7C4F',
        backgroundColor: 'rgba(62,124,79,.16)',
        fill: true, tension: .38, pointRadius: series.length > 30 ? 0 : 2.5, borderWidth: 2,
      }],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ' ' + fmtUSD(c.parsed.y) } } },
      scales: { x: { grid: { display: false }, ticks: { maxTicksLimit: 10, maxRotation: 0, font: { size: 9.5 } } }, y: { grid: { color: 'rgba(90,74,40,.07)' }, ticks: { callback: v => fmtUSD(v), font: { size: 9.5 } } } },
    },
  });
}

function updateHero() {
  const t = periodTotals(state.activePeriod);
  const p = document.getElementById('hero-period'); if (p) p.textContent = state.activePeriod || '—';
  const q = document.getElementById('hero-qty'); if (q) q.textContent = fmt(t.qty);
  const v = document.getElementById('hero-value'); if (v) v.textContent = fmtUSD(t.val);

  const fbBadge = document.getElementById('hero-fallback-badge');
  const pd = state.periods[state.activePeriod] || {};
  const sRow = pickVersionedSummary(pd, state.flow)
    || ((state.flow === 'import' ? pd.tong_nk : pd.tong_xk)
      && !isEstimatedSummary(state.flow === 'import' ? pd.tong_nk : pd.tong_xk)
      ? (state.flow === 'import' ? pd.tong_nk : pd.tong_xk) : null)
    || (pd.summaryRows && pd.summaryRows[0]) || {};
  const isDerived = Boolean(sRow.is_derived || (sRow.version && String(sRow.version).toLowerCase().includes('derived')) || (sRow.source_note && sRow.source_note.includes('Ước tính')) || (sRow.version && sRow.version.includes('YoY')));
  if (fbBadge) {
    fbBadge.style.display = isDerived ? 'inline-block' : 'none';
    if (isDerived && sRow.source_note) {
      fbBadge.title = sRow.source_note;
    }
  }
}

// ── Phase 14 hotfix v5: chống "Canvas is already in use" ─────────────────────
// Dùng Chart.getChart() — API chính thức — để tìm và HỦY BẤT KỲ instance nào
// đang chiếm canvas (kể cả instance không nằm trong state, render chồng,
// hoặc constructor lỗi trước đó), sau đó mới tạo chart mới.
function safeChart(canvas, config) {
  if (typeof Chart === 'undefined') return null;
  try {
    const existing = typeof Chart.getChart === 'function' ? Chart.getChart(canvas) : null;
    if (existing) existing.destroy();
    return new Chart(canvas, config);
  } catch (err) {
    console.warn('[chart] create failed on', canvas && canvas.id, err);
    return null;
  }
}

function chartBase(type, canvasId, config) {
  const el = document.getElementById(canvasId); if (!el) return null;
  if (typeof Chart === 'undefined') return null;  // CDN chưa load — không crash cả dashboard
  if (state[type]) { try { state[type].destroy(); } catch (e) { /* stale instance */ } }
  return state[type] = safeChart(el, config);
}
function destroyCanvasChart(canvas, stateKey) {
  if (typeof Chart !== 'undefined' && canvas && typeof Chart.getChart === 'function') {
    const registered = Chart.getChart(canvas);
    if (registered) { try { registered.destroy(); } catch (e) { /* stale canvas */ } }
  }
  if (state[stateKey]) {
    try { state[stateKey].destroy(); } catch (e) { /* stale instance */ }
  }
  state[stateKey] = null;
}

function buildAreaSparkline(periods) {
  const series = aggregateSeries(periods);
  const labels = series.length ? series.map(s => s.label) : ['—'];
  chartBase('areaChart', 'area-chart', { type:'line', data:{labels, datasets:[{label:'USD', data:series.map(s=>s.val), borderColor:'#C9A227', backgroundColor:'rgba(201,162,39,.18)', fill:true, tension:.38, pointRadius:3}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>' '+fmtUSD(c.parsed.y)}}},scales:{x:{grid:{display:false}},y:{ticks:{callback:v=>fmtUSD(v)}}}}});
}

function buildProgressBars(rows) {
  const el = document.getElementById('progress-bars'); if (!el) return;
  const clean = rows.filter(isCountryRow).sort((a,b)=>(b.value_month_usd||0)-(a.value_month_usd||0)).slice(0,7);
  const total = clean.reduce((s,r)=>s+(r.value_month_usd||0),0)||1;
  el.innerHTML = clean.map(r=>{const pct=(r.value_month_usd||0)/total*100; return `<div class="progress-item"><div class="prog-header"><span class="prog-name">${esc(r.country)}</span><span class="prog-val">${pct.toFixed(1)}%</span></div><div class="prog-bar-bg"><div class="prog-bar-fill" style="width:${pct}%"></div></div></div>`}).join('') || '<div class="empty-state">Chưa có dữ liệu</div>';
}

function renderBarChart() {
  const rows = getFilteredRows(state.activePeriod)
    .filter(r => isCountryRow(r) && r.value_month_usd)
    .sort((a, b) => (b.value_month_usd || 0) - (a.value_month_usd || 0))
    .slice(0, 10);

  const ctx = document.getElementById('bar-chart');
  destroyCanvasChart(ctx, 'barChart');
  if (!rows.length) {
    chartBoxEmpty('bar-chart', true, 'Chưa có dữ liệu thị trường cho kỳ này', 'No market data for this period');
    return;
  }
  chartBoxEmpty('bar-chart', false);

  if (typeof Chart === 'undefined') return;
  state.barChart = safeChart(ctx, {
    type: 'bar',
    data: {
      labels: rows.map(r => r.country || '?'),
      datasets: [{
        label: 'USD',
        data: rows.map(r => r.value_month_usd || 0),
        backgroundColor: 'rgba(201,162,39,.8)',
        hoverBackgroundColor: '#C9A227',
        borderColor: '#8A6D1C',
        borderWidth: 1,
        borderRadius: 6,
        borderSkipped: false,
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      maxBarThickness: 26,
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => ' ' + fmtUSD(ctx.parsed.x) } },
        // Phase 8: USD value at the end of each bar
        datalabels: {
          display: ctx => (ctx.parsed && ctx.parsed.x > 0),
          formatter: v => fmtUSD(v),
          anchor: 'end', align: 'end',
          color: '#4e3a13', font: { weight: 600, size: 10.5 },
          clamp: true,
        },
      },
      scales: {
        x: {
          grid: { color: 'rgba(90,74,40,.1)' },
          ticks: { color: '#8A7B5E', callback: v => fmtUSD(v) }
        },
        y: { grid: { display: false }, ticks: { color: '#2B2113', font: { size: 11, weight: 600 } } }
      }
    }
  });
}

function renderDonutChart() {
  const rows = getFilteredRows(state.activePeriod)
    .filter(r => isCountryRow(r) && r.value_month_usd)
    .sort((a, b) => (b.value_month_usd || 0) - (a.value_month_usd || 0));

  const top = rows.slice(0, 6);
  const othersVal = rows.slice(6).reduce((s, r) => s + (r.value_month_usd || 0), 0);
  const labels = top.map(r => r.country || '?');
  const data = top.map(r => r.value_month_usd || 0);
  if (othersVal > 0) { labels.push(state.lang === 'vi' ? 'Khác' : 'Others'); data.push(othersVal); }
  // Phase 11: dòng "Other" của Excel (nhóm chưa phân loại) — hiển thị slice riêng
  const otherRowVal = getFilteredRows(state.activePeriod)
    .filter(r => isCashewRow(r) && isOtherRow(r))
    .reduce((s, r) => s + (r.value_month_usd || 0), 0);
  // OCR reconciliation can produce a negative residual when source country
  // rows exceed the official total. A negative slice is invalid for a donut;
  // keep it visible in the table/QC, but omit it from market share visuals.
  if (otherRowVal > 0) {
    labels.push(state.lang === 'vi' ? 'Khác (chưa phân loại)' : 'Other (unclassified)');
    data.push(otherRowVal);
  }

  const ctx = document.getElementById('donut-chart');
  destroyCanvasChart(ctx, 'donutChart');

  const legendEl = document.getElementById('donut-legend');
  if (!data.length) {
    legendEl.innerHTML = '';
    chartBoxEmpty('donut-chart', true, 'Chưa có dữ liệu thị trường', 'No market data');
    return;
  }
  chartBoxEmpty('donut-chart', false);

  const total = data.reduce((s, v) => s + v, 0) || 1;
  const colors = labels.map((_, i) => GOLD[Math.min(i, GOLD.length - 1)]);

  if (typeof Chart === 'undefined') return;
  state.donutChart = safeChart(ctx, {
    type: 'doughnut',
    data: { labels, datasets: [{ data, backgroundColor: colors, borderColor: '#fff', borderWidth: 2, hoverOffset: 6 }] },
    options: {
      responsive: true, maintainAspectRatio: false, cutout: '68%',
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${fmtUSD(ctx.parsed)} (${(ctx.parsed / total * 100).toFixed(1)}%)` } },
        // Phase 8: % label on each segment (only ≥5% to avoid clutter)
        datalabels: {
          display: ctx => (ctx.parsed / total * 100) >= 5,
          formatter: ctx => (ctx.parsed / total * 100).toFixed(0) + '%',
          color: '#fff',
          font: { weight: 700, size: 11 },
          textStrokeColor: 'rgba(43,33,19,.35)',
          textStrokeWidth: 2,
        },
      }
    }
  });

  legendEl.innerHTML = labels.map((lb, i) => `
    <div class="dl-row">
      <span class="dl-dot" style="background:${colors[i]}"></span>
      <span class="dl-name">${esc(lb)}</span>
      <span class="dl-val">${fmtUSD(data[i])} · ${(data[i] / total * 100).toFixed(1)}%</span>
    </div>`).join('');
}

function periodTotals(p) {
  const pd = state.periods[p] || {};
  const hasCountryFilters = Boolean(state.filters.region || state.searchQuery);
  if (state.flow !== 'balance' && !hasCountryFilters) {
    const officialSummary = pickVersionedSummary(pd, state.flow)
      || ((state.flow === 'import' ? pd.tong_nk : pd.tong_xk)
        && !isEstimatedSummary(state.flow === 'import' ? pd.tong_nk : pd.tong_xk)
        ? (state.flow === 'import' ? pd.tong_nk : pd.tong_xk) : null);
    if (officialSummary) {
      return {
        qty: officialSummary.quantity_month ?? 0,
        val: officialSummary.value_month_usd ?? 0,
        valY: officialSummary.value_ytd_usd ?? 0,
        qtyY: officialSummary.quantity_ytd ?? 0,
      };
    }
    if (state.dataSource !== 'vinacas') return { qty: null, val: null, valY: null, qtyY: null };
  }
  if (state.flow === 'balance') {
    const exp = pickVersionedSummary(pd, 'export') || (pd.tong_xk && !isEstimatedSummary(pd.tong_xk) ? pd.tong_xk : null);
    const imp = pickVersionedSummary(pd, 'import') || (pd.tong_nk && !isEstimatedSummary(pd.tong_nk) ? pd.tong_nk : null);
    if (!exp || !imp) {
      return { qty: null, val: null, valY: null, qtyY: null };
    }
    const xk_rows = (pd.countryRowsXk || pd.countryRows || []).filter(isCashewRow);
    const nk_rows = (pd.countryRowsNk || []).filter(isCashewRow);
    const sum = (arr, key) => arr.reduce((s, r) => s + (r[key] || 0), 0);
    const xk_val = exp.value_month_usd ?? 0;
    const nk_val = imp.value_month_usd ?? 0;
    const xk_qty = exp.quantity_month ?? 0;
    const nk_qty = imp.quantity_month ?? 0;
    const xk_valY = exp.value_ytd_usd ?? 0;
    const nk_valY = imp.value_ytd_usd ?? 0;
    const xk_qtyY = exp.quantity_ytd ?? 0;
    const nk_qtyY = imp.quantity_ytd ?? 0;
    return {
      qty: xk_qty - nk_qty,
      val: xk_val - nk_val,
      valY: xk_valY - nk_valY,
      qtyY: xk_qtyY - nk_qtyY,
    };
  }
  const rows = getFilteredRows(p).filter(isCashewRow);
  if (hasCountryFilters && !rows.length) return { qty: null, val: null, valY: null, qtyY: null };
  let sRows = (pd.summaryRows || []).filter(isCashewRow);
  if (state.flow === 'import') {
    sRows = sRows.filter(r => r.direction === 'import');
    if (!rows.length && !sRows.length && pd.tong_nk) {
      return {
        qty: pd.tong_nk.quantity_month || 0,
        val: pd.tong_nk.value_month_usd || 0,
        valY: pd.tong_nk.value_ytd_usd || 0,
        qtyY: pd.tong_nk.quantity_ytd || 0,
      };
    }
  } else {
    sRows = sRows.filter(r => !r.direction || r.direction === 'export');
    if (!rows.length && !sRows.length && pd.tong_xk) {
      return {
        qty: pd.tong_xk.quantity_month || 0,
        val: pd.tong_xk.value_month_usd || 0,
        valY: pd.tong_xk.value_ytd_usd || 0,
        qtyY: pd.tong_xk.quantity_ytd || 0,
      };
    }
  }
  // Master Plan v2 (Phase B): khi tổng chạy theo summary, ưu tiên dòng đúng phiên bản
  // đang chọn (Chính thức → Điều chỉnh → Sơ bộ, tự hạ cấp không bỏ trống).
  if (!rows.length) {
    const vRow = pickVersionedSummary(pd, state.flow);
    if (vRow) {
      return {
        qty: vRow.quantity_month || 0,
        val: vRow.value_month_usd || 0,
        valY: vRow.value_ytd_usd || 0,
        qtyY: vRow.quantity_ytd || 0,
      };
    }
  }
  const source = rows.length ? rows : sRows;
  const sum = (key) => source.reduce((s, r) => s + (r[key] || 0), 0);
  return { qty: sum('quantity_month'), val: sum('value_month_usd'), valY: sum('value_ytd_usd'), qtyY: sum('quantity_ytd') };
}

function renderPeriodsTable() {
  const tbody = document.getElementById('periods-body');
  const periods = getFilteredPeriods();
  if (!periods.length) return;

  let prevVal = null;
  const rowsHtml = periods.map(p => {
    const t = periodTotals(p);
    let delta = '<span class="pill flat">—</span>';
    if (prevVal != null && prevVal > 0 && t.val != null) {
      const pct = (t.val - prevVal) / prevVal * 100;
      if (pct > 0.05) delta = `<span class="pill up">▲ ${pct.toFixed(1)}%</span>`;
      else if (pct < -0.05) delta = `<span class="pill down">▼ ${Math.abs(pct).toFixed(1)}%</span>`;
      else delta = '<span class="pill flat">• 0%</span>';
    }
    prevVal = t.val;
    const activeMark = p === state.activePeriod ? ' →' : '';
    return `<tr style="cursor:pointer" onclick="setActivePeriod('${p}')">
      <td class="country">${p}${activeMark}</td>
      <td class="num">${fmt(t.qty)}</td>
      <td class="num">${fmtUSD(t.val)}</td>
      <td class="num">${fmtUSD(t.valY)}</td>
      <td class="num">${delta}</td>
    </tr>`;
  }).join('');
  tbody.innerHTML = rowsHtml;
}

// ── Tab: COUNTRIES ────────────────────────────────────────────────────────────
const debounceSearch = debounce((q) => {
  state.searchQuery = stripAccents(q.toLowerCase());
  refreshFilterDependent();
}, 300);

function applyFilters() {
  const pfEl = document.getElementById('product-filter');
  const productFilter = pfEl ? stripAccents((pfEl.value || '').toLowerCase()) : '';
  // Base set: period + region filter (recomputed so a broadened search restores rows)
  state.allCountryRows = getFilteredRowsBase(state.activePeriod);
  state.filteredRows = state.allCountryRows.filter(r => {
    const pMatch = !productFilter || stripAccents((r.product || '').toLowerCase()).includes(productFilter);
    const cMatch = !state.searchQuery || stripAccents((r.country || '').toLowerCase()).includes(state.searchQuery);
    return pMatch && cMatch;
  });
  sortRows();
  renderTable();
}

function sortTable(col) {
  if (state.sortCol === col) state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
  else { state.sortCol = col; state.sortDir = 'desc'; }
  state.page = 1;
  sortRows();
  renderTable();
  updateSortIndicators();
}

function updateSortIndicators() {
  document.querySelectorAll('#pivot-table thead th').forEach(th => {
    th.classList.remove('sorted-asc', 'sorted-desc');
    if (th.dataset.col === state.sortCol) th.classList.add(`sorted-${state.sortDir}`);
  });
}

function sortRows() {
  const col = state.sortCol;
  const dir = state.sortDir === 'asc' ? 1 : -1;
  state.filteredRows.sort((a, b) => {
    let av = a[col], bv = b[col];
    if (typeof av === 'string') return dir * (av || '').localeCompare(bv || '', 'vi');
    av = av ?? -Infinity;
    bv = bv ?? -Infinity;
    return dir * (av - bv);
  });
}

function renderTable() {
  const tbody = document.getElementById('pivot-body');
  const rows = state.filteredRows;
  const total = rows.length;
  const pages = Math.max(1, Math.ceil(total / state.pageSize));
  state.page = Math.min(state.page, pages);
  const start = (state.page - 1) * state.pageSize;
  const pageRows = rows.slice(start, start + state.pageSize);
  const maxVal = Math.max(...rows.map(r => r.value_month_usd || 0), 1);

  const rcEl = document.getElementById('record-n');
  if (rcEl) rcEl.textContent = total;

  if (!pageRows.length) {
    tbody.innerHTML = `<tr><td colspan="7"><div class="empty-state">
      <div class="empty-icon">📂</div>
      <span>${state.lang === 'vi' ? 'Chưa có dữ liệu — tải file Excel để bắt đầu' : 'No data — upload an Excel file to begin'}</span>
    </div></td></tr>`;
    renderPagination(0, 0);
    document.getElementById('page-info').textContent = '';
    return;
  }

  tbody.innerHTML = pageRows.map(r => {
    const barPct = Math.round(((r.value_month_usd || 0) / maxVal) * 100);
    return `<tr>
      <td class="country">${esc(r.country) || '—'}</td>
      <td class="product">${esc(r.product) || '—'}</td>
      <td>${esc(r.unit) || '—'}</td>
      <td class="num">${fmt(r.quantity_month)}</td>
      <td class="num"><div class="value-bar">
        <span class="vb-val">${fmtUSD(r.value_month_usd)}</span>
        <div class="bar-bg"><div class="bar-fill" style="width:${barPct}%"></div></div>
      </div></td>
      <td class="num">${fmt(r.quantity_ytd)}</td>
      <td class="num">${fmtUSD(r.value_ytd_usd)}</td>
    </tr>`;
  }).join('');

  renderPagination(total, pages);
  document.getElementById('page-info').textContent =
    `${state.lang === 'vi' ? 'Trang' : 'Page'} ${state.page}/${pages} · ${total} ${state.lang === 'vi' ? 'dòng' : 'rows'}`;
}

function renderPagination(total, pages) {
  const pg = document.getElementById('pagination');
  pg.innerHTML = '';
  if (pages <= 1) return;
  const addBtn = (label, page, disabled = false, active = false) => {
    const btn = document.createElement('button');
    btn.className = 'page-btn' + (active ? ' active' : '');
    btn.textContent = label;
    btn.disabled = disabled;
    btn.onclick = () => { state.page = page; renderTable(); };
    pg.appendChild(btn);
  };
  addBtn('‹', state.page - 1, state.page <= 1);
  const range = new Set([1, pages]);
  for (let i = Math.max(1, state.page - 2); i <= Math.min(pages, state.page + 2); i++) range.add(i);
  let prev = null;
  [...range].sort((a, b) => a - b).forEach(i => {
    if (prev && i - prev > 1) {
      const el = document.createElement('button');
      el.className = 'page-btn'; el.textContent = '…'; el.disabled = true;
      pg.appendChild(el);
    }
    addBtn(i, i, false, i === state.page);
    prev = i;
  });
  addBtn('›', state.page + 1, state.page >= pages);
}

// ── Tab: MAP (gold choropleth, ISO A3) ────────────────────────────────────────
async function renderMap() {
  const cashewRows = getFilteredRows(state.activePeriod).filter(isCountryRow);

  const mapEl = document.getElementById('world-map');
  const legendEl = document.getElementById('map-legend');

  destroyCanvasChart(document.getElementById('mp-trend-chart'), 'mapTrendChart');

  if (!cashewRows.length) {
    if (state.geoLayer) { state.geoLayer.remove(); state.geoLayer = null; }
    legendEl.style.display = 'none';
    if (!mapEl.querySelector('.empty-state')) {
      mapEl.innerHTML = `<div class="empty-state"><div class="empty-icon">🗺️</div>
        <span>${state.lang === 'vi' ? 'Kỳ này không có dữ liệu quốc gia' : 'No country data for this period'}</span></div>`;
    }
    renderMapPanel(null);
    return;
  }

  if (!state.leafletMap) {
    mapEl.innerHTML = '';
    state.leafletMap = L.map('world-map', {
      center: [22, 12], zoom: 2, scrollWheelZoom: true,
      attributionControl: false,
      zoomControl: true,
    });
    // No tile basemap: clean professional choropleth on soft background
    // (CARTO/OSM tiles now show API-key watermarks; a plain canvas looks better)
  }

  if (state.geoLayer) { state.geoLayer.remove(); state.geoLayer = null; }

  // Build per-ISO aggregates (value, quantity, YTD) for the active period
  const agg = {};
  cashewRows.forEach(r => {
    const nameAscii = stripAccents((r.country || '').toUpperCase().trim());
    const iso = COUNTRY_ISO[nameAscii] || null;
    if (!iso) return;
    const a = agg[iso] = agg[iso] || { name: r.country, value: 0, qty: 0, valY: 0 };
    a.value += r.value_month_usd || 0;
    a.qty += r.quantity_month || 0;
    a.valY += r.value_ytd_usd || 0;
  });
  state.mapAgg = agg;
  state.mapTotalVal = Object.values(agg).reduce((s, a) => s + a.value, 0) || 1;

  // Quantile-based color breaks — robust against skewed export values
  // (linear scale makes every market except the top 1-2 look identical)
  const vals = Object.values(agg).map(a => a.value).filter(v => v > 0).sort((x, y) => x - y);
  const q = p => vals.length ? vals[Math.min(vals.length - 1, Math.floor(p * vals.length))] : 0;
  const breaks = vals.length >= 5
    ? [q(.2), q(.4), q(.6), q(.8)]
    : [0.2, 0.4, 0.6, 0.8].map(p => Math.max(...vals, 1) * p);
  state.mapBreaks = breaks;

  renderMapLegend(breaks);
  legendEl.style.display = '';

  // Load GeoJSON once (source with ISO A3 ids)
  if (!state.geojson) {
    try {
      const resp = await fetch('https://raw.githubusercontent.com/johan/world.geo.json/master/countries.geo.json');
      state.geojson = await resp.json();
    } catch {
      showToast(state.lang === 'vi' ? 'Không tải được dữ liệu bản đồ' : 'Failed to load map GeoJSON', 'error');
      return;
    }
  }

  // Clear stale selection if the selected market has no data in this period
  if (state.mapSelectedIso && !agg[state.mapSelectedIso]) state.mapSelectedIso = null;

  function getColor(val) {
    if (!val) return '#EFE9D8';
    if (val <= breaks[0]) return '#F5E9C4';
    if (val <= breaks[1]) return '#E9D591';
    if (val <= breaks[2]) return '#D6B44A';
    if (val <= breaks[3]) return '#C9A227';
    return '#8A6D1C';
  }

  state.geoLayer = L.geoJSON(state.geojson, {
    style: feat => {
      const iso = (feat.id || '').toUpperCase();
      const a = agg[iso];
      const val = a ? a.value : 0;
      const selected = state.mapSelectedIso === iso;
      return {
        fillColor: getColor(val),
        fillOpacity: val ? (selected ? 1 : 0.85) : 0.5,
        color: selected ? '#3E7C4F' : '#B3A782',
        weight: selected ? 2.4 : 0.6,
      };
    },
    onEachFeature: (feat, layer) => {
      const iso = (feat.id || '').toUpperCase();
      const a = agg[iso];
      const val = a ? a.value : 0;
      const name = feat.properties && feat.properties.name ? feat.properties.name : iso;
      layer.bindTooltip(
        `<b>${esc(name)}</b><br>${val ? fmtUSD(val) : (state.lang === 'vi' ? 'Không có dữ liệu' : 'No data')}`,
        { sticky: true }
      );
      layer.on({
        mouseover: e => { if (state.mapSelectedIso !== iso) e.target.setStyle({ weight: 1.6, color: '#5C470F' }); },
        mouseout: e => state.geoLayer.resetStyle(e.target),
        click: () => selectMapCountry(iso, layer),
      });
    },
  }).addTo(state.leafletMap);

  renderMapPanel(state.mapSelectedIso);
  setTimeout(() => state.leafletMap.invalidateSize(), 100);
}

// ── Map: quantile legend with real value breaks ───────────────────────────────
function renderMapLegend(breaks) {
  const rowsEl = document.getElementById('map-legend-rows');
  if (!rowsEl) return;
  const steps = ['#F5E9C4', '#E9D591', '#D6B44A', '#C9A227', '#8A6D1C'];
  const b = breaks.map(v => fmtUSD(v));
  const labels = [
    `≤ ${b[0]}`,
    `${b[0]} – ${b[1]}`,
    `${b[1]} – ${b[2]}`,
    `${b[2]} – ${b[3]}`,
    `> ${b[3]}`,
  ];
  rowsEl.innerHTML = steps.map((c, i) =>
    `<div class="ml-row"><span class="ml-swatch" style="background:${c}"></span><span>${labels[i]}</span></div>`
  ).join('') + `<div class="ml-row"><span class="ml-swatch" style="background:#EFE9D8"></span><span>${state.lang === 'vi' ? 'Không có dữ liệu' : 'No data'}</span></div>`;
}

// ── Map: click-to-select a country → detail panel + zoom ──────────────────────
function selectMapCountry(iso, layer) {
  const agg = state.mapAgg || {};
  if (!agg[iso]) {
    showToast(state.lang === 'vi' ? 'Không có dữ liệu hạt điều cho quốc gia này' : 'No cashew data for this country', 'info');
    return;
  }
  state.mapSelectedIso = iso;
  if (state.geoLayer) state.geoLayer.resetStyle();
  if (layer) {
    layer.setStyle({ weight: 2.4, color: '#3E7C4F', fillOpacity: 1 });
    layer.bringToFront();
    try { state.leafletMap.fitBounds(layer.getBounds(), { padding: [40, 40], maxZoom: 6 }); } catch (e) { /* bounds unavailable */ }
  }
  const btn = document.getElementById('map-reset');
  if (btn) btn.style.display = '';
  renderMapPanel(iso);
}

function resetMapView() {
  state.mapSelectedIso = null;
  if (state.geoLayer) state.geoLayer.resetStyle();
  if (state.leafletMap) state.leafletMap.setView([22, 12], 2);
  const btn = document.getElementById('map-reset');
  if (btn) btn.style.display = 'none';
  renderMapPanel(null);
}

// ── Map: detail side panel (KPIs + trend across periods) ──────────────────────
function renderMapPanel(iso) {
  const hint = document.getElementById('map-panel-hint');
  const detail = document.getElementById('map-panel-detail');
  if (!hint || !detail) return;
  const agg = state.mapAgg || {};

  if (!iso || !agg[iso]) {
    hint.style.display = '';
    detail.style.display = 'none';
    return;
  }
  hint.style.display = 'none';
  detail.style.display = '';

  const a = agg[iso];
  const ranked = Object.entries(agg).sort((x, y) => y[1].value - x[1].value);
  const rank = ranked.findIndex(([k]) => k === iso) + 1;

  document.getElementById('mp-rank').textContent = '#' + rank;
  document.getElementById('mp-name').textContent = a.name || iso;
  document.getElementById('mp-val').textContent = fmtUSD(a.value);
  document.getElementById('mp-qty').textContent = fmt(a.qty);
  document.getElementById('mp-ytd').textContent = fmtUSD(a.valY);
  document.getElementById('mp-share').textContent = (a.value / (state.mapTotalVal || 1) * 100).toFixed(1) + '%';
  const per = document.getElementById('mp-period');
  if (per) per.textContent = state.activePeriod || '—';

  // Country value trend across ALL loaded periods
  const periods = Object.keys(state.periods).sort();
  const trendVals = periods.map(p => {
    if (!periodDetailIsTrusted(p, state.flow === 'balance' ? 'export' : state.flow)) return null;
    const rows = getFilteredRows(p).filter(isCountryRow);
    return rows.reduce((s, r) =>
      s + (COUNTRY_ISO[stripAccents((r.country || '').toUpperCase().trim())] === iso ? (r.value_month_usd || 0) : 0), 0);
  });

  const canvas = document.getElementById('mp-trend-chart');
  destroyCanvasChart(canvas, 'mapTrendChart');
  if (typeof Chart === 'undefined') return;
  state.mapTrendChart = safeChart(canvas, {
    type: 'line',
    data: {
      labels: periods,
      datasets: [{
        label: 'USD',
        data: trendVals,
        borderColor: '#C9A227',
        backgroundColor: 'rgba(201,162,39,.15)',
        fill: true,
        tension: .35,
        pointRadius: periods.length > 24 ? 0 : 2.5,
        borderWidth: 2,
      }],
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { ticks: { maxTicksLimit: 6, maxRotation: 0 }, grid: { display: false } },
        y: { ticks: { callback: v => fmtUSD(v), maxTicksLimit: 5 }, grid: { color: 'rgba(90,74,40,.08)' } },
      },
    },
  });
}

// ── Map: jump from panel to the country table (pre-filtered) ──────────────────
function jumpToCountryTable() {
  const agg = state.mapAgg || {};
  const a = agg[state.mapSelectedIso];
  switchTab('countries');
  const searchEl = document.getElementById('country-search');
  if (searchEl && a && a.name) {
    searchEl.value = a.name;
    debounceSearch(a.name);
  }
}

// ── Tab: TRENDS ───────────────────────────────────────────────────────────────
function renderTrends() {
  renderLineChart();                              // Trị giá CY
  const series = aggregateSeries(getFilteredPeriods());
  buildYtdLineChart(series);                      // Trị giá YTD lũy kế
  buildQtyBarChart(series);                       // Sản lượng CY
  buildYtdQtyChart(series);                       // Sản lượng YTD lũy kế
  renderTrendsTable();
}

// ── Phase 13: chart YTD trị giá lũy kế (tách khỏi chart CY) ──────────────────
function buildYtdLineChart(series) {
  const el = document.getElementById('ytd-line-chart');
  if (!el) return;
  chartBoxEmpty('ytd-line-chart', !series.length, 'Cần tải ít nhất một kỳ dữ liệu', 'Load at least one period');
  if (!series.length) { destroyCanvasChart(el, 'ytdLineChart'); return; }
  chartBase('ytdLineChart', 'ytd-line-chart', {
    type: 'line',
    data: {
      labels: series.map(s => s.label),
      datasets: [{
        label: state.lang === 'vi' ? 'YTD Trị giá (USD)' : 'YTD Value (USD)',
        data: series.map(s => s.valY),
        borderColor: '#3E7C4F',
        backgroundColor: 'rgba(62,124,79,.10)',
        borderWidth: 2.5,
        pointBackgroundColor: '#2E5C3B',
        pointBorderColor: '#fff',
        pointBorderWidth: 1.5,
        pointRadius: series.length > 30 ? 2 : 4,
        pointHoverRadius: 6,
        fill: true,
        tension: .35,
        // label tại mốc cuối mỗi năm (điểm trước khi YTD reset)
        datalabels: {
          display: ctx => ctx.dataIndex === series.length - 1 || (ctx.dataIndex < series.length - 1 && series[ctx.dataIndex].label.slice(0, 4) !== series[ctx.dataIndex + 1].label.slice(0, 4)),
          formatter: v => fmtUSD(v),
          align: 'top', color: '#2E5C3B', font: { weight: 700, size: 10.5 },
        },
      }],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ' ' + fmtUSD(c.parsed.y) } } },
      scales: {
        x: { grid: { display: false }, ticks: { maxTicksLimit: 14, maxRotation: 0 } },
        y: { grid: { color: 'rgba(90,74,40,.08)' }, ticks: { callback: v => fmtUSD(v) } },
      },
    },
  });
}

// ── Phase 13: sản lượng CY thuần (bỏ stack CY+YTD sai ngữ nghĩa) ─────────────
function buildQtyBarChart(series) {
  const el = document.getElementById('stacked-chart');
  if (!el) return;
  chartBoxEmpty('stacked-chart', !series.length, 'Chưa có dữ liệu sản lượng', 'No volume data');
  if (!series.length) { destroyCanvasChart(el, 'stackedChart'); return; }
  chartBase('stackedChart', 'stacked-chart', {
    type: 'bar',
    data: {
      labels: series.map(s => s.label),
      datasets: [{
        label: state.lang === 'vi' ? 'Sản lượng CY (Tấn)' : 'CY Volume (Tons)',
        data: series.map(s => s.qty),
        backgroundColor: 'rgba(201,162,39,.8)',
        hoverBackgroundColor: '#C9A227',
        borderColor: '#8A6D1C',
        borderWidth: 1,
        borderRadius: 5,
        maxBarThickness: 30,
      }],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: c => ' ' + fmt(c.parsed.y) + ' Tấn' } },
      },
      scales: {
        x: { grid: { display: false }, ticks: { maxTicksLimit: 14, maxRotation: 0 } },
        y: { grid: { color: 'rgba(90,74,40,.08)' }, ticks: { callback: v => fmt(v) } },
      },
    },
  });
}

// ── Phase 13: sản lượng YTD lũy kế (chart riêng) ─────────────────────────────
function buildYtdQtyChart(series) {
  const el = document.getElementById('ytd-qty-chart');
  if (!el) return;
  chartBoxEmpty('ytd-qty-chart', !series.length, 'Chưa có dữ liệu sản lượng', 'No volume data');
  if (!series.length) { destroyCanvasChart(el, 'ytdQtyChart'); return; }
  chartBase('ytdQtyChart', 'ytd-qty-chart', {
    type: 'line',
    data: {
      labels: series.map(s => s.label),
      datasets: [{
        label: state.lang === 'vi' ? 'YTD Sản lượng (Tấn)' : 'YTD Volume (Tons)',
        data: series.map(s => s.qtyY),
        borderColor: '#2C6E9B',
        backgroundColor: 'rgba(44,110,155,.10)',
        borderWidth: 2.5,
        pointBackgroundColor: '#1F5075',
        pointBorderColor: '#fff',
        pointBorderWidth: 1.5,
        pointRadius: series.length > 30 ? 2 : 4,
        pointHoverRadius: 6,
        fill: true,
        tension: .35,
      }],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => ' ' + fmt(c.parsed.y) + ' Tấn' } } },
      scales: {
        x: { grid: { display: false }, ticks: { maxTicksLimit: 14, maxRotation: 0 } },
        y: { grid: { color: 'rgba(90,74,40,.08)' }, ticks: { callback: v => fmt(v) } },
      },
    },
  });
}

// (buildMultiLineChart + buildStackedBarChart cũ đã thay bằng 4 chart CY/YTD riêng — Phase 13)

function buildRadarChart(rows) {
  const top=rows.filter(isCountryRow).sort((a,b)=>(b.value_month_usd||0)-(a.value_month_usd||0)).slice(0,5); const el=document.getElementById('radar-chart'); if(!el)return;
  chartBase('radarChart','radar-chart',{type:'radar',data:{labels:top.map(r=>r.country),datasets:[{label:'CY Value (normalized)',data:top.map(r=>r.value_month_usd||0),backgroundColor:'rgba(201,162,39,.2)',borderColor:'#C9A227'},{label:'CY Qty (normalized)',data:top.map(r=>(r.quantity_month||0)*3000),backgroundColor:'rgba(62,124,79,.12)',borderColor:'#3E7C4F'}]},options:{responsive:true,maintainAspectRatio:false,scales:{r:{beginAtZero:true}}}});
}

function buildBubbleChart(rows) {
  const top=rows.filter(isCountryRow).sort((a,b)=>(b.value_month_usd||0)-(a.value_month_usd||0)).slice(0,20); const total=top.reduce((s,r)=>s+(r.value_month_usd||0),0)||1;
  chartBase('bubbleChart','bubble-chart',{type:'bubble',data:{datasets:[{label:'Markets',data:top.map(r=>({x:r.quantity_month||0,y:r.value_month_usd||0,r:Math.max(4,Math.sqrt((r.value_month_usd||0)/total)*28),country:r.country})),backgroundColor:'rgba(201,162,39,.62)',borderColor:'#8A6D1C'}]},options:{responsive:true,maintainAspectRatio:false,plugins:{tooltip:{callbacks:{label:c=>`${c.raw.country}: ${fmtUSD(c.raw.y)}`}}},scales:{x:{title:{display:true,text:'Quantity (Tons)'}},y:{title:{display:true,text:'Value (USD)'},ticks:{callback:v=>fmtUSD(v)}}}}});
}

function renderLineChart() {
  const series = aggregateSeries(getFilteredPeriods());
  const periods = series.map(s => s.label);
  const data = series.map(s => s.val);

  const ctx = document.getElementById('line-chart');
  destroyCanvasChart(ctx, 'lineChart');

  if (!data.length || data.every(v => !v)) {
    chartBoxEmpty('line-chart', true, 'Cần tải ít nhất một kỳ dữ liệu', 'Load at least one period');
    return;
  }
  chartBoxEmpty('line-chart', false);

  if (typeof Chart === 'undefined') return;
  state.lineChart = safeChart(ctx, {
    type: 'line',
    data: {
      labels: periods,
      datasets: [{
        label: 'USD',
        data: data,
        borderColor: '#C9A227',
        backgroundColor: 'rgba(201,162,39,.14)',
        borderWidth: 2.5,
        pointBackgroundColor: '#8A6D1C',
        pointBorderColor: '#fff',
        pointBorderWidth: 1.5,
        pointRadius: periods.length > 30 ? 2 : 5,
        pointHoverRadius: 7,
        fill: true,
        tension: 0.4,
        // Phase 8: label the peak point only (keeps the line clean)
        datalabels: {
          display: ctx => ctx.dataIndex === data.indexOf(Math.max(...data)),
          formatter: v => fmtUSD(v),
          align: 'top', color: '#4e3a13', font: { weight: 700, size: 11 },
        },
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => ' ' + fmtUSD(ctx.parsed.y) } }
      },
      scales: {
        x: { grid: { color: 'rgba(90,74,40,.1)' }, ticks: { color: '#8A7B5E', maxTicksLimit: 14, maxRotation: 0 } },
        y: { grid: { color: 'rgba(90,74,40,.1)' }, ticks: { color: '#8A7B5E', callback: v => fmtUSD(v) } }
      }
    }
  });
}

function renderTrendsTable() {
  const tbody = document.getElementById('trends-body');
  const periods = getFilteredPeriods();
  if (!periods.length) return;

  let prevVal = null;
  tbody.innerHTML = periods.map(p => {
    const t = periodTotals(p);
    let delta = '<span class="pill flat">—</span>';
    if (prevVal != null && prevVal > 0 && t.val != null) {
      const pct = (t.val - prevVal) / prevVal * 100;
      if (pct > 0.05) delta = `<span class="pill up">▲ +${pct.toFixed(1)}%</span>`;
      else if (pct < -0.05) delta = `<span class="pill down">▼ ${pct.toFixed(1)}%</span>`;
      else delta = '<span class="pill flat">• 0%</span>';
    }
    prevVal = t.val;
    return `<tr>
      <td class="country">${p}</td>
      <td class="num">${fmt(t.qty)}</td>
      <td class="num">${fmtUSD(t.val)}</td>
      <td class="num">${fmtUSD(t.valY)}</td>
      <td class="num">${delta}</td>
    </tr>`;
  }).join('');
}

// ── Phase 7: Aggregation engine (Tháng / Quý / Năm) ───────────────────────────
function periodBucketLabel(period, granularity) {
  if (granularity === 'year') return period.slice(0, 4);
  if (granularity === 'quarter') return `${period.slice(0, 4)}-Q${Math.floor((+period.slice(5, 7) - 1) / 3) + 1}`;
  return period;
}

function aggregateSeries(periods, granularity = state.filters.granularity) {
  const buckets = new Map();
  periods.forEach(p => {
    const label = periodBucketLabel(p, granularity);
    const t = periodTotals(p);
    const b = buckets.get(label) || { qty: 0, val: 0, valY: null, qtyY: null, periods: 0, valid: 0 };
    b.periods += 1;
    if ([t.qty, t.val, t.qtyY, t.valY].every(v => Number.isFinite(v))) {
      b.valid += 1;
      b.qty += t.qty;
      b.val += t.val;
      b.valY = Math.max(b.valY ?? -Infinity, t.valY); // YTD: last/highest cumulative point
      b.qtyY = Math.max(b.qtyY ?? -Infinity, t.qtyY);
    }
    buckets.set(label, b);
  });
  return [...buckets.entries()]
    .sort((a, b) => a[0].localeCompare(b[0]))
    .map(([label, b]) => ({ label, qty: b.valid === b.periods ? b.qty : null,
      val: b.valid === b.periods ? b.val : null,
      valY: b.valid === b.periods ? b.valY : null,
      qtyY: b.valid === b.periods ? b.qtyY : null }));
}

function yearlyTotals(year) {
  const periods = getFilteredPeriods().filter(p => p.startsWith(String(year)));
  return aggregateSeries(periods, 'year')[0] || null;
}

function yoyDelta(series, key = 'val') {
  return series.map((s, i) => {
    const prev = i > 0 ? series[i - 1][key] : null;
    const value = s[key];
    const deltaPct = (prev != null && prev > 0 && value != null) ? (value - prev) / prev * 100 : null;
    return { label: s.label, value, prev, deltaPct };
  });
}

function deltaPill(pct) {
  if (pct == null) return '<span class="pill flat">—</span>';
  if (pct > 0.05) return `<span class="pill up">▲ +${pct.toFixed(1)}%</span>`;
  if (pct < -0.05) return `<span class="pill down">▼ ${pct.toFixed(1)}%</span>`;
  return '<span class="pill flat">• 0%</span>';
}

// ── Tab: COMPARE (so sánh theo năm) ───────────────────────────────────────────
function yearlyRows(year) {
  // All cashew rows belonging to a given year (respect region + search filters)
  const periods = getFilteredPeriods().filter(p => p.startsWith(year));
  if (state.dataSource !== 'vinacas'
      && periods.some(p => !periodDetailIsTrusted(p, state.flow === 'balance' ? 'export' : state.flow))) return [];
  return periods
    .flatMap(p => getFilteredRows(p))
    .filter(isCashewRow);
}

function topMarketForYear(year) {
  const sums = new Map();
  yearlyRows(year).forEach(r => {
    if (!isCountryRow(r)) return; // Phase 11: bỏ dòng "Other"
    sums.set(r.country, (sums.get(r.country) || 0) + (r.value_month_usd || 0));
  });
  let top = null;
  sums.forEach((v, k) => { if (!top || v > top.val) top = { country: k, val: v }; });
  return top;
}

function renderCompare() {
  renderCompareKPIs();
  renderCompareBar();
  renderCompareTable();
  renderCompareMatrix();
}

function renderCompareKPIs() {
  const el = document.getElementById('compare-kpis');
  if (!el) return;
  const years = [...new Set(getFilteredPeriods().map(p => p.slice(0, 4)))].sort();
  if (!years.length) {
    el.innerHTML = `<div class="empty-state" style="grid-column:1/-1"><div class="empty-icon">⚖️</div><span>${state.lang === 'vi' ? 'Cần tải dữ liệu để so sánh' : 'Load data to compare'}</span></div>`;
    return;
  }
  const series = years.map(y => {
    const totals = yearlyTotals(y);
    return { year: y, val: totals && totals.val, qty: totals && totals.qty };
  });
  const last = series.at(-1);
  const validYears = series.filter(s => Number.isFinite(s.val) && Number.isFinite(s.qty));
  const prev = validYears.length > 1 ? validYears.at(-2) : null;
  const dPct = (curr, before) => (curr != null && before != null && before > 0) ? ((curr - before) / before * 100) : null;
  const subPrev = prev ? `vs ${prev.year}` : (state.lang === 'vi' ? 'Năm đầu tiên' : 'First year');

  const cards = [
    { ico: '💵', labelVi: `Trị giá ${last.year}`, labelEn: `Value ${last.year}`, val: fmtUSD(last.val), delta: dPct(last.val, prev && prev.val), sub: subPrev },
    { ico: '📦', labelVi: `Sản lượng ${last.year}`, labelEn: `Volume ${last.year}`, val: fmt(last.qty), delta: dPct(last.qty, prev && prev.qty), sub: subPrev },
    { ico: '🏆', labelVi: 'Năm cao nhất', labelEn: 'Peak year', val: validYears.length ? validYears.reduce((b, s) => s.val > b.val ? s : b, validYears[0]).year : '—', delta: null, sub: validYears.length ? `${fmtUSD(Math.max(...validYears.map(s => s.val)))}` : '—' },
    { ico: '📊', labelVi: 'Số năm so sánh', labelEn: 'Years compared', val: String(validYears.length), delta: null, sub: `${years[0]} → ${years.at(-1)}` },
  ];
  el.innerHTML = cards.map(c => `
    <div class="kpi-card">
      <div class="kpi-icon" aria-hidden="true">${c.ico}</div>
      <div>
        <div class="kpi-label"><span class="lang-vi">${c.labelVi}</span><span class="lang-en" style="display:none">${c.labelEn}</span></div>
        <div class="kpi-value">${esc(c.val)}</div>
        <div class="kpi-sub">${c.delta != null ? deltaPill(c.delta) + ' ' : ''}<span>${esc(c.sub)}</span></div>
      </div>
    </div>`).join('');
}

function renderCompareBar() {
  const canvas = document.getElementById('compare-bar');
  if (!canvas) return;
  destroyCanvasChart(canvas, 'compareChart');
  const years = [...new Set(getFilteredPeriods().map(p => p.slice(0, 4)))].sort();
  if (!years.length) { chartBoxEmpty('compare-bar', true, 'Cần tải dữ liệu để so sánh', 'Load data to compare'); return; }
  chartBoxEmpty('compare-bar', false);

  const vals = years.map(y => yearlyTotals(y)?.val ?? null);
  const qtys = years.map(y => yearlyTotals(y)?.qty ?? null);

  if (typeof Chart === 'undefined') return;
  state.compareChart = safeChart(canvas, {
    type: 'bar',
    data: {
      labels: years,
      datasets: [
        {
          label: state.lang === 'vi' ? 'Trị giá (USD)' : 'Value (USD)',
          data: vals,
          backgroundColor: 'rgba(201,162,39,.82)',
          hoverBackgroundColor: '#C9A227',
          borderColor: '#8A6D1C', borderWidth: 1,
          borderRadius: 6, yAxisID: 'y',
        },
        {
          label: state.lang === 'vi' ? 'Sản lượng (Tấn)' : 'Volume (Tons)',
          data: qtys,
          backgroundColor: 'rgba(62,124,79,.55)',
          hoverBackgroundColor: '#3E7C4F',
          borderColor: '#2E5C3B', borderWidth: 1,
          borderRadius: 6, yAxisID: 'y1',
        },
      ],
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { position: 'top' },
        // Phase 8: value label on the USD bars
        datalabels: {
          display: ctx => ctx.datasetIndex === 0 && ctx.parsed && ctx.parsed.y > 0,
          formatter: v => fmtUSD(v),
          anchor: 'end', align: 'end',
          color: '#4e3a13', font: { weight: 700, size: 10.5 },
          clamp: true,
        },
      },
      scales: {
        x: { grid: { display: false } },
        y: {
          position: 'left', grid: { color: 'rgba(90,74,40,.08)' },
          ticks: { callback: v => fmtUSD(v) },
          title: { display: true, text: 'USD' },
        },
        y1: {
          position: 'right', grid: { drawOnChartArea: false },
          title: { display: true, text: state.lang === 'vi' ? 'Tấn' : 'Tons' },
        },
      },
    },
  });
}

function renderCompareTable() {
  const tbody = document.getElementById('compare-body');
  if (!tbody) return;
  const years = [...new Set(getFilteredPeriods().map(p => p.slice(0, 4)))].sort();
  if (!years.length) return;
  const rows = years.map(y => {
    const totals = yearlyTotals(y);
    return {
      year: y,
      val: totals && totals.val,
      qty: totals && totals.qty,
      top: topMarketForYear(y),
    };
  });
  tbody.innerHTML = rows.map((r, i) => {
    const p = i > 0 ? rows[i - 1] : null;
    const dVal = p && r.val != null && p.val != null && p.val > 0 ? (r.val - p.val) / p.val * 100 : null;
    const dQty = p && r.qty != null && p.qty != null && p.qty > 0 ? (r.qty - p.qty) / p.qty * 100 : null;
    return `<tr>
      <td class="country">${r.year}</td>
      <td class="num">${fmtUSD(r.val)}</td>
      <td class="num">${deltaPill(dVal)}</td>
      <td class="num">${fmt(r.qty)}</td>
      <td class="num">${deltaPill(dQty)}</td>
      <td>${r.top ? `${esc(r.top.country)} <span style="color:var(--text-secondary)">(${fmtUSD(r.top.val)})</span>` : '—'}</td>
    </tr>`;
  }).join('');
}

function renderCompareMatrix() {
  const el = document.getElementById('compare-matrix');
  if (!el) return;
  const periods = getFilteredPeriods();
  const years = [...new Set(periods.map(p => p.slice(0, 4)))].sort();
  if (!years.length) { el.innerHTML = ''; return; }

  // Sum by year-quarter
  const cell = new Map(); // 'YYYY-Qn' -> val
  periods.forEach(p => {
    const y = p.slice(0, 4);
    const q = Math.floor((+p.slice(5, 7) - 1) / 3) + 1;
    const t = periodTotals(p);
    const k = `${y}-Q${q}`;
    if (!cell.has(k)) cell.set(k, t.val);
    else {
      const prior = cell.get(k);
      cell.set(k, prior == null || t.val == null ? null : prior + t.val);
    }
  });
  const maxVal = Math.max(...cell.values(), 1);

  let html = `<div class="mx-row mx-head"><div class="mx-year"></div>${[1, 2, 3, 4].map(q => `<div class="mx-cell mx-hcell">Q${q}</div>`).join('')}</div>`;
  years.forEach(y => {
    html += `<div class="mx-row"><div class="mx-year">${y}</div>${[1, 2, 3, 4].map(q => {
      const v = cell.get(`${y}-Q${q}`) || 0;
      const alpha = v ? (0.12 + 0.78 * Math.pow(v / maxVal, 0.6)) : 0.04;
      const color = v ? `rgba(201,162,39,${alpha.toFixed(2)})` : 'rgba(90,74,40,.04)';
      return `<div class="mx-cell" style="background:${color}" title="${y}-Q${q}: ${fmtUSD(v)}">${v ? fmtUSD(v) : '·'}</div>`;
    }).join('')}</div>`;
  });
  el.innerHTML = html;
}

// ── Tab: EXPORT ───────────────────────────────────────────────────────────────
function renderFileList() {
  const list = document.getElementById('file-list');
  const periods = Object.keys(state.periods).sort();
  if (!periods.length) {
    list.innerHTML = `<div class="empty-state"><div class="empty-icon">📂</div>
      <span>${state.lang === 'vi' ? 'Chưa có file nào' : 'No files yet'}</span></div>`;
    return;
  }
  list.innerHTML = periods.map(p => {
    const pd = state.periods[p];
    const nRows = (pd.countryRows || []).length + (pd.summaryRows || []).length;
    return `<div class="file-row">
      <span class="fr-ico">📄</span>
      <div>
        <div class="fr-name">${esc(pd.fileName || p)}</div>
        <div class="fr-meta">${p} · ${nRows} ${state.lang === 'vi' ? 'dòng' : 'rows'}${p === state.activePeriod ? (state.lang === 'vi' ? ' · đang chọn' : ' · active') : ''}</div>
      </div>
      <button class="fr-x" onclick="removePeriod('${p}')" title="Remove">✕</button>
    </div>`;
  }).join('');
}

// ── Export Kit — shared foundation for all 6 export formats (MASTER_PLAN_EXPORT_UX) ──
const EX_THEME = {
  deep: '17231F',   deepHex: '#17231F',
  gold: 'C9A227',   goldHex: '#C9A227', goldDark: '8A6D1C',
  cream: 'F5EBD0',  creamHex: '#F5EBD0',
  soft: 'F7EFD8',   softHex: '#F7EFD8',
  up: '3E7C4F', down: 'C0392B', flat: 'B3A782', muted: '8A7B5E',
  bg: 'FDFBF6', line: 'E3E8E4',
};
const EX_LABELS = (vi) => ({
  brand: 'DAN ON FOOD · TRADE EXPLORER',
  source: vi ? 'Nguồn: Tổng cục Hải quan Việt Nam (TCHQ) · customs.gov.vn'
             : 'Source: Vietnam General Department of Customs · customs.gov.vn',
  generated: vi ? 'Ngày tạo' : 'Generated',
  filtersLabel: vi ? 'Bộ lọc' : 'Filters',
  period: vi ? 'Kỳ' : 'Period',
  flowExport: vi ? 'Xuất khẩu' : 'Export',
  flowImport: vi ? 'Nhập khẩu' : 'Import',
  flowBalance: vi ? 'Cán cân XNK' : 'Trade balance',
  qtyMonth: vi ? 'Lượng tháng (Tấn)' : 'Monthly qty (Tons)',
  valMonth: vi ? 'Trị giá tháng (USD)' : 'Monthly value (USD)',
  qtyYtd: vi ? 'YTD Lượng (Tấn)' : 'YTD qty (Tons)',
  valYtd: vi ? 'YTD Trị giá (USD)' : 'YTD value (USD)',
  markets: vi ? 'Số thị trường' : 'Markets',
  top10: vi ? 'Top 10 thị trường' : 'Top 10 markets',
  trend: vi ? 'Xu hướng trị giá' : 'Value trend',
  yoy: vi ? 'So sánh theo năm' : 'Year-over-year comparison',
  regionShare: vi ? 'Thị phần theo khu vực' : 'Market share by region',
  balance: vi ? 'Cán cân thương mại (XK − NK)' : 'Trade balance (EX − IM)',
  country: vi ? 'Quốc gia' : 'Country',
  product: vi ? 'Mặt hàng' : 'Product',
  unit: vi ? 'ĐVT' : 'Unit',
  valShort: vi ? 'Trị giá' : 'Value',
  qtyShort: vi ? 'Lượng' : 'Qty',
  year: vi ? 'Năm' : 'Year',
  share: vi ? 'Thị phần' : 'Share',
  other: vi ? 'Khác' : 'Other',
  noData: vi ? 'Chưa có dữ liệu' : 'No data',
});
const EX_GRAN_LABEL = (g, vi) => ({ month: vi ? 'Tháng' : 'Month', quarter: vi ? 'Quý' : 'Quarter', year: vi ? 'Năm' : 'Year' }[g] || g);
const EX_FILE_FLOW = { export: 'xk', import: 'nk', balance: 'xnk' };
function exFileName(period, flow, ext) {
  return `${period}_cashew_${EX_FILE_FLOW[flow] || 'xk'}.${ext}`;
}
function exDeltaPct(cur, prev) {
  return (prev && prev > 0) ? (cur - prev) / prev * 100 : null;
}
// Rows of a period for a specific flow regardless of the current toggle
function exRowsForFlow(period, flow) {
  const prev = state.flow; state.flow = flow;
  try { return getFilteredRows(period).filter(isCashewRow); } finally { state.flow = prev; }
}
function exTotalsForFlow(period, flow) {
  const prev = state.flow; state.flow = flow;
  try { return periodTotals(period); } finally { state.flow = prev; }
}
function exFiltersStamp(vi) {
  const bits = [];
  if (state.filters.years.size) bits.push((vi ? 'Năm: ' : 'Years: ') + [...state.filters.years].sort().join(', '));
  if (state.filters.region) bits.push((vi ? 'Khu vực: ' : 'Region: ') + (REGION_LABELS[state.filters.region] ? REGION_LABELS[state.filters.region][vi ? 'vi' : 'en'] : state.filters.region));
  if (state.searchQuery) bits.push((vi ? 'Quốc gia: ' : 'Country: ') + state.searchQuery);
  bits.push((vi ? 'Chi tiết: ' : 'Granularity: ') + EX_GRAN_LABEL(state.filters.granularity, vi));
  return bits;
}
// Single source of truth for every export format
function collectExportPayload() {
  const vi = state.lang === 'vi';
  const period = state.activePeriod || 'unknown';
  const flow = state.flow || 'export';
  const pd = state.periods[period] || {};
  const rows = getFilteredRows(period).filter(isCashewRow);
  const rowsXk = exRowsForFlow(period, 'export');
  const rowsNk = exRowsForFlow(period, 'import');
  const sorted = [...rows].sort((a, b) => (b.value_month_usd || 0) - (a.value_month_usd || 0));
  const top10 = sorted.slice(0, 10);
  const totalVal = sorted.reduce((s, r) => s + (r.value_month_usd || 0), 0);
  const periods = getFilteredPeriods();
  const idx = periods.indexOf(period);
  const prevPeriod = idx > 0 ? periods[idx - 1] : null;
  const years = [...new Set(periods.map(p => p.slice(0, 4)))].sort().map(y => {
    const yr = periods.filter(p => p.startsWith(y)).flatMap(p => exRowsForFlow(p, flow)).filter(isCashewRow);
    return {
      year: y,
      val: yr.reduce((s, r) => s + (r.value_month_usd || 0), 0),
      qty: yr.reduce((s, r) => s + (r.quantity_month || 0), 0),
    };
  });
  const regionAgg = {};
  sorted.forEach(r => { const k = regionOf(r.country); regionAgg[k] = (regionAgg[k] || 0) + (r.value_month_usd || 0); });
  const regions = Object.entries(regionAgg)
    .map(([key, value]) => ({ key, value, label: (REGION_LABELS[key] || { vi: key, en: key })[vi ? 'vi' : 'en'] }))
    .sort((a, b) => b.value - a.value);
  const tb = (pd.tong_xk && pd.tong_nk
    && pd.tong_xk.value_month_usd != null && pd.tong_nk.value_month_usd != null)
    ? pd.tong_xk.value_month_usd - pd.tong_nk.value_month_usd : null;
  // Generate AI narrative for all exports
  const narJson = generateMarketNarrative({ vi, flow, period, totals: periodTotals(period), prevTotals: prevPeriod ? periodTotals(prevPeriod) : null, totalsXk: exTotalsForFlow(period, 'export'), totalsNk: exTotalsForFlow(period, 'import'), rows, prevPeriod });
  return {
    period, flow, vi, lang: state.lang,
    generatedAt: new Date(),
    labels: EX_LABELS(vi),
    source: state.dataSource === 'vinacas'
      ? (vi ? 'Nguồn: Vinacas — Nhập khẩu RCN (Raw Cashew Nut)' : 'Source: Vinacas — RCN imports')
      : EX_LABELS(vi).source,
    rows, rowsXk, rowsNk, sorted, top10, totalVal,
    totals: periodTotals(period),
    totalsXk: exTotalsForFlow(period, 'export'),
    totalsNk: exTotalsForFlow(period, 'import'),
    prevPeriod, prevTotals: prevPeriod ? periodTotals(prevPeriod) : null,
    years, series: aggregateSeries(periods), regions,
    tongXk: pd.tong_xk || null, tongNk: pd.tong_nk || null, tradeBalanceUsd: tb,
    filters: state.filters,
    filtersStamp: exFiltersStamp(vi),
    pd,
    aiAnalysis: narJson,
  };
}

// ══ Master Plan (docs/master_plan_export_layout_and_ai_analysis.md) ═══════════
// AI ANALYSIS ENGINE — Hybrid 2 tầng:
//   Tầng 1: generateMarketNarrative() → Smart Rule-Based, tức thì <5ms, offline-safe
//   Tầng 2: fetchLLMInsights()        → Local LLM (localhost:3000), chỉ chạy opt-in
const EX_AI_ENGINE = 'hybrid-smart-v1';
const EX_LLM_ENDPOINT = 'http://localhost:3000/v1/chat/completions';
const EX_LLM_MODEL = 'local-model';
const EX_LLM_TIMEOUT_MS = 45000;

function aiUnitPrice(val, qty) { return (val != null && qty > 0) ? val / qty : null; }
function aiPriceTxt(p, vi) {
  if (p == null || isNaN(p) || p <= 0) return vi ? 'chưa xác định' : 'n/a';
  return fmt(Math.round(p), 0) + ' USD/tấn';
}
function aiPctTxt(v, vi) {
  if (v == null || isNaN(v)) return vi ? '—' : 'n/a';
  return (v > 0 ? '+' : '') + v.toFixed(1).replace('.', vi ? ',' : '.') + '%';
}
// Lịch mùa vụ ngành điều Việt Nam (tham chiếu điều hành theo tháng dương lịch)
function aiSeasonNote(month, vi) {
  const s = vi ? {
    1: 'đầu vụ — đẩy mạnh thu mua RCN (Campuchia vào vụ) và duy trì shipment từ tồn kho nhân',
    2: 'cao điểm nhập RCN Campuchia — chuẩn bị công suất sấy, tách nhân cho vụ chính',
    3: 'vụ chính Campuchia dồn dập — ưu tiên đàm phán nguyên liệu và khóa giá bán kỳ hạn',
    4: 'thu hoạch điều vụ chính trong nước bắt đầu — theo dõi sát giá nguyên liệu nội địa',
    5: 'cao điểm sơ chế vụ mới — cơ hội chốt đơn giá XK trước khi nguồn cung tăng mạnh',
    6: 'cung nhân vụ mới tăng dần — đón đầu nhu cầu đặt hàng cho quý 3',
    7: 'bắt đầu mùa shipment mạnh của nhân điều — theo sát tiến độ container và tồn kho',
    8: 'cao điểm xuất khẩu nhân điều — ưu tiên điều phối logistik, tránh ùn ống cảng',
    9: 'tiếp tục đỉnh mùa vụ XK — chốt hợp đồng quý 4 với các thị trường lớn',
    10: 'cuối mùa vụ chính — chuyển trọng tâm sang tồn kho và hợp đồng RCN Tây Phi',
    11: 'mùa mua RCN Tây Phi — đánh giá lại tồn kho nhân cho giao dịch năm sau',
    12: 'cuối năm — tổng kết tồn kho, đàm phán hợp đồng năm mới và giữ nhịp giao hàng',
  } : {
    1: 'early crop — push RCN procurement (Cambodia entering harvest) and ship kernel stock',
    2: 'peak Cambodian RCN imports — prepare drying and shelling capacity for the main crop',
    3: 'intense Cambodian main crop — prioritise raw-material talks and forward price locks',
    4: 'domestic main-crop harvest begins — watch local raw cashew prices closely',
    5: 'peak processing of the new crop — lock export prices before supply expands',
    6: 'new-crop kernel supply rising — capture Q3 order demand early',
    7: 'kernel shipment season starts — track container schedules and inventory',
    8: 'kernel export peak — prioritise logistics coordination to avoid port congestion',
    9: 'export season still peaking — lock Q4 contracts with key markets',
    10: 'main season winding down — pivot to inventory and West-African RCN contracts',
    11: 'West-African RCN buying season — re-assess kernel inventory for next-year deals',
    12: 'year-end — close inventory review, negotiate new-year contracts, keep shipping cadence',
  };
  return s[month] || '';
}

// ── BƯỚC 1: Smart Rule-Based Analysis Engine — sinh 4 khối nhận định Executive ─
function generateMarketNarrative(P) {
  const vi = P.vi;
  const now = new Date();
  const t = P.totals || { qty: null, val: null, qtyY: null, valY: null };
  const pt = P.prevTotals || null;
  const momVal = exDeltaPct(t.val, pt && pt.val);
  const momQty = exDeltaPct(t.qty, pt && pt.qty);

  // YoY: cùng kỳ năm trước (period 'YYYY-MM')
  let yoyVal = null, yoyQty = null, yoyPeriod = null, yoyTotals = null;
  const mY = /^(\d{4})-(\d{2})$/.exec(P.period || '');
  if (mY) {
    yoyPeriod = (Number(mY[1]) - 1) + '-' + mY[2];
    if (state.periods[yoyPeriod]) {
      yoyTotals = periodTotals(yoyPeriod);
      yoyVal = exDeltaPct(t.val, yoyTotals && yoyTotals.val);
      yoyQty = exDeltaPct(t.qty, yoyTotals && yoyTotals.qty);
    }
  }

  const price = aiUnitPrice(t.val, t.qty);
  const pricePrev = aiUnitPrice(pt && pt.val, pt && pt.qty);
  const priceMom = (price != null && pricePrev) ? (price / pricePrev - 1) * 100 : null;
  const priceYoy = (price != null && yoyTotals) ? (price / (aiUnitPrice(yoyTotals.val, yoyTotals.qty) || NaN) - 1) * 100 : null;
  const priceXk = aiUnitPrice(P.totalsXk && P.totalsXk.val, P.totalsXk && P.totalsXk.qty);
  const priceNk = aiUnitPrice(P.totalsNk && P.totalsNk.val, P.totalsNk && P.totalsNk.qty);

  // Biến động theo thị trường (MoM, cùng bộ lọc đang bật)
  const prevBy = {};
  if (P.prevPeriod) {
    exRowsForFlow(P.prevPeriod, P.flow).filter(isCashewRow).forEach(r => { prevBy[(r.country || '').trim()] = r; });
  }
  const cRows = (P.rows || []).filter(isCountryRow);
  const totalCVal = cRows.reduce((s, r) => s + (r.value_month_usd || 0), 0);
  const deltas = cRows.map(r => {
    const c = (r.country || '').trim() || '?';
    const pr = prevBy[c];
    const cur = r.value_month_usd || 0;
    const pv = pr ? (pr.value_month_usd || 0) : null;
    return {
      country: c, val: cur, prev: pv,
      dVal: pv == null ? null : cur - pv,
      dPct: (pv != null && pv > 0) ? ((cur - pv) / pv) * 100 : null,
      share: totalCVal ? (cur / totalCVal) * 100 : 0,
      price: aiUnitPrice(r.value_month_usd, r.quantity_month),
    };
  });
  const gainers = deltas.filter(d => (d.dVal || 0) > 0).sort((a, b) => b.dVal - a.dVal).slice(0, 3);
  const losers = deltas.filter(d => (d.dVal || 0) < 0).sort((a, b) => a.dVal - b.dVal).slice(0, 3);
  const byVal = [...deltas].sort((a, b) => b.val - a.val);
  const top1 = byVal[0] || null;
  const top3Share = byVal.slice(0, 3).reduce((s, d) => s + d.share, 0);
  const totalCountryVal = deltas.reduce((s, d) => s + (d.val || 0), 0);

  // Chênh lệch đơn giá giữa các thị trường chủ lực (Mỹ / Trung Quốc / EU)
  const kmDefs = [
    { name: vi ? 'Mỹ' : 'US', re: /united states|(^|[^a-z])usa([^a-z]|$)/i },
    { name: vi ? 'Trung Quốc' : 'China', re: /china|trung qu/i },
    { name: vi ? 'EU (Hà Lan/Đức)' : 'EU (NL/DE)', re: /netherlands|ha lan|germany|(^|[^a-z])duc([^a-z]|$)/i },
  ];
  const keyPrices = [];
  kmDefs.forEach(km => {
    const hit = deltas.find(d => d.price && km.re.test(d.country || ''));
    if (hit) keyPrices.push({ name: km.name, price: hit.price });
  });
  let keyHigh = null, keyLow = null, keySpread = null;
  if (keyPrices.length >= 2) {
    const kp = [...keyPrices].sort((a, b) => a.price - b.price);
    keyLow = kp[0]; keyHigh = kp[kp.length - 1];
    keySpread = keyHigh.price - keyLow.price;
  }

  // ── Khối 1: Tóm tắt điều hành (Executive Summary) ──
  const flowL = P.flow === 'import' ? (vi ? 'nhập khẩu' : 'import')
    : P.flow === 'balance' ? (vi ? 'cán cân XNK' : 'trade balance') : (vi ? 'xuất khẩu' : 'export');
  let exec;
  if (t.val == null) {
    exec = vi
      ? `Chưa có số liệu tổng hợp cho kỳ ${P.period} (luồng ${flowL}). Hãy kiểm tra nguồn dữ liệu TCHQ/Vinacas hoặc bộ lọc đang bật.`
      : `No aggregated totals for ${P.period} (${flowL}). Check the TCHQ/Vinacas source or active filters.`;
  } else if (P.flow === 'balance') {
    exec = vi
      ? `Cán cân thương mại hạt điều kỳ ${P.period} đạt ${fmtUSD(t.val)} (XK − NK), tương đương ${fmt(t.qty)} tấn chênh lệch lượng. So với kỳ trước: ${aiPctTxt(momVal, vi)} trị giá; so với cùng kỳ năm trước: ${aiPctTxt(yoyVal, vi)}${yoyPeriod ? ` (kỳ ${yoyPeriod})` : ''}.`
      : `Cashew trade balance for ${P.period}: ${fmtUSD(t.val)} (EX − IM), equal to ${fmt(t.qty)} tons net volume. MoM ${aiPctTxt(momVal, vi)} by value; YoY ${aiPctTxt(yoyVal, vi)}${yoyPeriod ? ` (${yoyPeriod})` : ''}.`;
  } else {
    exec = vi
      ? `${flowL.charAt(0).toUpperCase() + flowL.slice(1)} hạt điều kỳ ${P.period} đạt ${fmtUSD(t.val)} với sản lượng ${fmt(t.qty)} tấn, đơn giá bình quân ${aiPriceTxt(price, vi)}. Tốc độ tăng MoM: ${aiPctTxt(momVal, vi)} trị giá / ${aiPctTxt(momQty, vi)} lượng; so với cùng kỳ năm trước: ${aiPctTxt(yoyVal, vi)}${yoyPeriod ? ` (kỳ ${yoyPeriod})` : ''}.`
      : `Cashew ${flowL} in ${P.period} reached ${fmtUSD(t.val)} at ${fmt(t.qty)} tons, averaging ${aiPriceTxt(price, vi)}. MoM: ${aiPctTxt(momVal, vi)} value / ${aiPctTxt(momQty, vi)} volume; YoY: ${aiPctTxt(yoyVal, vi)}${yoyPeriod ? ` (${yoyPeriod})` : ''}.`;
  }

  // ── Khối 2: Động lực thị trường & Biến động nổi bật ──
  const drivers = [];
  if (gainers.length) {
    drivers.push(vi
      ? `Thị trường bứt phá: ${gainers.map(g => `${g.country} ${fmtUSD(g.dVal)} (${aiPctTxt(g.dPct, vi)})`).join('; ')}.`
      : `Breakout markets: ${gainers.map(g => `${g.country} ${fmtUSD(g.dVal)} (${aiPctTxt(g.dPct, vi)})`).join('; ')}.`);
  } else {
    drivers.push(vi ? 'Không có thị trường nào tăng trưởng nổi bật so với kỳ trước.' : 'No notable market growth versus the previous period.');
  }
  if (losers.length) {
    drivers.push(vi
      ? `Suy giảm đáng chú ý: ${losers.map(g => `${g.country} ${fmtUSD(g.dVal)} (${aiPctTxt(g.dPct, vi)})`).join('; ')}.`
      : `Notable declines: ${losers.map(g => `${g.country} ${fmtUSD(g.dVal)} (${aiPctTxt(g.dPct, vi)})`).join('; ')}.`);
  }
  if (top1) {
    drivers.push(vi
      ? `${top1.country} dẫn đầu với ${top1.share.toFixed(1)}% tổng trị giá; Top 3 chiếm ${top3Share.toFixed(1)}% — ${top3Share > 60 ? 'mức phụ thuộc cao, cần theo dõi và đa dạng hóa' : 'cơ cấu thị trường ở mức khá cân đối'}.`
      : `${top1.country} leads with ${top1.share.toFixed(1)}% of total value; top 3 hold ${top3Share.toFixed(1)}% — ${top3Share > 60 ? 'high dependency, monitor and diversify' : 'a fairly balanced market mix'}.`);
  }

  // ── Khối 3: Cảnh báo giá & Biên độ ──
  const priceBits = [vi
    ? `Đơn giá bình quân ${aiPriceTxt(price, vi)} (${aiPctTxt(priceMom, vi)} MoM, ${aiPctTxt(priceYoy, vi)} YoY).`
    : `Average price ${aiPriceTxt(price, vi)} (${aiPctTxt(priceMom, vi)} MoM, ${aiPctTxt(priceYoy, vi)} YoY).`];
  if (keySpread != null) {
    priceBits.push(vi
      ? `Chênh lệch đơn giá giữa ${keyHigh.name} (${aiPriceTxt(keyHigh.price, vi)}) và ${keyLow.name} (${aiPriceTxt(keyLow.price, vi)}) đạt ${fmt(Math.round(keySpread), 0)} USD/tấn.`
      : `Price gap between ${keyHigh.name} (${aiPriceTxt(keyHigh.price, vi)}) and ${keyLow.name} (${aiPriceTxt(keyLow.price, vi)}) is ${fmt(Math.round(keySpread), 0)} USD/ton.`);
  }
  if (priceXk && priceNk) {
    priceBits.push(vi
      ? `So sánh 2 luồng: đơn giá XK ${aiPriceTxt(priceXk, vi)} đối với NK ${aiPriceTxt(priceNk, vi)}.`
      : `Flow comparison: export price ${aiPriceTxt(priceXk, vi)} vs import price ${aiPriceTxt(priceNk, vi)}.`);
  }
  const priceAlerts = priceBits.join(' ');

  // ── Khối 4: Khuyến nghị & Triển vọng mùa vụ ──
  const mNum = mY ? Number(mY[2]) : (now.getMonth() + 1);
  const recs = [vi
    ? `Mùa vụ (tháng ${mNum}): ${aiSeasonNote(mNum, vi) || 'duy trì nhịp giao hàng và theo dõi giá nguyên liệu'}.`
    : `Season (month ${mNum}): ${aiSeasonNote(mNum, vi) || 'keep the shipment cadence and monitor raw-cashew prices'}.`];
  if (gainers.length) {
    recs.push(vi
      ? `Ưu tiên duy trì đà tăng tại ${gainers[0].country}: chốt lịch giao hàng và mở rộng đơn hàng tiếp theo.`
      : `Sustain momentum in ${gainers[0].country}: lock delivery schedules and expand the next order.`);
  } else if (losers.length) {
    recs.push(vi
      ? `Rà soát nguyên nhân suy giảm tại ${losers[0].country}: giá cạnh tranh, tiến độ giao hàng hay nhu cầu nội tại thị trường.`
      : `Review causes of decline in ${losers[0].country}: price competitiveness, delivery schedule or local demand.`);
  }
  if (top3Share > 60) {
    recs.push(vi ? 'Giảm rủi ro phụ thuộc: phát triển thêm 1–2 thị trường mới ngoài nhóm Top 3 hiện tại.' : 'Reduce dependency risk: develop 1–2 new markets beyond the current top 3.');
  }
  if (priceMom != null && priceMom < -3) {
    recs.push(vi ? 'Đơn giá đang hạ nhiệt — cân nhắc chốt hợp đồng kỳ hạn để bảo vệ biên lợi nhuận.' : 'Prices are cooling — consider forward contracts to protect margins.');
  } else if (priceMom != null && priceMom > 3) {
    recs.push(vi ? 'Đơn giá đang tăng nhanh — có thể tung hàng theo từng đợt để tối ưu doanh thu.' : 'Prices are rising fast — consider staged releases to optimise revenue.');
  }
  if (recs.length < 3) {
    recs.push(vi ? 'Duy trì đối soát chéo TCHQ–Vinacas định kỳ để phát hiện sai lệch số liệu sớm.' : 'Keep cross-checking TCHQ vs Vinacas data regularly to catch discrepancies early.');
  }

  return {
    engine: EX_AI_ENGINE,
    generated_at: now.toISOString(),
    lang: vi ? 'vi' : 'en',
    period: P.period, flow: P.flow,
    executive_summary: exec,
    market_drivers: drivers,
    price_alerts: priceAlerts,
    recommendations: recs,
    stats: {
      val: t.val, qty: t.qty, price, momVal, momQty,
      yoyVal, yoyQty, yoyPeriod, priceXk, priceNk,
      totalCountryVal, top1Share: top1 ? top1.share : null, top3Share,
      keySpread, keyHigh: keyHigh ? keyHigh.name : null, keyLow: keyLow ? keyLow.name : null,
      gainers: gainers.map(g => ({ country: g.country, dVal: g.dVal, dPct: g.dPct })),
      losers: losers.map(g => ({ country: g.country, dVal: g.dVal, dPct: g.dPct })),
    },
  };
}

// Nhãn 4 khối nhận định chuẩn Executive (dùng chung HTML/PDF/PPTX/Excel)
const EX_AI_BLOCKS = (vi) => ([
  { key: 'executive_summary', icon: '🧭', title: vi ? 'Tóm tắt điều hành' : 'Executive Summary' },
  { key: 'market_drivers', icon: '🚀', title: vi ? 'Động lực thị trường & Biến động nổi bật' : 'Market Drivers & Notable Moves' },
  { key: 'price_alerts', icon: '⚖️', title: vi ? 'Cảnh báo giá & Biên độ' : 'Price & Margin Alerts' },
  { key: 'recommendations', icon: '🌱', title: vi ? 'Khuyến nghị & Triển vọng mùa vụ' : 'Outlook & Actionable Insights' },
]);

// ── BƯỚC 2: Local LLM client (Tầng 2, opt-in) — http://localhost:3000/v1/... ───
function exLLMSystemPrompt(vi) {
  return vi
    ? 'Bạn là chuyên gia phân tích thị trường xuất nhập khẩu hạt điều Việt Nam (nguồn TCHQ và Vinacas). Hãy viết văn phong báo cáo điều hành: súc tích, chuyên sâu, tiếng Việt đầy đủ dấu. TUYỆT ĐỐI chỉ dùng các số liệu được cung cấp trong đề bài — không tự bịa thêm số liệu. Trả về DUY NHẤT một đối tượng JSON hợp lệ theo schema: {"executive_summary": string, "market_drivers": string[], "price_alerts": string, "recommendations": string[]}. Mỗi phần tử mảng là 1 câu ngắn dưới 220 ký tự.'
    : 'You are a Vietnam cashew import/export market analyst (TCHQ and Vinacas sources). Write concise, executive-grade English. Use ONLY the figures provided in the prompt — never invent numbers. Return EXACTLY ONE valid JSON object with schema: {"executive_summary": string, "market_drivers": string[], "price_alerts": string, "recommendations": string[]}. Each array item is one sentence under 220 characters.';
}
function exLLMUserPrompt(P, base) {
  const vi = P.vi;
  const s = (base && base.stats) || {};
  const lines = [
    `Kỳ/Period: ${P.period} · Luồng/Flow: ${P.flow}`,
    `Tổng trị giá/Total value: ${fmtUSD(s.val)} · Sản lượng/Volume: ${fmt(s.qty)} tấn · Đơn giá BQ/Avg price: ${aiPriceTxt(s.price, vi)}`,
    `MoM trị giá/value: ${aiPctTxt(s.momVal, vi)} · MoM lượng/volume: ${aiPctTxt(s.momQty, vi)}`,
    `YoY trị giá/value (vs ${s.yoyPeriod || 'n/a'}): ${aiPctTxt(s.yoyVal, vi)}`,
    `Đơn giá XK/Export price: ${aiPriceTxt(s.priceXk, vi)} · Đơn giá NK/Import price: ${aiPriceTxt(s.priceNk, vi)}`,
    `Top 1 tỷ trọng/share: ${s.top1Share == null ? 'n/a' : s.top1Share.toFixed(1) + '%'} · Top 3: ${s.top3Share == null ? 'n/a' : s.top3Share.toFixed(1) + '%'}`,
    s.keySpread != null
      ? `Chênh lệch giá/gap ${s.keyHigh} vs ${s.keyLow}: ${fmt(Math.round(s.keySpread), 0)} USD/tấn`
      : 'Không có dữ liệu chênh lệch giá key markets / no key-market price gap',
    `Top tăng/gainers: ${(s.gainers || []).map(g => `${g.country} +${fmtUSD(g.dVal)}`).join(', ') || 'n/a'}`,
    `Top giảm/losers: ${(s.losers || []).map(g => `${g.country} ${fmtUSD(g.dVal)}`).join(', ') || 'n/a'}`,
  ];
  return 'Dữ liệu số liệu chính thức (bắt buộc dùng đúng các con số này):\n' + lines.join('\n') +
    '\n\nHãy viết 4 khối nhận định điều hành theo schema JSON đã định (executive_summary, market_drivers, price_alerts, recommendations).';
}
// Ghép kết quả LLM lên baseline rule-based — thiếu trường nào giữ trường đó (fallback an toàn)
function parseLLMNarrativeJSON(raw, baseline) {
  let txt = String(raw || '');
  const fence = /```(?:json)?\s*([\s\S]*?)```/i.exec(txt);
  if (fence) txt = fence[1];
  const a = txt.indexOf('{'), b = txt.lastIndexOf('}');
  if (a === -1 || b <= a) return baseline;
  let obj;
  try { obj = JSON.parse(txt.slice(a, b + 1)); } catch (e) { return baseline; }
  const asArr = (v) => Array.isArray(v) ? v.map(x => String(x)).filter(Boolean)
    : (v ? String(v).split(/\n+/).map(x => x.replace(/^[-•*]\s*/, '').trim()).filter(Boolean) : []);
  const out = { ...baseline };
  if (typeof obj.executive_summary === 'string' && obj.executive_summary.trim().length > 20) out.executive_summary = obj.executive_summary.trim();
  const md = asArr(obj.market_drivers); if (md.length) out.market_drivers = md;
  if (typeof obj.price_alerts === 'string' && obj.price_alerts.trim().length > 10) out.price_alerts = obj.price_alerts.trim();
  const rec = asArr(obj.recommendations); if (rec.length) out.recommendations = rec;
  out.engine = 'local-llm+' + EX_AI_ENGINE;
  out.llm_endpoint = EX_LLM_ENDPOINT;
  return out;
}
async function fetchLLMInsights(P, opts = {}) {
  const baseline = generateMarketNarrative(P);
  const controller = (typeof AbortController !== 'undefined') ? new AbortController() : null;
  const timer = controller ? setTimeout(() => controller.abort(), opts.timeoutMs || EX_LLM_TIMEOUT_MS) : null;
  try {
    const resp = await fetch(opts.endpoint || EX_LLM_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: opts.model || EX_LLM_MODEL,
        temperature: 0.35,
        messages: [
          { role: 'system', content: exLLMSystemPrompt(P.vi) },
          { role: 'user', content: exLLMUserPrompt(P, baseline) },
        ],
      }),
      signal: controller ? controller.signal : undefined,
    });
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const data = await resp.json();
    const content = (data && data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) || '';
    if (!String(content).trim()) throw new Error('empty completion');
    return parseLLMNarrativeJSON(content, baseline);
  } finally { if (timer) clearTimeout(timer); }
}
// Chart → PNG data-URI (empty string when Chart.js CDN unavailable)
function exCaptureChart(config, w = 860, h = 400) {
  if (typeof Chart === 'undefined') return '';
  return captureChart(config, w, h);
}
// Busy state on the clicked export card: spinner + ignore double clicks
function exCardBusy(cardId, fn) {
  const card = document.getElementById(cardId);
  if (card && card.dataset.busy === '1') return;
  const done = () => {
    if (card) { card.dataset.busy = ''; card.classList.remove('is-busy'); card.removeAttribute('aria-busy'); }
  };
  const fail = (err) => {
    done();
    showToast((state.lang === 'vi' ? 'Lỗi xuất file: ' : 'Export error: ') + err.message, 'error');
    console.error(err);
  };
  if (card) { card.dataset.busy = '1'; card.classList.add('is-busy'); card.setAttribute('aria-busy', 'true'); }
  let result;
  try { result = fn(); }
  catch (err) { fail(err); return; }
  if (result && typeof result.then === 'function') result.then(done, fail);
  else done();
}
function exToastOk(label, blob) {
  const size = blob && blob.size ? ` · ${(blob.size / 1024).toFixed(0)} KB` : '';
  showToast(`${label} ✓${size}`, 'success');
}

// ════════════════════════════════════════════════════════════════════════════════
// PHASE 0 — FOUNDATION: Industry Knowledge Base + Quality Gates + Design Tokens
// ════════════════════════════════════════════════════════════════════════════════

// ── Industry Knowledge Base (dùng chung cho TẤT CẢ export formats) ──────────────
