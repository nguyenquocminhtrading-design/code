  NLD:'europe', DEU:'europe', GBR:'europe', FRA:'europe', ITA:'europe',
  ESP:'europe', BEL:'europe', GRC:'europe', RUS:'europe', UKR:'europe',
  LTU:'europe', NOR:'europe', SWE:'europe', CHE:'europe', DNK:'europe',
  FIN:'europe', IRL:'europe', POL:'europe', CZE:'europe', ROU:'europe',
  BGR:'europe', HUN:'europe', TUR:'europe',
