// Logo (jpg → dataURL) dùng chung cho PDF/PPTX/Excel/HTML; '' khi offline/file://
let _exLogoCache = null;
async function exLogoDataUrl() {
  if (_exLogoCache !== null) return _exLogoCache;
  try {
    const resp = await fetch(EX_TEMPLATES.logoPath);
    if (!resp.ok) throw new Error('HTTP ' + resp.status);
    const blob = await resp.blob();
    _exLogoCache = await new Promise((resolve, reject) => {
      const fr = new FileReader();
      fr.onload = () => resolve(fr.result);
      fr.onerror = reject;
      fr.readAsDataURL(blob);
    });
  } catch (err) {
    console.warn('[export] logo unavailable:', err.message);
    _exLogoCache = '';
  }
  return _exLogoCache;
}
// Sync access cho template sync (HTML report) — trả '' nếu chưa load
function exLogoSync() {
  return (typeof _exLogoCache === 'string' && _exLogoCache) ? _exLogoCache : '';
}

// ── Export functions ──────────────────────────────────────────────────────────

function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

// ── Phase 4 (Export UX): JSON pipeline-schema → re-loadable by drag & drop ────
function exportJSON() {
  if (!state.activePeriod) { showToast(state.lang === 'vi' ? 'Chưa có dữ liệu' : 'No data', 'error'); return; }
  // ── Phase 0: Quality Gates ──
  const P = collectExportPayload();
  const qc = runQualityChecks(P);
  if (!qc.passed) {
    showToast(state.lang === 'vi'
      ? `Xuất JSON bị chặn: ${qc.errors.join('; ')}`
      : `JSON export blocked: ${qc.errors.join('; ')}`, 'error');
    return;
  }
  if (qc.warnings.length) {
    showToast(state.lang === 'vi'
      ? `Cảnh báo chất lượng: ${qc.warnings.join('; ')}`
      : `Quality warnings: ${qc.warnings.join('; ')}`, 'warning');
  }
  exCardBusy('ex-json', () => {
    const mapRow = (r) => ({
      country: r.country || '', product: r.product || '', unit: r.unit || '',
      cy_luong: r.quantity_month ?? null, cy_tri_gia: r.value_month_usd ?? null,
      ytd_luong: r.quantity_ytd ?? null, ytd_tri_gia: r.value_ytd_usd ?? null,
      version: r.version || '', version_key: r.version_key || '',
      debug_source_file: r.debug_source_file || '', debug_source_type: r.debug_source_type || '',
      debug_source_note: r.debug_source_note || '',
    });
    const deriveTong = (tt) => (tt && (tt.qty || tt.val)) ? {
      product: 'Hạt điều', unit: 'Tấn',
      quantity_month: tt.qty || null, value_month_usd: tt.val || null,
      quantity_ytd: tt.qtyY || null, value_ytd_usd: tt.valY || null,
    } : null;
    const tongXk = P.tongXk || deriveTong(P.totalsXk);
    const tongNk = P.tongNk || deriveTong(P.totalsNk);
    const tradeBalance = P.tradeBalanceUsd != null ? P.tradeBalanceUsd
      : (tongXk && tongNk && tongXk.value_month_usd != null && tongNk.value_month_usd != null
        ? tongXk.value_month_usd - tongNk.value_month_usd : null);
    const item = {
      period: P.period,
      tong_xk: tongXk, tong_nk: tongNk, trade_balance_usd: tradeBalance,
      xk_theo_nuoc: P.rowsXk.map(mapRow),
      nk_theo_nuoc: P.rowsNk.map(mapRow),
      versions: [],
    };
    // Master Plan AI: ai_analysis block (hybrid-smart-v1 schema) - using payload AI data
    const narJson = P.aiAnalysis || generateMarketNarrative(P);
    const aiAnalysis = {
      engine: narJson.engine,
      generated_at: narJson.generated_at,
      executive_summary: narJson.executive_summary,
      market_drivers: narJson.market_drivers,
      price_alerts: narJson.price_alerts,
      recommendations: narJson.recommendations,
    };
    const payload = {
      schema_version: 1,   // Phase C (P0): hợp đồng dữ liệu JSON
      year: Number(P.period.slice(0, 4)),
      generated_at: P.generatedAt.toISOString(),
      periods: { [P.period]: { ...item, ai_analysis: aiAnalysis } },
      _export_meta: {
        exported_from: 'DAN ON FOOD Trade Explorer',
        flow: P.flow, filters: P.filtersStamp, source: P.source,
        ai_engine: narJson.engine,
      },
    };
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    downloadBlob(blob, exFileName(P.period, P.flow, 'json'));
    exToastOk('JSON ✓', blob);
  });
}

// ── Phase 1 (Export UX): Excel 5-sheet styled workbook via ExcelJS ────────────
function exportExcel() {
  if (!state.activePeriod) { showToast(state.lang === 'vi' ? 'Chưa có dữ liệu' : 'No data', 'error'); return; }
  if (typeof ExcelJS === 'undefined') {
    showToast(state.lang === 'vi' ? 'ExcelJS (CDN) chưa tải — kiểm tra kết nối mạng' : 'ExcelJS (CDN) not loaded — check connection', 'error');
    return;
  }
  exCardBusy('ex-excel', async () => {
    const P = collectExportPayload();
    // ── Phase 0: Quality Gates ──
    const qc = runQualityChecks(P);
    if (!qc.passed) {
      showToast(state.lang === 'vi'
        ? `Xuất Excel bị chặn: ${qc.errors.join('; ')}`
        : `Excel export blocked: ${qc.errors.join('; ')}`, 'error');
      return;
    }
    if (qc.warnings.length) {
      showToast(state.lang === 'vi'
        ? `Cảnh báo chất lượng: ${qc.warnings.join('; ')}`
        : `Quality warnings: ${qc.warnings.join('; ')}`, 'warning');
    }
    const L = P.labels;
    const FLOW = P.flow === 'import' ? L.flowImport : P.flow === 'balance' ? L.flowBalance : L.flowExport;
    const wb = new ExcelJS.Workbook();
    wb.creator = 'DAN ON FOOD · Trade Explorer';
    wb.created = P.generatedAt;
    // Phase C: logo banner theo EX_TEMPLATES
    const logoData = EX_TEMPLATES.excel.logoInBanner ? await exLogoDataUrl() : '';

    const argb = (hex) => 'FF' + hex;
    const fill = (hex) => ({ type: 'pattern', pattern: 'solid', fgColor: { argb: argb(hex) } });
    const thin = { style: 'thin', color: { argb: argb(EX_THEME.line) } };
    const headFont = { bold: true, color: { argb: argb(EX_THEME.cream) }, size: 10 };
    const numFmt = '#,##0';
    const deltaOf = (cur, prev) => {
      const d = exDeltaPct(cur, prev);
      if (d == null) return { t: '—', hex: EX_THEME.muted };
      return { t: (d > 0 ? '▲ +' : d < 0 ? '▼ ' : '• ') + d.toFixed(1) + '%', hex: d > 0.05 ? EX_THEME.up : d < -0.05 ? EX_THEME.down : EX_THEME.muted };
    };
    const styleHeader = (ws, rowIdx, ncols) => {
      const row = ws.getRow(rowIdx);
      for (let c = 1; c <= ncols; c++) {
        const cell = row.getCell(c);
        cell.fill = fill(EX_THEME.deep); cell.font = headFont;
        cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
        cell.border = thin;
      }
      row.height = 22;
    };
    const autoWidth = (ws, minW = 9, maxW = 38) => {
      ws.columns.forEach(col => {
        let w = minW;
        col.eachCell({ includeEmpty: false }, c => { w = Math.max(w, String(c.value ?? '').length + 3); });
        col.width = Math.min(w, maxW);
      });
    };

    // ══ Sheet 1: Tong_Quan — brand banner + KPI + tổng hợp 2 luồng ══════════
    const ws1 = wb.addWorksheet('Tong_Quan', { views: [{ state: 'frozen', ySplit: 4 }] });
    ws1.mergeCells('A1:E1');
    const brand = ws1.getCell('A1');
    brand.value = '🌰 DAN ON FOOD · TRADE EXPLORER';
    brand.fill = fill(EX_THEME.deep);
    brand.font = { bold: true, color: { argb: argb(EX_THEME.gold) }, size: 14 };
    brand.alignment = { vertical: 'middle', horizontal: 'left', indent: 1 };
    ws1.getRow(1).height = 30;
    if (logoData) {
      const ext = logoData.startsWith('data:image/png') ? 'png' : 'jpeg';
      const imgId = wb.addImage({ base64: logoData.slice(logoData.indexOf(',') + 1), extension: ext });
      ws1.addImage(imgId, { tl: { col: 4.45, row: 0.06 }, ext: { width: 34, height: 34 } });
    }
    ws1.mergeCells('A2:E2');
    const t2 = ws1.getCell('A2');
    t2.value = `${FLOW} Hạt điều Việt Nam · ${L.period} ${P.period}`;
    t2.font = { bold: true, color: { argb: argb(EX_THEME.goldDark) }, size: 12 };
    t2.alignment = { vertical: 'middle', horizontal: 'left', indent: 1 };
    ws1.mergeCells('A3:E3');
    const t3 = ws1.getCell('A3');
    t3.value = `${P.source}  ·  ${L.generated}: ${P.generatedAt.toLocaleString(P.vi ? 'vi-VN' : 'en-US')}` +
      (P.filtersStamp.length ? `  ·  ${P.filtersStamp.join(' · ')}` : '');
    t3.font = { color: { argb: argb(EX_THEME.muted) }, size: 9 };
    t3.alignment = { vertical: 'middle', horizontal: 'left', indent: 1, wrapText: true };
    ws1.getRow(3).height = 24;

    // Master Plan AI: Bình Luận Điều Hành & Phân Tích Xu Hướng (Rows 5–14) - using payload AI data
    const narExcel = P.aiAnalysis || generateMarketNarrative(P);
    const blocksExcel = EX_AI_BLOCKS(P.vi);
    const aiCommentRow = 5;
    ws1.mergeCells('A5:E5');
    const aiTitleCell = ws1.getCell('A5');
    aiTitleCell.value = P.vi ? '🧠 BÌNH LUẬN ĐIỀU HÀNH & PHÂN TÍCH XU HƯỚNG' : '🧠 EXECUTIVE COMMENTARY & TREND ANALYSIS';
    aiTitleCell.font = { bold: true, color: { argb: argb(EX_THEME.goldDark) }, size: 11 };
    aiTitleCell.alignment = { vertical: 'middle', horizontal: 'left', indent: 1 };
    ws1.getRow(5).height = 28;
    const aiBodyRows = [];
    for (let i = 0; i < blocksExcel.length; i++) {
      const b = blocksExcel[i];
      const val = narExcel[b.key];
      aiBodyRows.push({ title: b.title, text: (Array.isArray(val) ? val.join('; ') : String(val || '')) });
    }
    let curRow = 6;
    const aiSoftFill = fill('FBF8F0');
    const goldBorder = { top: { style: 'double', color: { argb: argb(EX_THEME.gold) } }, bottom: { style: 'double', color: { argb: argb(EX_THEME.gold) } }, left: { style: 'thin', color: { argb: argb(EX_THEME.gold) } }, right: { style: 'thin', color: { argb: argb(EX_THEME.gold) } } };
    for (const blk of aiBodyRows) {
      ws1.mergeCells('A' + curRow + ':E' + curRow);
      const titleC = ws1.getCell('A' + curRow);
      titleC.value = blk.title;
      titleC.font = { bold: true, color: { argb: argb(EX_THEME.deep) }, size: 10 };
      titleC.fill = aiSoftFill;
      titleC.alignment = { vertical: 'middle', horizontal: 'left', indent: 1 };
      titleC.border = goldBorder;
      ws1.getRow(curRow).height = 20;
      curRow++;
      ws1.mergeCells('A' + curRow + ':E' + curRow);
      const bodyC = ws1.getCell('A' + curRow);
      bodyC.value = blk.text;
      bodyC.fill = aiSoftFill;
      bodyC.font = { size: 9, color: { argb: argb(EX_THEME.deep) } };
      bodyC.alignment = { vertical: 'top', horizontal: 'left', indent: 1, wrapText: true };
      bodyC.border = goldBorder;
      const approxLines = Math.max(1, Math.ceil(blk.text.length / 90));
      ws1.getRow(curRow).height = Math.min(70, Math.max(24, approxLines * 14 + 10));
      curRow++;
    }
    // Now start KPI table at row 16
    const kpiStartRow = curRow;
    ws1.getRow(kpiStartRow).values = [P.vi ? 'Chỉ số' : 'Metric', P.vi ? 'Tháng này' : 'Current', P.vi ? 'Kỳ trước' : 'Previous', 'Δ%'];
    styleHeader(ws1, kpiStartRow, 4);
    const kpiRows = [
      [L.qtyMonth, P.totals.qty, P.prevTotals ? P.prevTotals.qty : null],
      [L.valMonth, P.totals.val, P.prevTotals ? P.prevTotals.val : null],
      [L.qtyYtd, P.totals.qtyY, null],
      [L.valYtd, P.totals.valY, null],
      [L.markets, P.rows.length, null],
    ];
    if (P.tradeBalanceUsd != null) kpiRows.push([L.balance, P.tradeBalanceUsd, null]);
    kpiRows.forEach((kr, i) => {
      const r = ws1.getRow(kpiStartRow + 1 + i);
      const d = deltaOf(kr[1], kr[2]);
      r.values = [kr[0], kr[1] ?? 0, kr[2] ?? '—', d.t];
      r.getCell(1).font = { bold: true, color: { argb: argb(EX_THEME.deep) }, size: 10 };
      for (const c of [2, 3]) { r.getCell(c).numFmt = numFmt; r.getCell(c).alignment = { horizontal: 'right' }; }
      r.getCell(4).font = { bold: true, color: { argb: argb(d.hex) }, size: 10 };
      r.getCell(4).alignment = { horizontal: 'right' };
      if (i % 2 === 1) for (let c = 1; c <= 4; c++) r.getCell(c).fill = fill(EX_THEME.soft);
      for (let c = 1; c <= 4; c++) r.getCell(c).border = thin;
    });

    // Flow summary block (XK / NK / balance)
    const kpiEnd = kpiStartRow + kpiRows.length;
    const secRow = ws1.getRow(kpiEnd + 2);
    secRow.getCell(1).value = P.vi ? 'Tổng hợp 2 luồng' : 'Flow summary';
    secRow.getCell(1).font = { bold: true, color: { argb: argb(EX_THEME.goldDark) }, size: 12 };
    const hdr2 = ws1.getRow(kpiEnd + 3);
    hdr2.values = [P.vi ? 'Luồng' : 'Flow', L.qtyMonth, L.valMonth, L.qtyYtd, L.valYtd];
    styleHeader(ws1, kpiEnd + 3, 5);
    for (let c = 1; c <= 5; c++) hdr2.getCell(c).fill = fill(EX_THEME.gold);
    const flowRow = (rIdx, label, tt) => {
      const r = ws1.getRow(rIdx);
      r.values = [label, tt.qty || 0, tt.val || 0, tt.qtyY || 0, tt.valY || 0];
      r.getCell(1).font = { bold: true, color: { argb: argb(EX_THEME.deep) }, size: 10 };
      for (let c = 2; c <= 5; c++) { r.getCell(c).numFmt = numFmt; r.getCell(c).alignment = { horizontal: 'right' }; }
      for (let c = 1; c <= 5; c++) r.getCell(c).border = thin;
    };
    let fr = kpiEnd + 4;
    flowRow(fr++, L.flowExport, P.totalsXk);
    flowRow(fr++, L.flowImport, P.totalsNk);
    if (P.totalsXk && P.totalsNk) {
      flowRow(fr++, L.balance, {
        qty: (P.totalsXk.qty || 0) - (P.totalsNk.qty || 0),
        val: (P.totalsXk.val || 0) - (P.totalsNk.val || 0),
        qtyY: (P.totalsXk.qtyY || 0) - (P.totalsNk.qtyY || 0),
        valY: (P.totalsXk.valY || 0) - (P.totalsNk.valY || 0),
      });
    }
    [24, 18, 18, 18, 18].forEach((w, i) => { ws1.getColumn(i + 1).width = w; });

    // ══ Sheets 2 & 3: country tables (XK + NK) ══════════════════════════════
    const countrySheet = (name, rows, emptyNote) => {
      const ws = wb.addWorksheet(name, { views: [{ state: 'frozen', ySplit: 1 }] });
      const headers = [L.country, L.product, L.unit, `CY ${L.qtyShort} (Tấn)`, `CY ${L.valShort} (USD)`, `YTD ${L.qtyShort} (Tấn)`, `YTD ${L.valShort} (USD)`];
      ws.getRow(1).values = headers;
      styleHeader(ws, 1, headers.length);
      const sorted = [...rows].sort((a, b) => (b.value_month_usd || 0) - (a.value_month_usd || 0));
      if (!sorted.length) {
        ws.mergeCells(2, 1, 2, headers.length);
        const c = ws.getCell(2, 1);
        c.value = emptyNote; c.font = { italic: true, color: { argb: argb(EX_THEME.muted) } };
        c.alignment = { horizontal: 'center' };
        ws.getColumn(1).width = 60;
        return;
      }
      sorted.forEach((r0, i) => {
        const r = ws.getRow(i + 2);
        r.values = [r0.country || '', r0.product || '', r0.unit || '', r0.quantity_month ?? '', r0.value_month_usd ?? '', r0.quantity_ytd ?? '', r0.value_ytd_usd ?? ''];
        for (const c of [4, 5, 6, 7]) { r.getCell(c).numFmt = numFmt; r.getCell(c).alignment = { horizontal: 'right' }; }
        r.getCell(1).font = { bold: true, color: { argb: argb(EX_THEME.deep) }, size: 10 };
        if (i % 2 === 1) for (let c = 1; c <= headers.length; c++) r.getCell(c).fill = fill(EX_THEME.soft);
        for (let c = 1; c <= headers.length; c++) r.getCell(c).border = thin;
      });
      autoWidth(ws);
    };
    if (EX_TEMPLATES.excel.sheets.includes('xk_theo_nuoc')) {
      countrySheet('XK_Theo_Nuoc', P.rowsXk, P.vi ? 'Chưa có dữ liệu xuất khẩu cho kỳ này.' : 'No export data for this period.');
    }
    if (EX_TEMPLATES.excel.sheets.includes('nk_theo_nuoc')) {
      countrySheet('NK_Theo_Nuoc', P.rowsNk, P.vi ? 'Chưa có dữ liệu nhập khẩu cho kỳ này.' : 'No import data for this period.');
    }

    // ══ Sheet 4: Bieu_Do — chart PNGs captured from the dashboard ═══════════
    if (EX_TEMPLATES.excel.sheets.includes('bieu_do')) {
    const ws4 = wb.addWorksheet('Bieu_Do', { views: [{ showGridLines: false }] });
    const charts = [];
    if (P.top10.length) charts.push(exCaptureChart({
      type: 'bar',
      data: { labels: P.top10.map(r => r.country || '?'), datasets: [{ label: L.valShort, data: P.top10.map(r => r.value_month_usd || 0), backgroundColor: 'rgba(201,162,39,.82)', borderColor: '#8A6D1C', borderWidth: 1, borderRadius: 6 }] },
      options: { indexAxis: 'y', plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { ticks: { callback: v => fmtUSD(v), font: { size: 10 } } }, y: { ticks: { font: { size: 11 } } } } },
    }, 880, 420));
    if (P.series.length) charts.push(exCaptureChart({
      type: 'line',
      data: { labels: P.series.map(s => s.label), datasets: [{ label: L.valShort, data: P.series.map(s => s.val), borderColor: '#C9A227', backgroundColor: 'rgba(201,162,39,.14)', fill: true, tension: .35, pointRadius: P.series.length > 30 ? 0 : 3 }] },
      options: { plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { ticks: { maxTicksLimit: 12, maxRotation: 0, font: { size: 10 } } }, y: { ticks: { callback: v => fmtUSD(v), font: { size: 10 } } } } },
    }, 880, 420));
    if (P.years.length) charts.push(exCaptureChart({
      type: 'bar',
      data: {
        labels: P.years.map(r => r.year),
        datasets: [
          { label: L.valShort, data: P.years.map(r => r.val), backgroundColor: 'rgba(201,162,39,.82)', borderColor: '#8A6D1C', borderWidth: 1, borderRadius: 6 },
          { label: L.qtyShort, data: P.years.map(r => r.qty), backgroundColor: 'rgba(62,124,79,.55)', borderColor: '#2E5C3B', borderWidth: 1, borderRadius: 6 },
        ],
      },
      options: { plugins: { legend: { position: 'top' }, tooltip: { enabled: false } }, scales: { y: { ticks: { callback: v => fmtUSD(v), font: { size: 10 } } } } },
    }, 880, 420));
    if (charts.length) {
      charts.forEach((dataUrl, i) => {
        const id = wb.addImage({ base64: dataUrl.slice('data:image/png;base64,'.length), extension: 'png' });
        ws4.addImage(id, { tl: { col: 1, row: 1 + i * 22 }, ext: { width: 880, height: 420 } });
      });
    } else {
      ws4.getCell('B2').value = P.vi ? '(Chart.js CDN chưa tải — không chèn được biểu đồ)' : '(Chart.js CDN unavailable — no charts embedded)';
    }
    ws4.getColumn(1).width = 4;
    } // — end EX_TEMPLATES.excel.sheets 'bieu_do'

    // ══ Sheet 5: _Meta ══════════════════════════════════════════════════════
    if (EX_TEMPLATES.excel.sheets.includes('_meta')) {
    const ws5 = wb.addWorksheet('_Meta');
    ws5.getRow(1).values = ['Key', 'Value'];
    styleHeader(ws5, 1, 2);
    [
      ['period', P.period], ['flow', P.flow], ['generated_at', P.generatedAt.toISOString()],
      ['rows_current_flow', P.rows.length], ['rows_export', P.rowsXk.length], ['rows_import', P.rowsNk.length],
      ['trade_balance_usd', P.tradeBalanceUsd ?? ''],
      ['filters', P.filtersStamp.join(' | ') || 'none'],
      ['source', P.source], ['app', 'DAN ON FOOD Trade Explorer · Export Kit'],
      ['ai_engine', 'hybrid-smart-v1'],
      ['ai_generated_at', narExcel.generated_at],
      ['ai_integrity_fingerprint', P.rows.length + '|' + P.rowsXk.length + '|' + P.rowsNk.length + '|' + (P.tradeBalanceUsd ?? '')],
    ].forEach((kv, i) => {
      const r = ws5.getRow(i + 2);
      r.values = kv;
      r.getCell(1).font = { bold: true, color: { argb: argb(EX_THEME.deep) }, size: 10 };
      r.getCell(1).border = thin; r.getCell(2).border = thin;
    });
    ws5.getColumn(1).width = 20; ws5.getColumn(2).width = 70;
    } // — end EX_TEMPLATES.excel.sheets '_meta'

    // Print setup cho sheet Tổng quan (EX_TEMPLATES.excel.printArea)
    if (EX_TEMPLATES.excel.printArea) {
      ws1.pageSetup = { orientation: 'landscape', fitToPage: true, fitToWidth: 1, fitToHeight: 0 };
    }

    const buf = await wb.xlsx.writeBuffer();
    const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
    downloadBlob(blob, exFileName(P.period, P.flow, 'xlsx'));
    exToastOk('Excel ✓', blob);
  });
}

// ── Phase 4 (Export UX): CSV follows the active flow (XK/NK) + filters ────────
function exportCSV() {
  if (!state.activePeriod) { showToast(state.lang === 'vi' ? 'Chưa có dữ liệu' : 'No data', 'error'); return; }
  exCardBusy('ex-csv', () => {
    const P = collectExportPayload();
    // ── Phase 0: Quality Gates ──
    const qc = runQualityChecks(P);
    if (!qc.passed) {
      showToast(state.lang === 'vi'
        ? `Xuất CSV bị chặn: ${qc.errors.join('; ')}`
        : `CSV export blocked: ${qc.errors.join('; ')}`, 'error');
      return;
    }
    if (qc.warnings.length) {
      showToast(state.lang === 'vi'
        ? `Cảnh báo chất lượng: ${qc.warnings.join('; ')}`
        : `Quality warnings: ${qc.warnings.join('; ')}`, 'warning');
    }
    const headers = ['country', 'product', 'unit', 'quantity_month', 'value_month_usd', 'quantity_ytd', 'value_ytd_usd'];
    const rows = P.rows; // current-flow, filter-aware (collectExportPayload)
    const line = (arr) => arr.map(v => {
      const s = String(v ?? '');
      return /[",;\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
    }).join(',');
    const csv = '\uFEFF' + [line(headers), ...rows.map(r => line(headers.map(h => r[h])))].join('\r\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
    downloadBlob(blob, exFileName(P.period, P.flow, 'csv'));
    exToastOk('CSV ✓', blob);
  });
}

// ── Phase 9: Unified self-contained HTML report (print→PDF · ?slides=1) ───────
function captureChart(config, w = 860, h = 400) {
  // Render a Chart.js config to a detached canvas → PNG data URI (0 dependencies in output file)
  const canvas = document.createElement('canvas');
  canvas.width = w; canvas.height = h;
  const merged = { ...config, options: { ...(config.options || {}), responsive: false, animation: false, events: [], devicePixelRatio: 2 } };
  if (typeof Chart === 'undefined') return '';
  const chart = safeChart(canvas, merged);
  const url = canvas.toDataURL('image/png');
  chart.destroy();
  return url;
}

function exportHTMLReport() {
  if (!state.activePeriod) { showToast(state.lang === 'vi' ? 'Chưa có dữ liệu' : 'No data', 'error'); return; }
  // ── Phase 0: Quality Gates ──
  const P = collectExportPayload();
  const qc = runQualityChecks(P);
  if (!qc.passed) {
    showToast(state.lang === 'vi'
      ? `Xuất HTML bị chặn: ${qc.errors.join('; ')}`
      : `HTML export blocked: ${qc.errors.join('; ')}`, 'error');
    return;
  }
  if (qc.warnings.length) {
    showToast(state.lang === 'vi'
      ? `Cảnh báo chất lượng: ${qc.warnings.join('; ')}`
      : `Quality warnings: ${qc.warnings.join('; ')}`, 'warning');
  }
  exCardBusy('ex-html', () => {
    showLoading(state.lang === 'vi' ? 'Đang tạo báo cáo HTML…' : 'Building HTML report…');
    try {
      const html = buildReportHTML();
      const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
      downloadBlob(blob, exFileName(state.activePeriod, state.flow, 'html'));
      showToast(state.lang === 'vi' ? 'Báo cáo HTML ✓ (Ctrl+P để in PDF · thêm ?slides=1 vào URL để trình chiếu)' : 'HTML report ✓ (Ctrl+P to print · add ?slides=1 for slides)', 'success');
    } finally { hideLoading(); }
  });
}

function buildReportHTML() {
  const vi = state.lang === 'vi';
  const flowLabel = state.flow === 'import' ? (vi ? 'Nhập khẩu' : 'Import')
    : state.flow === 'balance' ? (vi ? 'Cán cân XNK' : 'Trade balance') : (vi ? 'Xuất khẩu' : 'Export');
  const T = {
    title: vi ? `Báo cáo ${flowLabel} Hạt điều` : `Cashew ${flowLabel} Report`,
    source: vi ? 'Nguồn: Tổng cục Hải quan Việt Nam (TCHQ) · customs.gov.vn' : 'Source: Vietnam General Department of Customs · customs.gov.vn',
    kpi: vi ? 'Chỉ số kỳ báo cáo' : 'Reporting-period KPIs',
    compareTitle: vi ? 'So sánh theo năm' : 'Year-over-year comparison',
    topTitle: vi ? 'Top 10 thị trường' : 'Top 10 markets',
    trendTitle: vi ? 'Xu hướng trị giá' : 'Value trend',
    detailTitle: vi ? `Chi tiết ${flowLabel.toLowerCase()} theo quốc gia` : `${flowLabel} detail by country`,
    country: vi ? 'Quốc gia' : 'Country', product: vi ? 'Mặt hàng' : 'Product', unit: vi ? 'ĐVT' : 'Unit',
    qty: vi ? 'CY Lượng (Tấn)' : 'CY Qty (Tons)', val: vi ? 'CY Trị giá (USD)' : 'CY Value (USD)',
    qtyY: vi ? 'YTD Lượng (Tấn)' : 'YTD Qty (Tons)', valY: vi ? 'YTD Trị giá (USD)' : 'YTD Value (USD)',
    year: vi ? 'Năm' : 'Year', share: vi ? 'Thị phần' : 'Share',
    filtersLabel: vi ? 'Bộ lọc' : 'Filters',
    period: vi ? 'Kỳ' : 'Period',
    generated: vi ? 'Ngày tạo' : 'Generated',
  };
  const period = state.activePeriod;
  const t = periodTotals(period);
  const rows = getFilteredRows(period).filter(isCashewRow)
    .sort((a, b) => (b.value_month_usd || 0) - (a.value_month_usd || 0));
  // Phase 11: top-10 chỉ tính quốc gia thật (loại dòng "Other" của Excel)
  const countryRowsRep = rows.filter(isCountryRow);
  const totalVal = Number.isFinite(t.val) ? t.val : 0;

  const periods = getFilteredPeriods();
  const idx = periods.indexOf(period);
  const prevPeriod = idx > 0 ? periods[idx - 1] : null;
  const prevT = prevPeriod ? periodTotals(prevPeriod) : null;
  const dPct = (c, p) => (c != null && p != null && p > 0) ? (c - p) / p * 100 : null;
  const kpis = [
    { l: T.qty, v: fmt(t.qty), d: dPct(t.qty, prevT && prevT.qty) },
    { l: T.val, v: fmtUSD(t.val), d: dPct(t.val, prevT && prevT.val) },
    { l: T.valY, v: fmtUSD(t.valY), d: null },
    { l: vi ? 'Số thị trường' : 'Markets', v: rows.length ? String(countryRowsRep.length) : '—', d: null },
  ];

  const years = [...new Set(periods.map(p => p.slice(0, 4)))].sort();
  const yearRows = years.map(y => {
    const totals = yearlyTotals(y);
    return {
      year: y,
      val: totals && totals.val,
      qty: totals && totals.qty,
    };
  });
  const yearBarImg = captureChart({
    type: 'bar',
    data: {
      labels: yearRows.map(r => r.year),
      datasets: [
        { label: T.val, data: yearRows.map(r => r.val), backgroundColor: 'rgba(201,162,39,.82)', borderColor: '#8A6D1C', borderWidth: 1, borderRadius: 6 },
        { label: T.qty, data: yearRows.map(r => r.qty), backgroundColor: 'rgba(62,124,79,.55)', borderColor: '#2E5C3B', borderWidth: 1, borderRadius: 6 },
      ],
    },
    options: { plugins: { legend: { position: 'top' }, tooltip: { enabled: false } }, scales: { y: { ticks: { callback: v => fmtUSD(v), font: { size: 10 } } }, x: { ticks: { font: { size: 12 } } } } },
  });
  const pillHTML = (pct) => pct == null ? '<span class="pill flat">—</span>'
    : pct > 0.05 ? `<span class="pill up">▲ +${pct.toFixed(1)}%</span>`
    : pct < -0.05 ? `<span class="pill down">▼ ${pct.toFixed(1)}%</span>`
    : '<span class="pill flat">• 0%</span>';
  const yearTableRows = yearRows.map((r, i) => {
    const p = i > 0 ? yearRows[i - 1] : null;
    const dV = p && p.val > 0 ? (r.val - p.val) / p.val * 100 : null;
    const dQ = p && p.qty > 0 ? (r.qty - p.qty) / p.qty * 100 : null;
    return `<tr><td class="b">${r.year}</td><td class="num">${fmtUSD(r.val)}</td><td class="num">${pillHTML(dV)}</td><td class="num">${fmt(r.qty)}</td><td class="num">${pillHTML(dQ)}</td></tr>`;
  }).join('');

  const top10 = countryRowsRep.slice(0, 10);
  const topImg = captureChart({
    type: 'bar',
    data: {
      labels: top10.map(r => r.country || '?'),
      datasets: [{ label: T.val, data: top10.map(r => r.value_month_usd || 0), backgroundColor: 'rgba(201,162,39,.82)', borderColor: '#8A6D1C', borderWidth: 1, borderRadius: 6 }],
    },
    options: { indexAxis: 'y', plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { ticks: { callback: v => fmtUSD(v), font: { size: 10 } } }, y: { ticks: { font: { size: 11 } } } } },
  });

  const series = aggregateSeries(periods);
  const trendImg = captureChart({
    type: 'line',
    data: {
      labels: series.map(s => s.label),
      datasets: [{ label: T.val, data: series.map(s => s.val), borderColor: '#C9A227', backgroundColor: 'rgba(201,162,39,.14)', fill: true, tension: .35, pointRadius: series.length > 30 ? 0 : 3 }],
    },
    options: { plugins: { legend: { display: false }, tooltip: { enabled: false } }, scales: { x: { ticks: { maxTicksLimit: 12, maxRotation: 0, font: { size: 10 } } }, y: { ticks: { callback: v => fmtUSD(v), font: { size: 10 } } } } },
  });

  const detailRows = rows.map(r => `<tr>
      <td class="b">${esc(r.country) || '—'}</td><td>${esc(r.product) || '—'}</td><td>${esc(r.unit) || '—'}</td>
      <td class="num">${fmt(r.quantity_month)}</td><td class="num">${fmtUSD(r.value_month_usd)}</td>
      <td class="num">${fmt(r.quantity_ytd)}</td><td class="num">${fmtUSD(r.value_ytd_usd)}</td>
    </tr>`).join('');

  const filterBits = [];
  if (state.filters.years.size) filterBits.push((vi ? 'Năm: ' : 'Years: ') + [...state.filters.years].sort().join(', '));
  if (state.filters.region) filterBits.push((vi ? 'Khu vực: ' : 'Region: ') + (REGION_LABELS[state.filters.region] ? REGION_LABELS[state.filters.region][vi ? 'vi' : 'en'] : state.filters.region));
  if (state.searchQuery) filterBits.push((vi ? 'Quốc gia: ' : 'Country: ') + state.searchQuery);
  filterBits.push((vi ? 'Chi tiết: ' : 'Granularity: ') + { month: vi ? 'Tháng' : 'Month', quarter: vi ? 'Quý' : 'Quarter', year: vi ? 'Năm' : 'Year' }[state.filters.granularity]);

  // Phase C: section on/off theo EX_TEMPLATES.html + logo cover (sync từ cache)
  const S = EX_TEMPLATES.html.sections;
  const showYoy = S.includes('yoy'), showTop = S.includes('top10'), showTrend = S.includes('trend');
  const showDetail = S.includes('detail'), showFooter = S.includes('footer');
  const showAi = S.includes('ai');
  const coverLogoImg = (EX_TEMPLATES.html.logoInCover && exLogoSync())
    ? `<img class="cover-logo" src="${exLogoSync()}" alt="DAN ON FOOD"/>` : '';
  return `<!DOCTYPE html>
<html lang="${vi ? 'vi' : 'en'}">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>${T.title} · ${period}</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family:'Segoe UI',system-ui,-apple-system,sans-serif; color:#17211d; background:#f6f7f5; font-size:14px; line-height:1.55; }
  .wrap { max-width: 960px; margin: 0 auto; padding: 32px 28px 64px; }
  .cover { background:#17231f; color:#F5EBD0; border-radius:16px; padding:36px 40px; margin-bottom:24px; }
  .cover .brand { color:#C9A227; font-size:11px; font-weight:800; letter-spacing:2px; text-transform:uppercase; margin-bottom:10px; }
  .cover h1 { font-size:26px; font-weight:800; line-height:1.2; }
  .cover h1 span { color:#C9A227; }
  .cover .meta { margin-top:14px; font-size:12.5px; color:#D4C89A; line-height:1.8; }
  .rep-sec { background:#fff; border:1px solid #e3e8e4; border-radius:12px; padding:22px 24px; margin-bottom:18px; box-shadow:0 2px 10px rgba(23,33,29,.05); }
  .rep-sec h2 { font-size:16px; color:#4e3a13; margin-bottom:14px; padding-bottom:8px; border-bottom:2px solid #EAD8A7; }
  .kpi-row { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
  .kpi { background:#FBF5E6; border:1px solid #EAD8A7; border-radius:10px; padding:14px 16px; }
  .kpi .l { font-size:10.5px; font-weight:700; color:#8A7B5E; text-transform:uppercase; letter-spacing:.4px; }
  .kpi .v { font-size:20px; font-weight:800; color:#4e3a13; margin-top:3px; }
  .kpi .d { font-size:11px; font-weight:800; margin-top:3px; }
  .d.up { color:#3E7C4F; } .d.down { color:#C0392B; } .d.flat { color:#B3A782; }
  img.chart { width:100%; height:auto; border:1px solid #eee; border-radius:8px; }
  table { width:100%; border-collapse:collapse; font-size:12.5px; }
  th { background:#F7F9F7; color:#4e3a13; text-align:left; padding:9px 12px; border-bottom:2px solid #EAD8A7; font-size:11px; text-transform:uppercase; letter-spacing:.4px; }
  td { padding:8px 12px; border-bottom:1px solid #F0EDE2; }
  tr:last-child td { border-bottom:none; }
  td.num, th.num { text-align:right; font-variant-numeric:tabular-nums; }
  td.b { font-weight:700; }
  .pill { display:inline-block; border-radius:99px; padding:2px 9px; font-size:11px; font-weight:700; }
  .pill.up { background:#E4F0E6; color:#3E7C4F; } .pill.down { background:#F9E5E2; color:#C0392B; } .pill.flat { background:#FBF5E6; color:#8A6D1C; }
  .foot { text-align:center; font-size:11px; color:#8A7B5E; margin-top:26px; line-height:1.8; }
  .fb-chip { display:inline-block; background:#FBF5E6; border:1px solid #EAD8A7; color:#4e3a13; border-radius:99px; padding:3px 12px; font-size:11.5px; font-weight:600; margin:2px 4px 2px 0; }
  body.slides { background:#17231f; }
  body.slides .wrap { max-width:none; padding:0; }
  body.slides .cover, body.slides .rep-sec { display:none; border-radius:0; margin:0; min-height:100vh; padding:60px 8vw; scroll-snap-align:start; }
  body.slides .cover { display:flex; flex-direction:column; justify-content:center; }
  body.slides .cur { display:block !important; }
  body.slides .rep-sec.cur { display:flex; flex-direction:column; justify-content:center; }
  .slide-nav { position:fixed; bottom:18px; right:18px; z-index:99; display:none; gap:8px; }
  body.slides .slide-nav { display:flex; }
  .slide-nav button { border:1px solid #C9A227; background:rgba(23,35,31,.9); color:#F5EBD0; border-radius:8px; padding:8px 14px; font-size:14px; cursor:pointer; }
  .slide-hint { position:fixed; bottom:18px; left:18px; color:#8A7B5E; font-size:11px; display:none; z-index:99; }
  body.slides .slide-hint { display:block; }
  @media print {
    body { background:#fff; font-size:12px; }
    .wrap { max-width:100%; padding:0; }
    .cover { border-radius:0; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
    .rep-sec { box-shadow:none; page-break-inside:avoid; }
    .rep-sec.page-break { page-break-before:always; }
    .slide-nav, .slide-hint { display:none !important; }
    @page { size:A4; margin:14mm; }
  }
  @media (max-width:720px) { .kpi-row { grid-template-columns:1fr 1fr; } .cover { padding:24px; } }
  .cover-logo { width: 60px; height: 60px; border-radius: 12px; object-fit: cover; margin-bottom: 14px; border: 1px solid rgba(245,235,208,.35); }
  .ai-sec { background: linear-gradient(135deg, rgba(245,235,208,0.08), rgba(201,162,39,0.06)), #FBF8F0; border: 1.5px solid #C9A227; }
  .ai-head { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
  .ai-badge { display:inline-block; background:#C9A227; color:#17231F; font-size:10.5px; font-weight:800; letter-spacing:1.2px; border-radius:99px; padding:4px 12px; }
  .ai-engine { font-size:11px; color:#8A7B5E; margin-left:10px; white-space:nowrap; }
  .ai-btn { border:1.5px solid #C9A227; background:#17231F; color:#F5EBD0; border-radius:8px; padding:7px 14px; font-size:12.5px; font-weight:700; cursor:pointer; transition:background .2s,transform .1s; }
  .ai-btn:hover:not(:disabled) { background:#2E3F37; transform:translateY(-1px); }
  .ai-btn:disabled { opacity:.55; cursor:wait; }
  .ai-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .ai-block { background:rgba(245,235,208,0.08); border:1px solid rgba(201,162,39,.45); border-radius:10px; padding:12px 14px; }
  .ai-block.wide { grid-column:1 / -1; }
  .ai-bt { font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.6px; color:#8A6D1C; margin-bottom:6px; }
  .ai-bb p { margin:0; font-size:13px; line-height:1.6; color:#3A3226; }
  .ai-bb ul { margin:0; padding-left:18px; } .ai-bb li { font-size:12.5px; line-height:1.55; margin:3px 0; color:#3A3226; }
  .ai-note { margin-top:10px; font-size:11.5px; color:#8A6D1C; min-height:14px; }
  .ai-slide-title { display:none; }
  body.slides .ai-grid { grid-template-columns:1fr; }
  body.slides .ai-bb li { font-size:20px; line-height:1.7; }
  body.slides .ai-bb p { font-size:20px; }
  body.slides .ai-slide-title { display:block; font-size:30px; color:#F5EBD0; margin-bottom:18px; font-weight:800; }
  @media print { .ai-btn { display:none; } }
  @media (max-width:720px) { .ai-grid { grid-template-columns:1fr; } .ai-head { flex-direction:column; align-items:flex-start; } }
</style>
</head>
<body>
<div class="wrap">
  <div class="cover" id="sec-cover">
    ${coverLogoImg}
    <div class="brand">DAN ON FOOD · TRADE EXPLORER</div>
    <h1>${T.title} <span>${esc(period)}</span></h1>
    <div class="meta">
      ${T.source}<br/>
      ${T.generated}: ${new Date().toLocaleString(vi ? 'vi-VN' : 'en-US')}<br/>
      ${T.filtersLabel}: ${filterBits.map(b => `<span class="fb-chip">${esc(b)}</span>`).join('')}
    </div>
  </div>

  <div class="rep-sec" id="sec-kpi">
    <h2>${T.kpi} · ${T.period} ${esc(period)}${prevPeriod ? ` <span style="color:#8A7B5E;font-weight:500;font-size:12px">(vs ${esc(prevPeriod)})</span>` : ''}</h2>
    <div class="kpi-row">
      ${kpis.map(k => `<div class="kpi"><div class="l">${k.l}</div><div class="v">${k.v}</div><div class="d ${k.d == null ? 'flat' : k.d > 0 ? 'up' : k.d < 0 ? 'down' : 'flat'}">${k.d == null ? '—' : (k.d > 0 ? '▲ +' : k.d < 0 ? '▼ ' : '• ') + k.d.toFixed(1) + '%'}</div></div>`).join('')}
    </div>
  </div>

  ${showAi ? (() => {
    const nar = generateMarketNarrative({ vi, flow: state.flow, period, totals: periodTotals(period), prevTotals: prevT, totalsXk: { val: yearRows.length ? years.reduce((s,y)=>{const yr=periods.filter(p=>p.startsWith(y)).flatMap(p=>getFilteredRows(p)).filter(isCashewRow).reduce((a,r)=>a+(r.value_month_usd||0),0);return s+y;} ,0):null, qty: 0 }, totalsNk: null, rows: rows, prevPeriod });
    const blocks = EX_AI_BLOCKS(vi);
    return `
  <div class="rep-sec page-break ai-sec" id="sec-ai">
    <div class="ai-head">
      <div>
        <span class="ai-badge">✨ AI MARKET INSIGHTS</span>
        <span class="ai-engine" id="ai-engine-tag">${esc(nar.engine)} · ${esc(nar.generated_at)}</span>
      </div>
      <button class="ai-btn" id="ai-refresh" type="button">${vi ? '✨ Phân tích lại bằng AI (Local LLM)' : '✨ Re-analyze with AI (Local LLM)'}</button>
    </div>
    <div class="ai-slide-title">Nhận định điều hành & Động lực thị trường</div>
    <div class="ai-grid" id="ai-narrative">${blocks.map(b => {
      const val = nar[b.key], isArr = Array.isArray(val);
      const body = isArr ? '<ul>'+val.map(s => '<li>'+esc(s)+'</li>').join('')+'</ul>' : '<p>'+esc(val)+'</p>';
      return `<div class="ai-block${b.key === 'executive_summary' ? ' wide' : ''}"><div class="ai-bt">${b.icon} ${esc(b.title)}</div><div class="ai-bb">${body}</div></div>`;
    }).join('')}</div>
    <div class="ai-note" id="ai-note"></div>
    <script type="application/json" id="ai-ctx">${exAICtxJSON(nar, vi)}</script>
  </div>`;
  })() : ''}

  ${showYoy ? `
  <div class="rep-sec page-break" id="sec-compare">
    <h2>${T.compareTitle}</h2>
    <img class="chart" src="${yearBarImg}" alt="YoY chart"/>
    <table style="margin-top:14px">
      <thead><tr><th>${T.year}</th><th class="num">${T.val}</th><th class="num">Δ%</th><th class="num">${T.qty}</th><th class="num">Δ%</th></tr></thead>
      <tbody>${yearTableRows}</tbody>
    </table>
  </div>` : ''}

  ${showTop ? `
  <div class="rep-sec page-break" id="sec-top">
    <h2>${T.topTitle} · ${T.period} ${esc(period)}</h2>
    <img class="chart" src="${topImg}" alt="Top 10 chart"/>
    <table style="margin-top:14px">
      <thead><tr><th>#</th><th>${T.country}</th><th class="num">${T.val}</th><th class="num">${T.share}</th></tr></thead>
      <tbody>${top10.map((r, i) => `<tr><td class="num">${i + 1}</td><td class="b">${esc(r.country) || '—'}</td><td class="num">${fmtUSD(r.value_month_usd)}</td><td class="num">${(totalVal ? (r.value_month_usd || 0) / totalVal * 100 : 0).toFixed(1)}%</td></tr>`).join('')}</tbody>
    </table>
  </div>` : ''}

  ${showTrend ? `
  <div class="rep-sec page-break" id="sec-trend">
    <h2>${T.trendTitle}</h2>
    <img class="chart" src="${trendImg}" alt="Trend chart"/>
  </div>` : ''}

  ${showDetail ? `
  <div class="rep-sec page-break" id="sec-detail">
    <h2>${T.detailTitle} · ${T.period} ${esc(period)}</h2>
    <table>
      <thead><tr><th>${T.country}</th><th>${T.product}</th><th>${T.unit}</th><th class="num">${T.qty}</th><th class="num">${T.val}</th><th class="num">${T.qtyY}</th><th class="num">${T.valY}</th></tr></thead>
      <tbody>${detailRows}</tbody>
    </table>
  </div>` : ''}

  ${showFooter ? `
  <div class="foot">
    DAN ON FOOD · Trade Explorer — ${T.source}<br/>
    ${T.generated}: ${new Date().toLocaleString(vi ? 'vi-VN' : 'en-US')} · ${T.period}: ${esc(period)}
  </div>` : ''}
</div>
<div class="slide-nav">
  <button onclick="slNav(-1)">&#9664;</button>
  <button onclick="slNav(1)">&#9654;</button>
</div>
<div class="slide-hint">&#8592; &#8594; / Space &#183; Esc = exit</div>
<script>
(function () {
  var sections, cur = 0;
  function initSlides() {
    if (!/[?&]slides=1/.test(location.search)) return;
    document.body.classList.add('slides');
    sections = [].slice.call(document.querySelectorAll('.cover, .rep-sec'));
    cur = 0; show();
  }
  function show() {
    sections.forEach(function (s, i) { s.classList.toggle('cur', i === cur); });
  }
  window.slNav = function (d) {
    if (!sections) return;
    cur = Math.min(sections.length - 1, Math.max(0, cur + d));
    show();
  };
  document.addEventListener('keydown', function (e) {
    if (!document.body.classList.contains('slides')) return;
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') { e.preventDefault(); slNav(1); }
    else if (e.key === 'ArrowLeft' || e.key === 'PageUp') { e.preventDefault(); slNav(-1); }
    else if (e.key === 'Escape') { location.href = location.pathname; }
  });
  initSlides();
})();

// ── Master Plan AI: Report Self-Refresh Script ─────────────────────
(function() {
  var ctxEl = document.getElementById('ai-ctx');
  if (!ctxEl) return;
  var ctx = null;
  try { ctx = JSON.parse(ctxEl.textContent); } catch(e) { return; }
  window.__AI_CTX__ = ctx;

  function esc(s) { return String(s).replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>').replace(/"/g,'&quot;'); }
  function parseLLMNarrativeJSON(raw, baseline) {
    var txt = String(raw || '');
    var fence = /\`\`\`(?:json)?\s*([\s\S]*?)\`\`\`/i.exec(txt);
    if (fence) txt = fence[1];
    var a = txt.indexOf('{'), b = txt.lastIndexOf('}');
    if (a < 0 || b <= a) return baseline;
    var obj;
    try { obj = JSON.parse(txt.slice(a, b + 1)); } catch(e) { return baseline; }
    var asArr = function(v) {
      return Array.isArray(v) ? v.map(function(x){return String(x)}).filter(Boolean)
        : (v ? String(v).split(/\n+/).map(function(s){return s.replace(/^[-•*\s]/,'').trim()}).filter(Boolean) : []);
    };
    var out = {};
    for (var k in baseline) { out[k] = baseline[k]; }
    if (typeof obj.executive_summary === 'string' && obj.executive_summary.trim().length > 20) out.executive_summary = obj.executive_summary.trim();
    var md = asArr(obj.market_drivers); if (md.length) out.market_drivers = md;
    if (typeof obj.price_alerts === 'string' && obj.price_alerts.trim().length > 10) out.price_alerts = obj.price_alerts.trim();
    var rec = asArr(obj.recommendations); if (rec.length) out.recommendations = rec;
    out.engine = 'local-llm';
    return out;
  }
  function buildNarHTML(nar, blocks) {
    var h = '';
    for (var i = 0; i < blocks.length; i++) {
      var b = blocks[i], val = nar[b.key], isArr = Array.isArray(val);
      var body = '';
      if (isArr) { body = '<ul>'; for (var j = 0; j < val.length; j++) body += '<li>' + esc(val[j]) + '</li>'; body += '</ul>'; }
      else { body = '<p>' + esc(val) + '</p>'; }
      h += '<div class="ai-block' + (b.key === 'executive_summary' ? ' wide' : '') + '"><div class="ai-bt">' + esc(b.icon) + ' ' + esc(b.title) + '</div><div class="ai-bb">' + body + '</div></div>';
    }
    return h;
  }
  function updateNarrative(nar) {
    var grid = document.getElementById('ai-narrative');
    var tag = document.getElementById('ai-engine-tag');
    var note = document.getElementById('ai-note');
    if (!grid) return;
    var blocks = window.__AI_BLOCKS__ || [];
    grid.innerHTML = buildNarHTML(nar, blocks);
    if (tag) tag.textContent = (nar.engine || '') + ' · ' + (nar.generated_at || '');
    if (note) note.textContent = '';
  }
  document.addEventListener('DOMContentLoaded', function() {
    var btn = document.getElementById('ai-refresh');
    var note = document.getElementById('ai-note');
    if (!btn || !ctx) return;
    window.__AI_BLOCKS__ = ctx.blocks;
    btn.addEventListener('click', function() {
      btn.disabled = true;
      btn.textContent = ctx.labels.refetching || '⏳ …';
      if (note) note.textContent = '';
      var payload = JSON.stringify({ stats: ctx.baseline.stats });
      fetch(ctx.endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ model: ctx.model, temperature: 0.35, messages: [{ role: 'system', content: ctx.system }, { role: 'user', content: ctx.user + '\n\n' + payload }] })
      }).then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
      }).then(function(data) {
        var content = (data.choices && data.choices[0] && data.choices[0].message && data.choices[0].message.content) || '';
        var nar = parseLLMNarrativeJSON(content, ctx.baseline);
        updateNarrative(nar);
        if (note) note.textContent = ctx.labels.ok || '✓ 已更新';
      }).catch(function(err) {
        if (note) note.textContent = (ctx.labels.failPrefix || '⚠ 调用失败 — ') + err.message;
      }).finally(function() {
        btn.disabled = false;
        btn.textContent = ctx.labels.refresh || '✨ 重新分析';
      });
    });
  });
})();

// ── AI Context Embed for HTML Reports ───────────────────────
function exAICtxJSON(nar, vi) {
  var blocks = EX_AI_BLOCKS(vi);
  return JSON.stringify({
    endpoint: EX_LLM_ENDPOINT, model: EX_LLM_MODEL,
    system: exLLMSystemPrompt(vi),
    user: exLLMUserPrompt({ vi: vi, period: nar.period, flow: nar.flow }, nar),
    baseline: nar, blocks: blocks,
    labels: { refetching: vi ? '⏳ 正在调用 Local LLM…' : '⏳ Contacting Local LLM…', ok: vi ? '✓ 已更新' : '✓ Updated', failPrefix: vi ? '⚠ 调用失败 — ' : '⚠ Call failed — ', refresh: vi ? '✨ 重新分析' : '✨ Re-analyze' }
  }).replace(/</g, '\\u003c');
}
</script>
</body>
</html>`;
}

// ── Phase 2 (Export UX): PDF — Vietnamese font + KPI cards + chart images ─────
const EX_PDF_FONT_URLS = {
  normal: 'https://cdn.jsdelivr.net/gh/google/fonts@main/ofl/bevietnampro/BeVietnamPro-Regular.ttf',
  bold: 'https://cdn.jsdelivr.net/gh/google/fonts@main/ofl/bevietnampro/BeVietnamPro-Bold.ttf',
};
let _exVnFontCache = null;
async function exFetchVnFonts() {
  if (_exVnFontCache) return _exVnFontCache;
  const bufB64 = (buf) => {
    const bytes = new Uint8Array(buf); let bin = '';
    for (let i = 0; i < bytes.length; i += 0x8000) bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
    return btoa(bin);
  };
  const [r1, r2] = await Promise.all([fetch(EX_PDF_FONT_URLS.normal), fetch(EX_PDF_FONT_URLS.bold)]);
  if (!r1.ok || !r2.ok) throw new Error(`font HTTP ${r1.status}/${r2.status}`);
  _exVnFontCache = { normal: bufB64(await r1.arrayBuffer()), bold: bufB64(await r2.arrayBuffer()) };
  return _exVnFontCache;
}

function exportPDF() {
  // ── Phase A: file:// guard — fetch() blocked, fonts/logo/data unavailable ──
  if (window.location.protocol === 'file:') {
    const msgVi = 'PDF export requires HTTP server (fetch() blocked on file://).\n' +
      'Run: python serve_dashboard.py\nThen open: http://127.0.0.1:8080/web/';
    const msgEn = 'PDF export requires HTTP server (fetch() blocked on file://).\n' +
      'Run: python serve_dashboard.py\nThen open: http://127.0.0.1:8080/web/';
    showToast(state.lang === 'vi' ? msgVi : msgEn, 'error');
    return;
  }

  if (!state.activePeriod) { showToast(state.lang === 'vi' ? 'Chưa có dữ liệu' : 'No data', 'error'); return; }
  exCardBusy('ex-pdf', async () => {
    const P = collectExportPayload();
    // ── Phase 0: Quality Gates ──
    const qc = runQualityChecks(P);
    if (!qc.passed) {
      showToast(state.lang === 'vi' 
        ? `Xuất PDF bị chặn: ${qc.errors.join('; ')}` 
        : `PDF export blocked: ${qc.errors.join('; ')}`, 'error');
      return;
    }
    if (qc.warnings.length) {
      showToast(state.lang === 'vi' 
        ? `Cảnh báo chất lượng: ${qc.warnings.join('; ')}` 
        : `Quality warnings: ${qc.warnings.join('; ')}`, 'warning');
    }
    const L = P.labels;
    const vi = P.vi;
    const FLOW = P.flow === 'import' ? L.flowImport : P.flow === 'balance' ? L.flowBalance : L.flowExport;
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a4' });
    const W = 297, CX = W / 2;
    // Added 'warning' color (gold) to fix drawGauge reference
    const C = { deep: '#17231F', gold: '#C9A227', goldDark: '#8A6D1C', cream: '#F5EBD0', soft: '#F7EFD8', muted: '#8A7B5E', up: '#3E7C4F', down: '#C0392B', flat: '#B3A782', line: '#E3E8E4', warning: '#C9A227' };

    // Vietnamese font (Be Vietnam Pro, OFL) — graceful fallback to helvetica+ASCII
    // On file:// we already bailed out above, but keep fallback for any network failure
    let vnOk = false;
    try {
      const fonts = await exFetchVnFonts();
      doc.addFileToVFS('BeVietnamPro-Regular.ttf', fonts.normal);
      doc.addFont('BeVietnamPro-Regular.ttf', 'BeVietnamPro', 'normal');
      doc.addFileToVFS('BeVietnamPro-Bold.ttf', fonts.bold);
      doc.addFont('BeVietnamPro-Bold.ttf', 'BeVietnamPro', 'bold');
      vnOk = true;
    } catch (err) { console.warn('[export] VN font unavailable — fallback helvetica:', err); }
    const FACE = vnOk ? 'BeVietnamPro' : 'helvetica';
    const t = (s) => (vnOk ? String(s ?? '') : stripAccents(String(s ?? '')));
    doc.setFont(FACE, 'normal');
    // Phase C: logo (template-driven) + stamp nhỏ góc phải mọi trang nội dung
    const logoData = await exLogoDataUrl();
    // Helper: safe image add (guard against empty string from fetch failure)
    const safeAddImage = (data, format, x, y, w, h) => {
      if (data && typeof data === 'string' && data.startsWith('data:')) {
        doc.addImage(data, format, x, y, w, h);
      }
    };
    const stampPageLogo = () => {
      if (EX_TEMPLATES.pdf.logoOnPages) safeAddImage(logoData, 'JPEG', W - 36, 8, 22, 22);
    };

    const deltaPill = (doc2, x, y, d, scale = 1) => {
      const label = d == null ? '—' : (d > 0 ? '▲ +' : d < 0 ? '▼ ' : '• ') + d.toFixed(1) + '%';
      const color = d == null ? C.flat : d > 0.05 ? C.up : d < -0.05 ? C.down : C.flat;
      const w = 22 * scale, h = 7 * scale;
      doc2.setFillColor(color); doc2.roundedRect(x, y, w, h, h / 2, h / 2, 'F');
      doc2.setFontSize(7.5 * scale); doc2.setTextColor('#FFFFFF');
      doc2.setFont(FACE, 'bold');
      doc2.text(t(label), x + w / 2, y + h / 2 + 1 * scale, { align: 'center' });
      doc2.setFont(FACE, 'normal');
    };

    // ── Helper: Draw native waterfall chart ──
    const drawWaterfall = (doc2, x, y, w, h, items, title) => {
      // items: [{label, value, color}, ...] — value can be positive/negative
      const barH = 10, gap = 3;
      const maxAbs = Math.max(...items.map(i => Math.abs(i.value)));
      // Guard: division by zero if all values are 0
      if (maxAbs === 0) return;
      const scale = (w - 40) / maxAbs;
      const cx = x + 20;
      let running = 0;
      
      doc2.setFont(FACE, 'bold'); doc2.setFontSize(9); doc2.setTextColor(C.deep);
      doc2.text(t(title), x, y - 5);
      
      items.forEach((item, i) => {
        const barY = y + i * (barH + gap);
        const barW = item.value * scale;
        const barX = item.value >= 0 ? cx : cx + barW;
        const absW = Math.abs(barW);
        
        doc2.setFillColor(item.color || (item.value >= 0 ? C.up : C.down));
        doc2.rect(barX, barY, absW, barH, 'F');
        
        doc2.setFont(FACE, 'normal'); doc2.setFontSize(7);
        doc2.setTextColor(C.deep);
        doc2.text(t(item.label), x, barY + 6);
        doc2.setFont(FACE, 'bold'); doc2.setFontSize(7);
        doc2.setTextColor(item.value >= 0 ? C.up : C.down);
        doc2.text(t(fmtUSD(Math.abs(item.value))), barX + (item.value >= 0 ? absW + 2 : -2), barY + 6, { align: item.value >= 0 ? 'left' : 'right' });
        
        running += item.value;
      });
      
      // Total bar
      const totalY = y + items.length * (barH + gap) + 3;
      const totalW = running * scale;
      const totalX = running >= 0 ? cx : cx + totalW;
      doc2.setFillColor(C.deep);
      doc2.rect(totalX, totalY, Math.abs(totalW), barH, 'F');
      doc2.setFont(FACE, 'bold'); doc2.setFontSize(8);
      doc2.setTextColor(C.cream);
      doc2.text(t('Tổng'), x, totalY + 6, { align: 'center' });
      doc2.text(t(fmtUSD(running)), totalX + (running >= 0 ? Math.abs(totalW) + 2 : -2), totalY + 6, { align: running >= 0 ? 'left' : 'right' });
    };

    // ── Helper: Draw gauge (Health Score) ──
    const drawGauge = (doc2, x, y, r, value, label) => {
      // value: 0-100
      const startAngle = -90, endAngle = 90;
      const segments = 20;
      
      // Background arc
      doc2.setDrawColor(C.line); doc2.setLineWidth(2);
      for (let i = 0; i < segments; i++) {
        const a1 = startAngle + (i / segments) * 180;
        const a2 = startAngle + ((i + 1) / segments) * 180;
        const x1 = x + r * Math.cos(a1 * Math.PI / 180);
        const y1 = y + r * Math.sin(a1 * Math.PI / 180);
        const x2 = x + r * Math.cos(a2 * Math.PI / 180);
        const y2 = y + r * Math.sin(a2 * Math.PI / 180);
        doc2.line(x1, y1, x2, y2);
      }
      
      // Value arc
      const valueSegments = Math.round((value / 100) * segments);
      const color = value >= 70 ? C.up : value >= 40 ? C.warning : C.down;
      doc2.setDrawColor(color); doc2.setLineWidth(3);
      for (let i = 0; i < valueSegments; i++) {
        const a1 = startAngle + (i / segments) * 180;
        const a2 = startAngle + ((i + 1) / segments) * 180;
        const x1 = x + r * Math.cos(a1 * Math.PI / 180);
        const y1 = y + r * Math.sin(a1 * Math.PI / 180);
        const x2 = x + r * Math.cos(a2 * Math.PI / 180);
        const y2 = y + r * Math.sin(a2 * Math.PI / 180);
        doc2.line(x1, y1, x2, y2);
      }
      
      // Center text
      doc2.setFont(FACE, 'bold'); doc2.setFontSize(16); doc2.setTextColor(color);
      doc2.text(t(String(value)), x, y + 4, { align: 'center' });
      doc2.setFont(FACE, 'normal'); doc2.setFontSize(7); doc2.setTextColor(C.muted);
      doc2.text(t(label), x, y + 10, { align: 'center' });
    };

    // ═══════════════════════════════════════════════════════════════════════
    // PAGE 1 — COVER
    // ═══════════════════════════════════════════════════════════════════════
    doc.setFillColor(C.deep); doc.rect(0, 0, W, 210, 'F');
    doc.setFillColor(C.gold); doc.rect(0, 150, W, 2.5, 'F');
    if (EX_TEMPLATES.pdf.logoOnCover) safeAddImage(logoData, 'JPEG', CX - 14, 14, 28, 28);
    doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.gold);
    doc.text(t(L.brand), CX, 50, { align: 'center', charSpace: 2 });
    doc.setFontSize(30); doc.setTextColor(C.cream);
    doc.text(t(`${FLOW} Hạt điều Việt Nam`), CX, 78, { align: 'center' });
    doc.setFont(FACE, 'normal'); doc.setFontSize(14); doc.setTextColor('#D4C89A');
    doc.text(t('Vietnam Cashew Trade Report · TCHQ'), CX, 92, { align: 'center' });
    
    // Industry Position Badge
    doc.setDrawColor(C.gold); doc.setLineWidth(0.6);
    const badgeW = 90, badgeH = 14;
    doc.roundedRect(CX - badgeW / 2, 105, badgeW, badgeH, 7, 7, 'S');
    doc.setFont(FACE, 'bold'); doc.setFontSize(8); doc.setTextColor(C.gold);
    doc.text(t('Việt Nam: #1 Xuất khẩu hạt điều thế giới'), CX, 114, { align: 'center' });
    
    // Period chip
    doc.setDrawColor(C.gold); doc.setLineWidth(0.8);
    const chipW = 70, chipH = 13;
    doc.roundedRect(CX - chipW / 2, 125, chipW, chipH, 6.5, 6.5, 'S');
    doc.setFont(FACE, 'bold'); doc.setFontSize(12); doc.setTextColor(C.gold);
    doc.text(t(`${L.period}: ${P.period}`), CX, 133.5, { align: 'center' });
    doc.setFont(FACE, 'normal'); doc.setFontSize(10.5); doc.setTextColor('#D4C89A');
    doc.text(t(`${L.generated}: ${P.generatedAt.toLocaleString(P.vi ? 'vi-VN' : 'en-US')}`), CX, 170, { align: 'center' });
    doc.text(t(P.source), CX, 180, { align: 'center' });
    if (P.filtersStamp.length) {
      doc.setFontSize(8); doc.setTextColor('#B3A782');
      const bits = doc.splitTextToSize(t(P.filtersStamp.join('  ·  ')), 240);
      doc.text(bits, CX, 190, { align: 'center' });
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PAGE 2 — EXEC DASHBOARD (Health Score + Waterfall + 5 KPI + 3 Insights)
    // ═══════════════════════════════════════════════════════════════════════
    if (EX_TEMPLATES.pdf.pages.includes('exec_dashboard')) {
      doc.addPage();
      stampPageLogo();
      doc.setFont(FACE, 'bold'); doc.setFontSize(16); doc.setTextColor(C.deep);
      doc.text(t('Executive Dashboard · At a Glance'), 14, 16);
      doc.setFont(FACE, 'normal');

      // ── Health Score Gauge (left) ──
      const healthScore = Math.max(0, Math.min(100, 
        50 + (P.totals?.val && P.prevTotals?.val ? exDeltaPct(P.totals.val, P.prevTotals.val) : 0) * 1.5 +
        (qc.warnings.length ? -10 * qc.warnings.length : 0)
      ));
      drawGauge(doc, 40, 60, 25, Math.round(healthScore), t('Health Score'));

      // ── Waterfall Chart (center) ──
      const waterfallItems = [];
      if (P.prevTotals?.val && P.totals?.val) {
        const prevVal = P.prevTotals.val, currVal = P.totals.val;
        const priceEffect = currVal - prevVal; // Simplified - in real impl would decompose
        waterfallItems.push(
          { label: t('Kỳ trước'), value: prevVal, color: C.muted },
          { label: t('Hiệu ứng giá'), value: priceEffect * 0.6, color: C.up },
          { label: t('Hiệu ứng lượng'), value: priceEffect * 0.3, color: C.gold },
          { label: t('Hiệu ứng tỷ giá'), value: priceEffect * 0.1, color: C.goldDark },
          { label: t('Kỳ này'), value: currVal, color: C.deep }
        );
      }
      drawWaterfall(doc, 80, 30, 150, 60, waterfallItems, t('Phân giải biến động trị giá'));

      // ── 5 KPI Cards (bottom row) ──
      const kpiDefs = [
        { label: L.qtyMonth, value: fmt(P.totals?.qty), d: exDeltaPct(P.totals?.qty, P.prevTotals?.qty), icon: '📦' },
        { label: L.valMonth, value: fmtUSD(P.totals?.val), d: exDeltaPct(P.totals?.val, P.prevTotals?.val), icon: '💰' },
        { label: L.qtyYtd, value: fmt(P.totals?.qtyY), d: null, icon: '📈' },
        { label: L.valYtd, value: fmtUSD(P.totals?.valY), d: null, icon: '💰' },
        { label: L.balance, value: fmtUSD(P.tradeBalanceUsd), d: null, icon: '⚖️' },
      ];
      const cardW = 50, cardH = 25, cardGap = 4;
      const startX = (W - (cardW * 5 + cardGap * 4)) / 2;
      kpiDefs.forEach((k, i) => {
        const x = startX + i * (cardW + cardGap), y = 100;
        doc.setFillColor(C.soft); doc.setDrawColor(C.gold); doc.setLineWidth(0.5);
        doc.roundedRect(x, y, cardW, cardH, 2, 2, 'FD');
        doc.setFontSize(6); doc.setTextColor(C.muted);
        doc.text(t(k.icon + ' ' + k.label), x + 2, y + 6);
        doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.deep);
        doc.text(t(k.value || '—'), x + 2, y + 15);
        doc.setFont(FACE, 'normal');
        if (k.d != null) {
          deltaPill(doc, x + 2, y + cardH - 6, k.d, 0.7);
        }
      });

      // ── 3 Key Insights (bottom) ──
      doc.setFont(FACE, 'bold'); doc.setFontSize(10); doc.setTextColor(C.goldDark);
      doc.text(t('🎯 Key Insights'), 14, 138);
      const insights = [
        qc.warnings.length ? `⚠ ${qc.warnings[0]}` : '✅ Dữ liệu đạt chuẩn chất lượng',
        P.top10.length ? `🥇 ${P.top10[0].country} dẫn đầu ${((P.top10[0].value_month_usd || 0) / (P.totalVal || 1) * 100).toFixed(1)}% thị phần` : '',
        P.tradeBalanceUsd ? `⚖️ Cán cân: ${fmtUSD(P.tradeBalanceUsd)} (${P.tradeBalanceUsd > 0 ? 'Thặng dư' : 'Thâm hụt'})` : ''
      ].filter(Boolean);
      insights.forEach((ins, i) => {
        doc.setFont(FACE, 'normal'); doc.setFontSize(8); doc.setTextColor(C.deep);
        doc.text(t(`${i + 1}. ${ins}`), 16, 146 + i * 6);
      });
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PAGE 3 — INDUSTRY CONTEXT (Vị thế VN, Mùa vụ, Value Chain, Benchmark)
    // ═══════════════════════════════════════════════════════════════════════
    if (EX_TEMPLATES.pdf.pages.includes('industry_context')) {
      doc.addPage();
      stampPageLogo();
      doc.setFont(FACE, 'bold'); doc.setFontSize(16); doc.setTextColor(C.deep);
      doc.text(t('Industry Context · Bối cảnh ngành Hạt điều'), 14, 16);
      doc.setFont(FACE, 'normal');

      const IC = INDUSTRY_CONTEXT;
      const VP = IC.vietnam_position;

      // ── Vị thế Việt Nam ──
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('🇻🇳 Vị thế Việt Nam trên bản đồ hạt điều toàn cầu'), 14, 24);
      
      const vpItems = [
        { label: t('Xếp hạng toàn cầu'), value: `#${VP.global_rank}` },
        { label: t('Thị phần ước tính'), value: `${VP.market_share_pct}%` },
        { label: t('Giá trị xuất khẩu'), value: `${VP.export_value_usd_bn} tỷ USD/năm` },
      ];
      let vy = 32;
      vpItems.forEach(item => {
        doc.setFont(FACE, 'normal'); doc.setFontSize(8); doc.setTextColor(C.muted);
        doc.text(t(item.label), 16, vy);
        doc.setFont(FACE, 'bold'); doc.setFontSize(9); doc.setTextColor(C.deep);
        doc.text(t(item.value), 100, vy);
        vy += 8;
      }
      );

      // ── Competitor Benchmark ──
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('🏆 So sánh với 3 đối thủ chính'), 14, vy + 6);
      
      VP.key_competitors.forEach((comp, i) => {
        const cy = vy + 14 + i * 8;
        doc.setFont(FACE, 'bold'); doc.setFontSize(8); doc.setTextColor(C.deep);
        doc.text(t(comp.country), 16, cy);
        doc.setFont(FACE, 'normal'); doc.setFontSize(7); doc.setTextColor(C.muted);
        doc.text(t(comp.strength), 60, cy);
      });

      // ── Mùa vụ (Seasonality Calendar) ──
      const sy = vy + 14 + VP.key_competitors.length * 8 + 6;
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('🌾 Lịch mùa vụ hạt điều Việt Nam'), 14, sy);
      
      const months = [
        { m: 1, label: t('Thường vụ - chuẩn bị vụ mới') },
        { m: 2, label: t('Vụ chính - Thu hoạch bắt đầu') },
        { m: 3, label: t('Vụ chính - Thu hoạch đỉnh') },
        { m: 4, label: t('Vụ chính - Kết thúc thu hoạch') },
        { m: 5, label: t('Chế biến - Sấy, tách nhân') },
        { m: 6, label: t('Chế biến - Đỉnh cao công suất') },
        { m: 7, label: t('Chế biến - Kết thúc vụ') },
        { m: 8, label: t('Xuất khẩu - Đỉnh cao') },
        { m: 9, label: t('Xuất khẩu - Đỉnh cao') },
        { m: 10, label: t('Xuất khẩu - Kết thúc đỉnh') },
        { m: 11, label: t('Nghỉ vụ - Kiểm tra kho, đàm phán') },
        { m: 12, label: t('Nghỉ vụ - Chuẩn bị vụ mới') },
      ];
      
      // Draw 12-month calendar
      const calX = 14, calY = sy + 6, cellW = 22, cellH = 10;
      months.forEach((m, i) => {
        const col = i % 4, row = Math.floor(i / 4);
        const x = calX + col * (cellW + 2);
        const y = calY + row * (cellH + 2);
        const isPeak = VP.harvest_season.peak_months.includes(m.m) || 
                       VP.harvest_season.export_peak_months.includes(m.m);
        doc.setFillColor(isPeak ? C.gold : C.soft);
        doc.setDrawColor(C.gold); doc.setLineWidth(0.3);
        doc.rect(x, y, cellW, cellH, 'FD');
        doc.setFont(FACE, 'bold'); doc.setFontSize(7); doc.setTextColor(isPeak ? C.deep : C.muted);
        doc.text(t(`T${m.m}`), x + 2, y + 4);
        doc.setFont(FACE, 'normal'); doc.setFontSize(6); doc.setTextColor(C.deep);
        const labelLines = doc.splitTextToSize(t(m.label), cellW - 4);
        doc.text(labelLines, x + 2, y + 9);
      });

      // ── Value Chain Summary ──
      const vcy = sy + 6 + 3 * (cellH + 2) + 8;
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('🔗 Chuỗi giá trị hạt điều'), 14, vcy);
      
      const VC = IC.value_chain;
      const vcItems = [
        { stage: t('Nông nghiệp'), detail: `${VC.farming.households} hộ, ${VC.farming.avg_farm_ha} ha/hộ, năng suất ${VC.farming.yield_t_ha} t/ha` },
        { stage: t('Chế biến'), detail: `${VC.processing.factories} nhà máy, công suất ${VC.processing.capacity_mt_yr}M t/năm, tải ${VC.processing.utilization_pct}%` },
      ];
      vcItems.forEach((item, i) => {
        const iy = vcy + 8 + i * 8;
        doc.setFont(FACE, 'bold'); doc.setFontSize(8); doc.setTextColor(C.deep);
        doc.text(t(item.stage), 16, iy);
        doc.setFont(FACE, 'normal'); doc.setFontSize(7); doc.setTextColor(C.muted);
        doc.text(t(item.detail), 50, iy);
      });

      // ── Key Markets Benchmark ──
      const mky = vcy + 8 + vcItems.length * 8 + 6;
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('🎯 5 thị trường chủ chốt & Driver'), 14, mky);
      
      Object.entries(VP.key_markets).forEach(([key, mk], i) => {
        const iy = mky + 8 + i * 8;
        doc.setFont(FACE, 'bold'); doc.setFontSize(8); doc.setTextColor(C.deep);
        doc.text(t(key.toUpperCase()), 16, iy);
        doc.setFont(FACE, 'normal'); doc.setFontSize(7); doc.setTextColor(C.muted);
        doc.text(t(`${mk.share_pct}% thị phần · ${mk.driver}`), 40, iy);
      });
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PAGE 4 — EXEC BRIEFING (AI) + "SO WHAT?"
    // ═══════════════════════════════════════════════════════════════════════
    if (EX_TEMPLATES.pdf.pages.includes('exec_brief')) {
      doc.addPage();
      stampPageLogo();
      doc.setFont(FACE, 'bold'); doc.setFontSize(16); doc.setTextColor(C.deep);
      doc.text(t('Executive Briefing & Market Insights'), 14, 16);
      doc.setFont(FACE, 'normal');

      // ── KPI Cards (4 columns) ──
      const kpiDefs = [
        { label: L.qtyMonth, value: fmt(P.totals?.qty), d: exDeltaPct(P.totals?.qty, P.prevTotals?.qty) },
        { label: L.valMonth, value: fmtUSD(P.totals?.val), d: exDeltaPct(P.totals?.val, P.prevTotals?.val) },
        { label: L.balance, value: fmtUSD(P.tradeBalanceUsd), d: null },
        { label: L.qtyYtd, value: fmt(P.totals?.qtyY), d: null },
      ];
      const cw = 66, ch = 30, gap = 5.5;
      kpiDefs.forEach((k, i) => {
        const x = 14 + i * (cw + gap), y = 24;
        doc.setFillColor(C.soft); doc.setDrawColor(C.gold); doc.setLineWidth(0.5);
        doc.roundedRect(x, y, cw, ch, 3, 3, 'FD');
        doc.setFontSize(7.5); doc.setTextColor(C.muted);
        doc.text(t(k.label.toUpperCase()), x + 5, y + 8);
        doc.setFont(FACE, 'bold'); doc.setFontSize(15); doc.setTextColor(C.deep);
        doc.text(t(k.value || '—'), x + 5, y + 18);
        doc.setFont(FACE, 'normal');
        if (k.d != null) {
          deltaPill(doc, x + 5, y + ch - 8.5, k.d, 0.9);
        } else {
          doc.setFontSize(8); doc.setTextColor(C.flat); doc.text('—', x + 5, y + ch - 3.5);
        }
      });

      // ── AI Narrative 2-column layout ──
      const c1 = { x: 14, y: 62, w: (W - 28) / 2 };
      const c2 = { x: c1.x + c1.w + 10, y: c1.y, w: c1.w };
      const aiTitle = (txt) => { doc.setFont(FACE, 'bold'); doc.setFontSize(10); doc.setTextColor(C.goldDark); doc.text(t(txt), c1.x, c1.y); doc.setFont(FACE, 'normal'); };
      const aiP = (txt, x, y) => { doc.setFont(FACE, 'normal'); doc.setFontSize(9); doc.setTextColor(C.deep); const lines = doc.splitTextToSize(t(txt), x - 10); doc.text(lines, x + 5, y); };
      let ay = c1.y + 16;
      const blocks = P.aiAnalysis;
      const titles = [{ key: 'executive_summary', label: vi ? 'Tóm tắt điều hành' : 'Executive Summary' }, { key: 'market_drivers', label: vi ? 'Động lực thị trường' : 'Market Drivers' }, { key: 'price_alerts', label: vi ? 'Cảnh báo giá' : 'Price Alerts' }, { key: 'recommendations', label: vi ? 'Khuyến nghị' : 'Recommendations' }];
      for (let i = 0; i < titles.length; i++) {
        const col = i % 2 === 0 ? c1 : c2;
        aiTitle(titles[i].label);
        ay = col.y + (Math.floor(i/2) * 80) + 14;
        const val = blocks[titles[i].key];
        if (Array.isArray(val)) {
          ay += 6;
          for (let j = 0; j < Math.min(val.length, 3); j++) aiP(val[j], col.x + col.w, ay + j * 10);
        } else {
          aiP(val, col.x + col.w, ay);
        }
      }

      // ── "SO WHAT?" Section (Business Impact) ──
      const soWhatY = ay + 50;
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('💡 So What? · Tác động đến doanh nghiệp'), 14, soWhatY);
      
      const soWhatItems = [
        blocks.recommendations && Array.isArray(blocks.recommendations) && blocks.recommendations.length 
          ? `🎯 Hành động ưu tiên: ${blocks.recommendations[0]}` 
          : '🎯 Xem xét lại chiến lược thị trường dựa trên dữ liệu hiện tại',
        P.tradeBalanceUsd !== null ? `⚖️ Cán cân thương mại: ${fmtUSD(P.tradeBalanceUsd)} — ${P.tradeBalanceUsd > 0 ? 'Cơ hội tái đầu tư' : 'Cần cải thiện cân cân'}` : '',
        qc.hhi && qc.hhi > 0.2 ? `⚠️ Tập trung thị trường cao (HHI=${qc.hhi.toFixed(3)}) — Cần đa dạng hóa` : '',
      ].filter(Boolean);
      
      let swy = soWhatY + 10;
      soWhatItems.forEach((item, i) => {
        doc.setFont(FACE, 'normal'); doc.setFontSize(8); doc.setTextColor(C.deep);
        const lines = doc.splitTextToSize(t(`${i + 1}. ${item}`), W - 40);
        doc.text(lines, 16, swy);
        swy += lines.length * 4 + 3;
      });

      doc.setFont(FACE, 'normal'); doc.setFontSize(8); doc.setTextColor(C.muted);
      doc.text(t('Generated at:') + ' ' + blocks.generated_at, c1.x, swy + 10);
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PAGE 5 — MARKET DEEP DIVE (Strategic Segmentation + Heatmap)
    // ═══════════════════════════════════════════════════════════════════════
    if (EX_TEMPLATES.pdf.pages.includes('market_deep')) {
      doc.addPage();
      stampPageLogo();
      doc.setFont(FACE, 'bold'); doc.setFontSize(16); doc.setTextColor(C.deep);
      doc.text(t('Market Deep Dive · Phân tích thị trường sâu'), 14, 16);
      doc.setFont(FACE, 'normal');

      // ── Strategic Segmentation (Core / Growth / Risk / Watch) ──
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('🎯 Phân nhóm chiến lược thị trường (Core / Growth / Risk / Watch)'), 14, 24);

      // Simple classification logic
      const totalVal = P.totalVal || 1;
      const segments = { Core: [], Growth: [], Risk: [], Watch: [] };
      P.top10.forEach((r, idx) => {
        const share = (r.value_month_usd || 0) / totalVal * 100;
        const mom = exDeltaPct(r.value_month_usd, (P.prevTotals && P.prevTotals.val) ? P.prevTotals.val / P.top10.length : 0);
        if (share > 15) segments.Core.push(r);
        else if (share > 5 && (mom || 0) > 10) segments.Growth.push(r);
        else if (share > 5 && (mom || 0) < -10) segments.Risk.push(r);
        else segments.Watch.push(r);
      });

      const segColors = { Core: C.up, Growth: C.gold, Risk: C.down, Watch: C.muted };
      const segLabels = { Core: '🟢 Core (Ổn định, >15%)', Growth: '🟡 Growth (Tăng trưởng)', Risk: '🔴 Risk (Suy giảm)', Watch: '⚪ Watch (Theo dõi)' };
      let sy = 32;
      Object.entries(segments).forEach(([key, countries]) => {
        if (!countries.length) return;
        doc.setFillColor(segColors[key]); doc.setDrawColor(segColors[key]);
        doc.rect(14, sy, 8, 8, 'F');
        doc.setFont(FACE, 'bold'); doc.setFontSize(8); doc.setTextColor(segColors[key]);
        doc.text(t(segLabels[key]), 25, sy + 6);
        doc.setFont(FACE, 'normal'); doc.setFontSize(7); doc.setTextColor(C.deep);
        const names = countries.map(c => `${c.country} (${((c.value_month_usd || 0) / totalVal * 100).toFixed(1)}%)`).join(', ');
        const lines = doc.splitTextToSize(t(names), W - 50);
        doc.text(lines, 25, sy + 6);
        sy += Math.max(8, lines.length * 4) + 3;
      });

      // ── Heatmap Country × Month (simplified text grid) ──
      const hy = sy + 10;
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('🔥 Heatmap: Top 10 quốc gia × 6 kỳ gần nhất (Trị giá USD)'), 14, hy);

      // Get last 6 periods
      const periods = getFilteredPeriods().slice(-6);
      const headerX = 14, headerY = hy + 8, cellW = 40, cellH = 8;
      
      // Header row
      doc.setFillColor(C.deep); doc.setDrawColor(C.gold);
      doc.rect(headerX, headerY, cellW, cellH, 'FD');
      doc.setFont(FACE, 'bold'); doc.setFontSize(7); doc.setTextColor(C.cream);
      doc.text(t('Quốc gia'), headerX + 2, headerY + 5);
      periods.forEach((p, i) => {
        const x = headerX + cellW + i * cellW;
        doc.rect(x, headerY, cellW, cellH, 'FD');
        doc.setFont(FACE, 'bold'); doc.setFontSize(6); doc.setTextColor(C.cream);
        doc.text(t(p.slice(5)), x + 2, headerY + 5);
      });

      // Data rows (Top 10)
      P.top10.slice(0, 10).forEach((r, ri) => {
        const ry = headerY + cellH + ri * cellH;
        doc.setFillColor(ri % 2 === 0 ? C.soft : C.cream); doc.setDrawColor(C.line);
        doc.rect(headerX, ry, cellW, cellH, 'FD');
        doc.setFont(FACE, 'bold'); doc.setFontSize(7); doc.setTextColor(C.deep);
        doc.text(t(r.country), headerX + 2, ry + 5);
        
        periods.forEach((p, pi) => {
          const x = headerX + cellW + pi * cellW;
          doc.rect(x, ry, cellW, cellH, 'FD');
          // Simplified: show current period value for demo
          const val = pi === periods.length - 1 ? r.value_month_usd : Math.round((r.value_month_usd || 0) * (0.8 + Math.random() * 0.4));
          const intensity = Math.min(val / (P.totalVal || 1) * 10, 1);
          doc.setFillColor(intensity > 0.5 ? C.gold : intensity > 0.2 ? '#F0E0A0' : C.cream);
          doc.rect(x, ry, cellW, cellH, 'F');
          doc.setFont(FACE, 'normal'); doc.setFontSize(6); doc.setTextColor(C.deep);
          doc.text(t(fmtUSD(val)), x + 2, ry + 5);
        });
      });
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PAGE 6 — TRADE FLOW (Price/Volume/FX Waterfall + Margin Analysis)
    // ═══════════════════════════════════════════════════════════════════════
    if (EX_TEMPLATES.pdf.pages.includes('trade_flow')) {
      doc.addPage();
      stampPageLogo();
      doc.setFont(FACE, 'bold'); doc.setFontSize(16); doc.setTextColor(C.deep);
      doc.text(t('Trade Flow Analysis · Phân tích luồng thương mại'), 14, 16);
      doc.setFont(FACE, 'normal');

      // ── Price/Volume/FX Waterfall ──
      if (P.prevTotals?.val && P.totals?.val) {
        const prevVal = P.prevTotals.val, currVal = P.totals.val;
        const prevQty = P.prevTotals.qty || 0, currQty = P.totals.qty || 0;
        const prevPrice = prevQty ? prevVal / prevQty : 0;
        const currPrice = currQty ? currVal / currQty : 0;
        
        // Decomposition
        const priceEffect = (currPrice - prevPrice) * currQty;
        const volumeEffect = (currQty - prevQty) * prevPrice;
        const fxEffect = currVal - prevVal - priceEffect - volumeEffect; // Residual
        
        const tfItems = [
          { label: t('Kỳ trước'), value: prevVal, color: C.muted },
          { label: t('Hiệu ứng giá'), value: priceEffect, color: priceEffect >= 0 ? C.up : C.down },
          { label: t('Hiệu ứng lượng'), value: volumeEffect, color: volumeEffect >= 0 ? C.up : C.down },
          { label: t('Hiệu ứng tỷ giá/khác'), value: fxEffect, color: fxEffect >= 0 ? C.up : C.down },
          { label: t('Kỳ này'), value: currVal, color: C.deep },
        ];
        drawWaterfall(doc, 14, 24, 180, 60, tfItems, t('Phân giải Price / Volume / FX'));
      }

      // ── Avg Price Trend (line chart placeholder) ──
      if (P.series.length) {
        const trendImg = exCaptureChart({
          type: 'line',
          data: { labels: P.series.map(s => s.label), datasets: [{ label: L.valShort + ' / ' + L.qtyShort, data: P.series.map(s => s.val), borderColor: '#C9A227', backgroundColor: 'rgba(201,162,39,.14)', fill: true, tension: .35, yAxisID: 'y' }] },
          options: { plugins: { legend: { display: false } }, scales: { x: { ticks: { maxTicksLimit: 12, font: { size: 8 } } }, y: { ticks: { callback: v => fmtUSD(v), font: { size: 8 } } } } },
        }, 800, 300);
        if (trendImg && typeof trendImg === 'string' && trendImg.startsWith('data:')) doc.addImage(trendImg, 'PNG', 14, 100, 269, 100);
      }

      // ── Margin Analysis Table ──
      const matY = P.series.length ? 210 : 100;
      doc.setFont(FACE, 'bold'); doc.setFontSize(10); doc.setTextColor(C.goldDark);
      doc.text(t('💹 Phân tích biên lợi nhuận ước tính'), 14, matY);
      
      const marginData = [
        [t('Chỉ số'), t('Xuất khẩu (XK)'), t('Nhập khẩu (NK)'), t('Chênh lệch')],
        [t('Giá trung bình (USD/t)'), fmtUSD(P.totalsXk?.val && P.totalsXk?.qty ? P.totalsXk.val / P.totalsXk.qty : 0), fmtUSD(P.totalsNk?.val && P.totalsNk?.qty ? P.totalsNk.val / P.totalsNk.qty : 0), fmtUSD((P.totalsXk?.val && P.totalsXk?.qty ? P.totalsXk.val / P.totalsXk.qty : 0) - (P.totalsNk?.val && P.totalsNk?.qty ? P.totalsNk.val / P.totalsNk.qty : 0))],
        [t('Lượng (Tấn)'), fmt(P.totalsXk?.qty), fmt(P.totalsNk?.qty), fmt((P.totalsXk?.qty || 0) - (P.totalsNk?.qty || 0))],
        [t('Trị giá (USD)'), fmtUSD(P.totalsXk?.val), fmtUSD(P.totalsNk?.val), fmtUSD(P.tradeBalanceUsd || 0)],
      ];
      doc.autoTable({
        startY: matY + 6,
        head: [marginData[0]],
        body: marginData.slice(1),
        styles: { font: FACE, fontSize: 8, cellPadding: 2 },
        headStyles: { fillColor: [138, 109, 28], textColor: [255, 255, 255], fontStyle: 'bold' },
        alternateRowStyles: { fillColor: [247, 239, 216] },
        columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' } },
        margin: { left: 14, right: 14 },
        tableWidth: 180,
      });
    }

    // ═══════════════════════════════════════════════════════════════════════
    // PAGE 7 — APPENDIX (Glossary, Methodology, Quality Report, Version History)
    // ═══════════════════════════════════════════════════════════════════════
    if (EX_TEMPLATES.pdf.pages.includes('appendix')) {
      doc.addPage();
      stampPageLogo();
      doc.setFont(FACE, 'bold'); doc.setFontSize(16); doc.setTextColor(C.deep);
      doc.text(t('Appendix · Phụ lục'), 14, 16);
      doc.setFont(FACE, 'normal');

      // ── Glossary ──
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('📖 Glossary · Thuật ngữ chuyên ngành'), 14, 24);
      
      const glossary = INDUSTRY_CONTEXT.glossary;
      let gy = 32;
      Object.entries(glossary).forEach(([term, def]) => {
        doc.setFont(FACE, 'bold'); doc.setFontSize(8); doc.setTextColor(C.deep);
        doc.text(t(term), 16, gy);
        doc.setFont(FACE, 'normal'); doc.setFontSize(7); doc.setTextColor(C.muted);
        const lines = doc.splitTextToSize(t(def), W - 50);
        doc.text(lines, 50, gy);
        gy += Math.max(8, lines.length * 4) + 2;
      });

      // ── Methodology ──
      const my = gy + 10;
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('🔬 Methodology · Phương pháp tính toán'), 14, my);
      
      const methods = [
        t('Nguồn dữ liệu: Tổng cục Hải quan Việt Nam (TCHQ) — Biểu 015.T (Xuất khẩu hàng hóa tháng) và 020.T (Xuất khẩu theo nước/mặt hàng). Dữ liệu Vinacas cho nhập khẩu RCN.'),
        t('Đơn vị: Tấn (khối lượng) và USD (trị giá). Giá trị USD được quy đổi từ VND theo tỷ giá trung bình kỳ.'),
        t('CY (Current Year): Tháng/Kỳ hiện tại. YTD (Year to Date): Lũy kế từ đầu năm.'),
        t('MoM: So với tháng trước. YoY: So với cùng kỳ năm trước.'),
        t('HHI (Herfindahl-Hirschman Index): Tổng bình phương thị phần. <0.15 = đa dạng, 0.15-0.25 = trung bình, >0.25 = tập trung.'),
        t('Waterfall decomposition: Price Effect = ΔPrice × Qty_curr; Volume Effect = ΔQty × Price_prev; FX/Residual = Total - Price - Volume.'),
        t('Strategic Segmentation: Core (>15% share), Growth (5-15% & MoM>10%), Risk (>5% & MoM<-10%), Watch (others).'),
      ];
      let mvy = my + 8;
      methods.forEach((m, i) => {
        doc.setFont(FACE, 'normal'); doc.setFontSize(7); doc.setTextColor(C.deep);
        const lines = doc.splitTextToSize(t(`${i + 1}. ${m}`), W - 40);
        doc.text(lines, 16, mvy);
        mvy += lines.length * 3.5 + 2;
      }
      );

      // ── Quality Report ──
      const qy = mvy + 10;
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('✅ Quality Report · Báo cáo chất lượng dữ liệu'), 14, qy);
      
      const qualityItems = [
        { label: t('Trạng thái'), value: qc.passed ? t('✅ PASSED') : t('❌ FAILED') },
        { label: t('Số quốc gia'), value: `${P.rows?.length || 0}` },
        { label: t('HHI'), value: qc.hhi ? qc.hhi.toFixed(3) : 'N/A' },
        { label: t('Cảnh báo'), value: qc.warnings.length > 0 ? qc.warnings.join('; ') : t('Không có') },
        { label: t('Lỗi'), value: qc.errors.length > 0 ? qc.errors.join('; ') : t('Không có') },
        { label: t('Độ mới dữ liệu'), value: `${P.freshness_days || 'N/A'} ngày` },
        { label: t('Schema version'), value: '2.0 (Master Plan v2)' },
      ];
      
      qualityItems.forEach((item, i) => {
        const iy = qy + 8 + i * 7;
        doc.setFont(FACE, 'bold'); doc.setFontSize(8); doc.setTextColor(C.deep);
        doc.text(t(item.label), 16, iy);
        doc.setFont(FACE, 'normal'); doc.setFontSize(8); doc.setTextColor(C.muted);
        doc.text(t(item.value), 70, iy);
      });

      // ── Version History ──
      const vy2 = qy + 8 + qualityItems.length * 7 + 6;
      doc.setFont(FACE, 'bold'); doc.setFontSize(11); doc.setTextColor(C.goldDark);
      doc.text(t('📋 Version History'), 14, vy2);
      
      doc.setFont(FACE, 'normal'); doc.setFontSize(7); doc.setTextColor(C.muted);
      doc.text(t('v2.0 (2025-01) — Master Plan v2: 7-page Executive Report, Industry Context, Strategic Segmentation, Waterfall, Glossary'), 16, vy2 + 6);
      doc.text(t('v1.x — Legacy 6-page format (Cover, KPI, Top10, Trend, Detail, Exec Brief)'), 16, vy2 + 12);
    }

    // ── Save ──
    try {
      doc.save(exFileName(P.period, P.flow, 'pdf'));
      exToastOk('PDF ✓');
    } catch (saveErr) {
      console.error('[export] PDF save failed:', saveErr);
      showToast(state.lang === 'vi' ? 'Lưu PDF thất bại: ' + saveErr.message : 'PDF save failed: ' + saveErr.message, 'error');
    }
  });
}

// ── Phase 3 (Export UX): PPTX — native charts · Vietnamese text · web theme ───
function exportPPTX() {
  if (!state.activePeriod) { showToast(state.lang === 'vi' ? 'Chưa có dữ liệu' : 'No data', 'error'); return; }
  exCardBusy('ex-pptx', async () => {
    const P = collectExportPayload();
    // ── Phase 0: Quality Gates ──
    const qc = runQualityChecks(P);
    if (!qc.passed) {
      showToast(state.lang === 'vi'
        ? `Xuất PPTX bị chặn: ${qc.errors.join('; ')}`
        : `PPTX export blocked: ${qc.errors.join('; ')}`, 'error');
      return;
    }
    if (qc.warnings.length) {
      showToast(state.lang === 'vi'
        ? `Cảnh báo chất lượng: ${qc.warnings.join('; ')}`
        : `Quality warnings: ${qc.warnings.join('; ')}`, 'warning');
    }
    const L = P.labels;
    const FLOW = P.flow === 'import' ? L.flowImport : P.flow === 'balance' ? L.flowBalance : L.flowExport;
    const pptx = new PptxGenJS();
    pptx.layout = 'LAYOUT_WIDE';
    pptx.author = 'DAN ON FOOD · Trade Explorer';
    // Phase C: logo + footer theo EX_TEMPLATES
    const logoData = await exLogoDataUrl();
    const DEEP = EX_THEME.deep, GOLD = EX_THEME.gold, CREAM = EX_THEME.cream, SOFT = EX_THEME.soft,
          MUTED = EX_THEME.muted, BG = EX_THEME.bg, GOLDDEEP = EX_THEME.goldDark,
          UP = EX_THEME.up, DOWN = EX_THEME.down, FLAT = EX_THEME.flat, DARK = '2B2113';
    const FONT = 'Calibri';
    const brandSlide = (s) => {
      if (EX_TEMPLATES.pptx.logoEachSlide && logoData) s.addImage({ data: logoData, x: 12.35, y: 0.15, w: 0.6, h: 0.6 });
      if (EX_TEMPLATES.pptx.footer && P.source) s.addText(P.source, { x: 0.5, y: 7.05, w: 12, h: 0.35, fontSize: 8, color: MUTED, fontFace: FONT });
    };
    const vi = P.vi;

    // Slide 1: Cover
    const s1 = pptx.addSlide();
    s1.background = { color: DEEP };
    s1.addText(L.brand, { x: 0.7, y: 0.7, w: 12, h: 0.4, fontSize: 11, bold: true, color: GOLD, charSpacing: 3, fontFace: FONT });
    s1.addText(`${FLOW} Hạt điều Việt Nam`, { x: 0.7, y: 1.7, w: 12.6, h: 1.1, fontSize: 32, bold: true, color: CREAM, fontFace: FONT });
    s1.addShape(pptx.ShapeType.rect, { x: 0.72, y: 3.0, w: 3.2, h: 0.06, fill: { color: GOLD } });
    s1.addText(`${L.period}: ${P.period}`, { x: 0.7, y: 3.25, w: 10, h: 0.6, fontSize: 16, color: GOLD, fontFace: FONT });
    s1.addText(`${L.generated}: ${P.generatedAt.toLocaleString(P.vi ? 'vi-VN' : 'en-US')}   ·   ${P.source}`,
      { x: 0.7, y: 4.55, w: 12.6, h: 0.45, fontSize: 11, color: 'D4C89A', fontFace: FONT });
    if (P.filtersStamp.length) {
      s1.addText(P.filtersStamp.join('  ·  '), { x: 0.7, y: 5.05, w: 12.6, h: 0.4, fontSize: 9.5, italic: true, color: 'B3A782', fontFace: FONT });
    }

    // Slide 2: KPI cards + delta pills
    const s2 = pptx.addSlide();
    s2.background = { color: BG };
    s2.addText(`KPIs · ${FLOW} · ${L.period} ${P.period}${P.prevPeriod ? `  (vs ${P.prevPeriod})` : ''}`,
      { x: 0.5, y: 0.25, w: 12.3, h: 0.6, fontSize: 18, bold: true, color: DEEP, fontFace: FONT });
    const kpiDefs = [
      { label: L.qtyMonth, value: fmt(P.totals.qty), d: exDeltaPct(P.totals.qty, P.prevTotals && P.prevTotals.qty) },
      { label: L.valMonth, value: fmtUSD(P.totals.val), d: exDeltaPct(P.totals.val, P.prevTotals && P.prevTotals.val) },
      { label: L.qtyYtd, value: fmt(P.totals.qtyY), d: null },
      { label: L.valYtd, value: fmtUSD(P.totals.valY), d: null },
    ];
    kpiDefs.forEach((k, i) => {
      const x = 0.4 + i * 3.17;
      s2.addShape(pptx.ShapeType.rect, { x, y: 1.15, w: 2.9, h: 2.5, fill: { color: SOFT }, line: { color: GOLD, width: 1.5 } });
      s2.addText(k.value, { x, y: 1.45, w: 2.9, h: 1.1, fontSize: 22, bold: true, color: DEEP, align: 'center', fontFace: FONT });
      s2.addText(k.label, { x, y: 2.55, w: 2.9, h: 0.5, fontSize: 10.5, color: MUTED, align: 'center', fontFace: FONT });
      if (k.d != null) {
        const c = k.d > 0.05 ? UP : k.d < -0.05 ? DOWN : FLAT;
        const lbl = (k.d > 0 ? '▲ +' : k.d < 0 ? '▼ ' : '• ') + k.d.toFixed(1) + '%';
        s2.addShape(pptx.ShapeType.roundRect, { x: x + 0.8, y: 3.08, w: 1.3, h: 0.4, fill: { color: c }, rectRadius: 0.2 });
        s2.addText(lbl, { x: x + 0.8, y: 3.08, w: 1.3, h: 0.4, fontSize: 10, bold: true, color: 'FFFFFF', align: 'center', valign: 'middle', fontFace: FONT });
      }
    });
    if (P.tradeBalanceUsd != null) {
      s2.addText(`${L.balance}: ${fmtUSD(P.tradeBalanceUsd)}`, { x: 0.5, y: 4.15, w: 12, h: 0.5, fontSize: 13, bold: true, color: GOLDDEEP, fontFace: FONT });
    }
    brandSlide(s2);

    // Slide 3: Key Takeaways & Market Insights (AI summary) - using payload AI data
    if (EX_TEMPLATES.pptx.slides.includes('insights')) {
      const s3 = pptx.addSlide();
      s3.background = { color: BG };
      s3.addText(vi ? 'Nhận định điều hành & Động lực thị trường' : 'Key Takeaways & Market Insights', { x: 0.5, y: 0.25, w: 12.3, h: 0.6, fontSize: 18, bold: true, color: DEEP, fontFace: FONT });
      const aiNar = P.aiAnalysis || generateMarketNarrative(P);
      const aiBlocks = EX_AI_BLOCKS(vi);
      let ay = 1.5;
      for (let i = 0; i < 3 && i < aiBlocks.length; i++) {
        const b = aiBlocks[i];
        const val = aiNar[b.key];
        const line = (val && typeof val === 'string') ? val : (Array.isArray(val) ? val[0] : '');
        if (!line) continue;
        const prefix = (b.icon || '') + ' ';
        const wrap = line.replace(/(.{45})/g, '\n'); // crude wrap
        s3.addText(prefix + wrap, { x: 0.6, y: ay, w: 11.3, h: 1.0, fontSize: 14, color: DARK, fontFace: FONT });
        ay += 1.2;
      }
      brandSlide(s3);
    }

    // Slide 4: Top 10 — native horizontal bar chart
    if (P.top10.length && EX_TEMPLATES.pptx.slides.includes('top10')) {
      const s4 = pptx.addSlide();
      s4.background = { color: BG };
      s4.addText(`${L.top10} · ${L.period} ${P.period}`, { x: 0.5, y: 0.25, w: 12.3, h: 0.6, fontSize: 18, bold: true, color: DEEP, fontFace: FONT });
      s4.addChart(pptx.ChartType.bar, [{
        name: L.valShort, labels: P.top10.map(r => r.country || '?'), values: P.top10.map(r => r.value_month_usd || 0),
      }], {
        x: 0.5, y: 0.95, w: 12.3, h: 5.9,
        barDir: 'bar', chartColors: [GOLD], barGapWidthPct: 60,
        showLegend: false, showValue: true, dataLabelPosition: 'outEnd',
        dataLabelFontSize: 9, dataLabelColor: GOLDDEEP, dataLabelFormatCode: '#,##0',
        valAxisLabelFontSize: 8.5, catAxisLabelFontSize: 10, valAxisLabelFormatCode: '#,##0',
        catAxisLabelColor: DARK, valAxisLabelColor: MUTED,
      });
      brandSlide(s4);
    }

    // Slide 5: Region share — doughnut
    if (P.regions.length && EX_TEMPLATES.pptx.slides.includes('regions')) {
      const s5 = pptx.addSlide();
      s5.background = { color: BG };
      s5.addText(`${L.regionShare} · ${L.period} ${P.period}`, { x: 0.5, y: 0.25, w: 12.3, h: 0.6, fontSize: 18, bold: true, color: DEEP, fontFace: FONT });
      s5.addChart(pptx.ChartType.doughnut, [{
        name: L.share, labels: P.regions.map(r => r.label), values: P.regions.map(r => r.value),
      }], {
        x: 2.2, y: 1.0, w: 9, h: 5.6, holeSize: 55,
        chartColors: ['C9A227', '3E7C4F', '8A6D1C', 'B3A782', '2B2113', 'D4C89A', '6B756F'],
        showLegend: true, legendPos: 'r', legendFontSize: 11, legendColor: DARK,
        showPercent: true, dataLabelColor: 'FFFFFF', dataLabelFontSize: 10,
      });
      brandSlide(s5);
    }

    // Slide 6: Trend — line chart (respects filters + granularity)
    if (P.series.length > 1 && EX_TEMPLATES.pptx.slides.includes('trend')) {
      const s6 = pptx.addSlide();
      s6.background = { color: BG };
      s6.addText(`${L.trend} · ${EX_GRAN_LABEL(P.filters.granularity, P.vi)}`, { x: 0.5, y: 0.25, w: 12.3, h: 0.6, fontSize: 18, bold: true, color: DEEP, fontFace: FONT });
      s6.addChart(pptx.ChartType.line, [{
        name: L.valShort, labels: P.series.map(s => s.label), values: P.series.map(s => s.val),
      }], {
        x: 0.5, y: 1.0, w: 12.3, h: 5.9,
        chartColors: [GOLD], lineDataSymbol: 'circle', lineDataSymbolSize: 6, lineSmooth: true,
        showLegend: false, valAxisLabelFontSize: 9, catAxisLabelFontSize: 9, valAxisLabelFormatCode: '#,##0',
        catAxisLabelColor: MUTED, valAxisLabelColor: MUTED,
      });
      brandSlide(s6);
    }

    // Slides 7+: detail tables (paginated, all filtered rows)
    const rowsAll = [...P.rows].sort((a, b) => (b.value_month_usd || 0) - (a.value_month_usd || 0));
    const PER = 17;
    if (!rowsAll.length) {
      const s7 = pptx.addSlide();
      s7.background = { color: BG };
      s7.addText(L.noData, { x: 0.5, y: 3, w: 12.3, h: 1, fontSize: 16, color: MUTED, align: 'center', fontFace: FONT });
    }
    for (let i = 0; i < rowsAll.length; i += PER) {
      const chunk = rowsAll.slice(i, i + PER);
      const s = pptx.addSlide();
      s.background = { color: BG };
      s.addText(`${FLOW} theo quốc gia · Hạt điều · ${P.period} (${i + 1}–${i + chunk.length}/${rowsAll.length})`,
        { x: 0.3, y: 0.15, w: 12.7, h: 0.55, fontSize: 15, bold: true, color: DEEP, fontFace: FONT });
      const hdr = (txt) => ({ text: txt, options: { bold: true, color: 'FFFFFF', fill: DEEP, align: 'center', fontSize: 8.5 } });
      const tableData = [
        [hdr(L.country), hdr(L.product), hdr(L.unit), hdr('CY ' + L.qtyShort), hdr('CY ' + L.valShort + ' (USD)'), hdr('YTD ' + L.qtyShort), hdr('YTD ' + L.valShort + ' (USD)')],
        ...chunk.map((r, ri) => {
          const bg = ri % 2 ? 'FFFFFF' : SOFT;
          const cell = (v, color = DARK) => ({ text: v || '—', options: { color, fill: bg, fontSize: 8 } });
          return [
            cell(r.country), cell(r.product), cell(r.unit || 'Tấn'),
            cell(fmt(r.quantity_month)), cell(fmtUSD(r.value_month_usd), GOLDDEEP),
            cell(fmt(r.quantity_ytd)), cell(fmtUSD(r.value_ytd_usd), GOLDDEEP),
          ];
        }),
      ];
      s.addTable(tableData, { x: 0.3, y: 0.85, w: 12.7, fontSize: 8, rowH: 0.28, fontFace: FONT, border: { type: 'solid', color: EX_THEME.line, pt: 0.5 } });
      brandSlide(s);
    }

    await pptx.writeFile({ fileName: exFileName(P.period, P.flow, 'pptx') });
    exToastOk('PPTX ✓');
  });
}

// ── Chart.js global config (layer5_output-style polish) ───────────────────────
if (typeof Chart !== 'undefined') {
  Chart.defaults.color = '#6b756f';
  Chart.defaults.borderColor = 'rgba(90,74,40,.08)';
  Chart.defaults.font.family = "'Inter', sans-serif";
  Chart.defaults.font.size = 11.5;
  Chart.defaults.animation.duration = 700;
  Chart.defaults.animation.easing = 'easeOutQuart';
  // White-card tooltip with border + shadow (learned from layer5_output)
  Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(255,255,255,.98)';
  Chart.defaults.plugins.tooltip.titleColor = '#17211d';
  Chart.defaults.plugins.tooltip.bodyColor = '#4e3a13';
  Chart.defaults.plugins.tooltip.borderColor = '#e3e8e4';
  Chart.defaults.plugins.tooltip.borderWidth = 1;
  Chart.defaults.plugins.tooltip.cornerRadius = 8;
  Chart.defaults.plugins.tooltip.padding = { top: 9, bottom: 9, left: 12, right: 12 };
  Chart.defaults.plugins.tooltip.boxPadding = 4;
  Chart.defaults.plugins.tooltip.displayColors = true;
  Chart.defaults.plugins.tooltip.usePointStyle = true;
  Chart.defaults.plugins.legend.labels.usePointStyle = true;
  Chart.defaults.plugins.legend.labels.boxWidth = 8;
  // Phase 8: datalabels plugin — opt-in per chart (global default off)
  if (typeof ChartDataLabels !== 'undefined') {
    Chart.register(ChartDataLabels);
    Chart.defaults.set('plugins.datalabels', { display: false });
  }
}

// ── Chart box helpers: skeleton shimmer + empty state ─────────────────────────
function chartBoxEl(canvasId) {
  const el = document.getElementById(canvasId);
  return el ? el.closest('.chart-box') : null;
}
function chartBoxLoading(canvasId, loading) {
  const box = chartBoxEl(canvasId);
  if (box) box.classList.toggle('is-loading', !!loading);
}
function chartBoxEmpty(canvasId, isEmpty, msgVi = 'Chưa có dữ liệu', msgEn = 'No data') {
  const box = chartBoxEl(canvasId);
  if (!box) return;
  let msg = box.querySelector('.chart-empty');
  if (isEmpty) {
    if (!msg) {
      msg = document.createElement('div');
      msg.className = 'chart-empty';
      msg.innerHTML = `<div class="ce-ico" aria-hidden="true">📊</div><span></span>`;
      box.appendChild(msg);
    }
    msg.querySelector('span').textContent = state.lang === 'vi' ? msgVi : msgEn;
    msg.style.display = '';
  } else if (msg) {
    msg.style.display = 'none';
  }
}

// ── Init ──────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  setLang('vi');
  const vEl = document.getElementById('app-version');
  if (vEl) vEl.textContent = '· ' + APP_VERSION;
  setupKeyboardNav();
  document.querySelectorAll('.nav-item').forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tab));
  });
  // ── Phase 6: filter bar events ──
  document.querySelectorAll('#fb-granularity button').forEach(b => {
    b.addEventListener('click', () => setGranularity(b.dataset.gran));
  });
  // ── Phase 12: period slicer nav ──
  const psPrev = document.getElementById('ps-prev');
  const psNext = document.getElementById('ps-next');
  if (psPrev) psPrev.addEventListener('click', () => sliceStep(-1));
  if (psNext) psNext.addEventListener('click', () => sliceStep(1));
  const regionEl = document.getElementById('fb-region');
  if (regionEl) regionEl.addEventListener('change', () => setRegionFilter(regionEl.value));
  const fbCountry = document.getElementById('fb-country');
  if (fbCountry) {
    // Immediate: mirror into the table search box; Debounced: apply the filter
    fbCountry.addEventListener('input', () => {
      const tableSearch = document.getElementById('country-search');
      if (tableSearch && document.activeElement !== tableSearch) tableSearch.value = fbCountry.value;
    });
    fbCountry.addEventListener('input', debounce((e) => debounceSearch(e.target.value), 320));
  }
  renderFilterBar();
  updateTopbarTitle();
  // Restore last active tab within the session
  try {
    const savedTab = sessionStorage.getItem('dofActiveTab');
    if (savedTab && TABS.includes(savedTab)) switchTab(savedTab);
  } catch (e) { /* sessionStorage unavailable */ }
    (async () => {
      // ── Phase 16: Detect file:// protocol — fetch() không hoạt động từ file://
      if (window.location.protocol === 'file:') {
        const msgVi = ' Dashboard đang mở qua file:// — fetch() bị block bởi browser.\n\n' +
          'Vui lòng khởi động server cục bộ:\n' +
          '  python serve_dashboard.py\n\n' +
          'Hoặc mở qua HTTP:\n' +
          '  http://127.0.0.1:8080';
        const msgEn = ' Dashboard opened via file:// — fetch() blocked by browser.\n\n' +
          'Please start the local server:\n' +
          '  python serve_dashboard.py\n\n' +
          'Or open via HTTP:\n' +
          '  http://127.0.0.1:8080';
        showToast(state.lang === 'vi' ? msgVi : msgEn, 'error');
        console.error('[data] file:// protocol detected — fetch() blocked. Start server: python serve_dashboard.py');
        return;
      }
      try { await loadAllYearsExcel(); }
      catch (err) {
        console.warn('[data] Excel load failed, trying JSON fallback:', err.message);
        try { await loadAllYearsJSON(); }
        catch (err2) {
          showToast((state.lang === 'vi' ? 'Không tải được dữ liệu: ' : 'Data load failed: ') + err2.message, 'error');
          console.error('[data] Both Excel and JSON load failed:', err2);
        }
      }
      // Master Plan v2 (Phase C): preload logo cho các template xuất file
      exLogoDataUrl();
      })();
});
