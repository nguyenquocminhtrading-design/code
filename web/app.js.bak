  GHA:'africa', NGA:'africa', SEN:'africa', TZA:'africa', MOZ:'africa',
  KEN:'africa', ETH:'africa',
  // West/Central Africa — nguồn RCN trong dữ liệu Vinacas (Master Plan v2)
  CIV:'africa', BEN:'africa', TGO:'africa', GIN:'africa', GNB:'africa',
  SLE:'africa', LBR:'africa', GMB:'africa', BFA:'africa', MLI:'africa', NER:'africa',
